```java
// platform-core/src/main/java/com/acme/platform/query/TableDefinition.java
package com.acme.platform.query;

import java.util.*;

/**
 * Declarative contract of one queryable StarRocks table/view.
 * Everything user-controllable (filter/sort fields) is resolved through this whitelist,
 * so no SQL identifier ever comes from the request.
 */
public final class TableDefinition {

    public enum ColumnType { STRING, INT, LONG, DECIMAL, BOOLEAN, DATE, TIMESTAMP }
    public enum Flag { FILTERABLE, SORTABLE, REQUIRED_RANGE /* forces partition pruning */ }

    public record Column(String apiName, String sqlName, ColumnType type, Set<Flag> flags) {
        public boolean is(Flag f) { return flags.contains(f); }
    }

    private final String table;
    private final Map<String, Column> columns;      // apiName -> column (insertion ordered)
    private final List<SortOrder> defaultSort;
    private final String tieBreaker;                // unique column guaranteeing total order
    private final int maxPageSize;
    private final int defaultPageSize;

    private TableDefinition(Builder b) {
        this.table = b.table;
        this.columns = Collections.unmodifiableMap(new LinkedHashMap<>(b.columns));
        this.defaultSort = List.copyOf(b.defaultSort);
        this.tieBreaker = Objects.requireNonNull(b.tieBreaker, "tieBreaker is mandatory for keyset paging");
        this.maxPageSize = b.maxPageSize;
        this.defaultPageSize = b.defaultPageSize;
        column(tieBreaker); // fail fast if misconfigured
        defaultSort.forEach(s -> requireSortable(s.field()));
    }

    public String table()                 { return table; }
    public Collection<Column> columns()   { return columns.values(); }
    public List<SortOrder> defaultSort()  { return defaultSort; }
    public String tieBreaker()            { return tieBreaker; }
    public int maxPageSize()              { return maxPageSize; }
    public int defaultPageSize()          { return defaultPageSize; }

    public Column column(String apiName) {
        Column c = columns.get(apiName);
        if (c == null) throw new QueryValidationException("Unknown field '" + apiName + "'");
        return c;
    }

    public Column requireFilterable(String apiName) {
        Column c = column(apiName);
        if (!c.is(Flag.FILTERABLE)) throw new QueryValidationException("Field '" + apiName + "' is not filterable");
        return c;
    }

    public Column requireSortable(String apiName) {
        Column c = column(apiName);
        if (!c.is(Flag.SORTABLE)) throw new QueryValidationException("Field '" + apiName + "' is not sortable");
        return c;
    }

    public List<Column> requiredRangeColumns() {
        return columns.values().stream().filter(c -> c.is(Flag.REQUIRED_RANGE)).toList();
    }

    public static Builder builder(String table) { return new Builder(table); }

    public static final class Builder {
        private final String table;
        private final Map<String, Column> columns = new LinkedHashMap<>();
        private List<SortOrder> defaultSort = List.of();
        private String tieBreaker;
        private int maxPageSize = 500;
        private int defaultPageSize = 100;

        private Builder(String table) { this.table = table; }

        public Builder col(String api, String sql, ColumnType type, Flag... flags) {
            columns.put(api, new Column(api, sql, type, flags.length == 0 ? Set.of() : EnumSet.of(flags[0], flags)));
            return this;
        }
        public Builder defaultSort(SortOrder... s)   { this.defaultSort = List.of(s); return this; }
        public Builder tieBreaker(String apiName)    { this.tieBreaker = apiName; return this; }
        public Builder maxPageSize(int n)            { this.maxPageSize = n; return this; }
        public Builder defaultPageSize(int n)        { this.defaultPageSize = n; return this; }
        public TableDefinition build()               { return new TableDefinition(this); }
    }
}
