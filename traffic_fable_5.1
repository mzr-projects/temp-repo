// service-orders/src/main/java/com/acme/orders/OrderQueryService.java
package com.acme.orders;

import com.acme.platform.query.*;
import org.springframework.stereotype.Service;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.List;
import java.util.Set;

/** Typed, domain-specific API on top of the generic engine. This is the layer you extend. */
@Service
public class OrderQueryService {

    public record OrderSearch(LocalDateTime from, LocalDateTime to, Long customerId,
                              Set<String> statuses, List<SortOrder> sort, int pageSize, String cursor) {}

    private final OrderRepository repo;

    public OrderQueryService(OrderRepository repo) { this.repo = repo; }

    public CursorPage<OrderView> search(OrderSearch s) {
        List<Filter> filters = new ArrayList<>();
        filters.add(Filter.gte("orderTime", s.from()));
        filters.add(Filter.lt("orderTime", s.to()));
        if (s.customerId() != null)                       filters.add(Filter.eq("customerId", s.customerId()));
        if (s.statuses() != null && !s.statuses().isEmpty()) filters.add(Filter.in("status", List.copyOf(s.statuses())));

        return repo.findPage(new QueryRequest(filters, s.sort(), s.pageSize(), s.cursor()));
    }
}
