package com.acme.platform.query;

import java.util.List;

public record Filter(String field, Operator op, List<Object> values) {
    public enum Operator { EQ, NE, GT, GTE, LT, LTE, IN, BETWEEN, LIKE }

    public static Filter eq(String f, Object v)             { return new Filter(f, Operator.EQ, List.of(v)); }
    public static Filter gte(String f, Object v)            { return new Filter(f, Operator.GTE, List.of(v)); }
    public static Filter lt(String f, Object v)             { return new Filter(f, Operator.LT, List.of(v)); }
    public static Filter in(String f, List<?> vs)           { return new Filter(f, Operator.IN, List.copyOf(vs)); }
    public static Filter between(String f, Object a, Object b) { return new Filter(f, Operator.BETWEEN, List.of(a, b)); }
}
