```java
// platform-starrocks/src/main/java/com/acme/platform/starrocks/StarRocksAutoConfiguration.java
package com.acme.platform.starrocks;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;
import io.micrometer.core.instrument.MeterRegistry;
import org.springframework.boot.autoconfigure.AutoConfiguration;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.context.annotation.Bean;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;

import javax.sql.DataSource;

@AutoConfiguration
@EnableConfigurationProperties(StarRocksProperties.class)
public class StarRocksAutoConfiguration {

    @Bean(destroyMethod = "close")
    public HikariDataSource starRocksDataSource(StarRocksProperties p, MeterRegistry registry) {
        HikariConfig cfg = new HikariConfig();
        cfg.setPoolName("starrocks");
        cfg.setJdbcUrl(p.jdbcUrl());
        cfg.setUsername(p.username());
        cfg.setPassword(p.password());
        cfg.setDriverClassName("com.mysql.cj.jdbc.Driver");
        cfg.setReadOnly(true);
        cfg.setAutoCommit(true);                       // no transactions on OLAP reads
        cfg.setMaximumPoolSize(p.pool().maximumPoolSize());
        cfg.setMinimumIdle(p.pool().minimumIdle());
        cfg.setConnectionTimeout(p.pool().connectionTimeoutMs());
        cfg.setMaxLifetime(p.pool().maxLifetimeMs());
        cfg.setKeepaliveTime(p.pool().keepaliveTimeMs());
        cfg.setConnectionTestQuery("SELECT 1");
        // Session-level guard rails applied to every pooled connection:
        cfg.setConnectionInitSql("SET query_timeout = " + p.queryTimeoutSeconds());
        cfg.setMetricRegistry(registry);               // Hikari metrics -> Micrometer -> Prometheus
        return new HikariDataSource(cfg);
    }

    @Bean
    public NamedParameterJdbcTemplate starRocksJdbc(DataSource ds, StarRocksProperties p) {
        JdbcTemplate t = new JdbcTemplate(ds);
        t.setQueryTimeout(p.queryTimeoutSeconds()); // JDBC-side timeout (belt and braces)
        t.setFetchSize(1_000);
        return new NamedParameterJdbcTemplate(t);
    }

    @Bean
    public CursorCodec cursorCodec(ObjectMapper objectMapper) { return new CursorCodec(objectMapper); }

    @Bean
    public ValueCoercer valueCoercer() { return new ValueCoercer(); }
}
```

