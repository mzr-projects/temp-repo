### 4.5 Base repository — every service extends this

```java
// platform-starrocks/src/main/java/com/acme/platform/starrocks/AbstractStarRocksReadRepository.java
package com.acme.platform.starrocks;

import com.acme.platform.query.*;
import com.acme.platform.query.TableDefinition.Column;
import io.micrometer.core.instrument.MeterRegistry;
import io.micrometer.core.instrument.Timer;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.jdbc.core.RowMapper;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;

import java.util.*;
import java.util.concurrent.TimeUnit;

/**
 * Generic, read-only, keyset-paginated repository for one StarRocks table.
 * Subclasses only provide: the TableDefinition, the columns to select, and a RowMapper.
 */
public abstract class AbstractStarRocksReadRepository<T> {

    private static final Logger log = LoggerFactory.getLogger(AbstractStarRocksReadRepository.class);

    protected final NamedParameterJdbcTemplate jdbc;
    protected final TableDefinition def;
    private final KeysetQueryBuilder builder;
    private final CursorCodec cursorCodec;
    private final ValueCoercer coercer;
    private final Timer queryTimer;
    private final long slowQueryThresholdMs;

    protected AbstractStarRocksReadRepository(NamedParameterJdbcTemplate jdbc,
                                              TableDefinition def,
                                              CursorCodec cursorCodec,
                                              ValueCoercer coercer,
                                              MeterRegistry registry,
                                              StarRocksProperties props) {
        this.jdbc = jdbc;
        this.def = def;
        this.cursorCodec = cursorCodec;
        this.coercer = coercer;
        this.builder = new KeysetQueryBuilder(def, coercer);
        this.slowQueryThresholdMs = props.slowQueryThresholdMs();
        this.queryTimer = Timer.builder("starrocks.query")
                .tag("table", def.table())
                .publishPercentiles(0.5, 0.95, 0.99)
                .register(registry);
    }

    /** API names of the columns this repository selects (must be a subset of def.columns()). */
    protected abstract List<String> selectColumns();

    protected abstract RowMapper<T> rowMapper();

    public CursorPage<T> findPage(QueryRequest req) {
        List<SortOrder> sort = builder.effectiveSort(req);
        Map<String, Object> cursorKeys = cursorCodec.decode(req.cursor(), sort);
        KeysetQueryBuilder.SqlQuery q = builder.build(req, selectColumns(), cursorKeys);
        RowMapper<T> mapper = rowMapper();
        List<Column> sortCols = sort.stream().map(s -> def.column(s.field())).toList();

        long start = System.nanoTime();
        try {
            CursorPage<T> page = jdbc.query(q.sql(), q.params(), rs -> {
                List<T> items = new ArrayList<>(q.limit());
                Map<String, Object> lastKeys = null;
                int n = 0;
                boolean hasNext = false;
                while (rs.next()) {
                    if (n == q.limit()) { hasNext = true; break; }   // the extra row
                    items.add(mapper.mapRow(rs, n));
                    lastKeys = new LinkedHashMap<>(sortCols.size());
                    for (Column c : sortCols) lastKeys.put(c.apiName(), coercer.read(rs, c));
                    n++;
                }
                String next = hasNext ? cursorCodec.encode(sort, lastKeys) : null;
                return new CursorPage<>(items, next, hasNext);
            });
            return page == null ? CursorPage.empty() : page;
        } finally {
            long elapsedMs = TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - start);
            queryTimer.record(elapsedMs, TimeUnit.MILLISECONDS);
            if (elapsedMs >= slowQueryThresholdMs) {
                log.warn("Slow StarRocks query ({} ms) on {}: {} params={}", elapsedMs, def.table(), q.sql(), q.params());
            } else if (log.isDebugEnabled()) {
                log.debug("StarRocks query ({} ms): {} params={}", elapsedMs, q.sql(), q.params());
            }
        }
    }

    /**
     * Counts are expensive on billions of rows. Keep them on a separate endpoint,
     * cache them, and *always* require the same bounded range filters.
     */
    public long count(QueryRequest req) {
        KeysetQueryBuilder.SqlQuery q = builder.build(req, List.of(def.tieBreaker()), null);
        String countSql = "SELECT COUNT(*) FROM " + def.table()
                + extractWhere(q.sql());
        Long c = jdbc.queryForObject(countSql, q.params(), Long.class);
        return c == null ? 0 : c;
    }

    private static String extractWhere(String selectSql) {
        int w = selectSql.indexOf(" WHERE ");
        int o = selectSql.indexOf(" ORDER BY ");
        return w < 0 ? "" : selectSql.substring(w, o);
    }
}
