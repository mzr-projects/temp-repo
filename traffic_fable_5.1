// platform-web/src/main/java/com/acme/platform/web/SortParam.java
package com.acme.platform.web;

import com.acme.platform.query.QueryValidationException;
import com.acme.platform.query.SortOrder;

import java.util.List;

/** Parses ?sort=orderTime,desc&sort=orderId,desc  */
public final class SortParam {
    private SortParam() {}

    public static List<SortOrder> parse(List<String> raw) {
        if (raw == null) return List.of();
        return raw.stream().map(s -> {
            String[] parts = s.split(",", 2);
            SortOrder.Direction d = parts.length == 2 && parts[1].equalsIgnoreCase("asc")
                    ? SortOrder.Direction.ASC : SortOrder.Direction.DESC;
            if (parts[0].isBlank()) throw new QueryValidationException("Empty sort field");
            return new SortOrder(parts[0].trim(), d);
        }).toList();
    }
}
