### 4.2 Value coercion (JSON/HTTP strings ⇄ typed JDBC params)

```java
// platform-starrocks/src/main/java/com/acme/platform/starrocks/ValueCoercer.java
package com.acme.platform.starrocks;

import com.acme.platform.query.QueryValidationException;
import com.acme.platform.query.TableDefinition.Column;
import com.acme.platform.query.TableDefinition.ColumnType;

import java.math.BigDecimal;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.time.LocalDate;
import java.time.LocalDateTime;

public final class ValueCoercer {

    /** Normalises any incoming value (String from HTTP/JSON, Number, temporal) to the column's Java type. */
    public Object coerce(Object v, Column c) {
        if (v == null) return null;
        try {
            return switch (c.type()) {
                case STRING    -> v.toString();
                case INT       -> v instanceof Number n ? n.intValue()  : Integer.parseInt(v.toString());
                case LONG      -> v instanceof Number n ? n.longValue() : Long.parseLong(v.toString());
                case DECIMAL   -> v instanceof BigDecimal b ? b : new BigDecimal(v.toString());
                case BOOLEAN   -> v instanceof Boolean b ? b : Boolean.parseBoolean(v.toString());
                case DATE      -> v instanceof LocalDate d ? d : LocalDate.parse(v.toString());
                case TIMESTAMP -> v instanceof LocalDateTime d ? d : LocalDateTime.parse(v.toString());
            };
        } catch (RuntimeException e) {
            throw new QueryValidationException("Invalid value '" + v + "' for field '" + c.apiName() + "' (" + c.type() + ")");
        }
    }

    /** Reads a column from the ResultSet as the declared Java type (used to build the next cursor). */
    public Object read(ResultSet rs, Column c) throws SQLException {
        return switch (c.type()) {
            case STRING    -> rs.getString(c.sqlName());
            case INT       -> rs.getObject(c.sqlName(), Integer.class);
            case LONG      -> rs.getObject(c.sqlName(), Long.class);
            case DECIMAL   -> rs.getBigDecimal(c.sqlName());
            case BOOLEAN   -> rs.getObject(c.sqlName(), Boolean.class);
            case DATE      -> rs.getObject(c.sqlName(), LocalDate.class);
            case TIMESTAMP -> rs.getObject(c.sqlName(), LocalDateTime.class);
        };
    }
}
```

### 4.3 Opaque cursor

```java
// platform-starrocks/src/main/java/com/acme/platform/starrocks/CursorCodec.java
package com.acme.platform.starrocks;

import com.acme.platform.query.InvalidCursorException;
import com.acme.platform.query.SortOrder;
import com.fasterxml.jackson.databind.ObjectMapper;

import java.nio.charset.StandardCharsets;
import java.util.Base64;
import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

/**
 * Cursor = base64url( JSON { "s": "<sort signature>", "k": { field: lastValue, ... } } ).
 * The sort signature lets us reject a cursor that was issued for a different ordering.
 * If cursors must be tamper-proof across trust boundaries, wrap the payload in an HMAC here.
 */
public final class CursorCodec {

    public record Payload(String s, Map<String, Object> k) {}

    private final ObjectMapper om;

    public CursorCodec(ObjectMapper om) { this.om = om; }

    public String encode(List<SortOrder> sort, Map<String, Object> lastKeys) {
        try {
            byte[] json = om.writeValueAsBytes(new Payload(signature(sort), lastKeys));
            return Base64.getUrlEncoder().withoutPadding().encodeToString(json);
        } catch (Exception e) {
            throw new IllegalStateException("Cannot encode cursor", e);
        }
    }

    /** @return the last-seen key values, or null when no cursor (first page). */
    public Map<String, Object> decode(String cursor, List<SortOrder> expectedSort) {
        if (cursor == null || cursor.isBlank()) return null;
        Payload p;
        try {
            p = om.readValue(Base64.getUrlDecoder().decode(cursor), Payload.class);
        } catch (Exception e) {
            throw new InvalidCursorException("Malformed cursor");
        }
        if (!signature(expectedSort).equals(p.s()))
            throw new InvalidCursorException("Cursor was issued for a different sort order");
        if (p.k() == null || p.k().size() != expectedSort.size())
            throw new InvalidCursorException("Cursor keys do not match sort fields");
        return p.k();
    }

    private static String signature(List<SortOrder> sort) {
        return sort.stream().map(s -> s.field() + ":" + s.direction())
                   .collect(Collectors.joining(",")).intern();
    }

    @SuppressWarnings("unused")
    private static String utf8(byte[] b) { return new String(b, StandardCharsets.UTF_8); }
}
```

### 4.4 The keyset query builder (the heart of it)

```java
// platform-starrocks/src/main/java/com/acme/platform/starrocks/KeysetQueryBuilder.java
package com.acme.platform.starrocks;

import com.acme.platform.query.*;
import com.acme.platform.query.SortOrder.Direction;
import com.acme.platform.query.TableDefinition.Column;
import com.acme.platform.query.TableDefinition.Flag;

import java.util.*;
import java.util.stream.Collectors;

/**
 * Turns a validated QueryRequest into a single StarRocks SELECT with keyset pagination.
 * Pure function – no I/O – so it is trivially unit-testable.
 */
public final class KeysetQueryBuilder {

    public record SqlQuery(String sql, Map<String, Object> params, List<SortOrder> effectiveSort, int limit) {}

    private final TableDefinition def;
    private final ValueCoercer coercer;

    public KeysetQueryBuilder(TableDefinition def, ValueCoercer coercer) {
        this.def = def;
        this.coercer = coercer;
    }

    public List<SortOrder> effectiveSort(QueryRequest req) {
        List<SortOrder> sort = new ArrayList<>(req.sort().isEmpty() ? def.defaultSort() : req.sort());
        sort.forEach(s -> def.requireSortable(s.field()));
        // Guarantee a total order: the tie-breaker must be the last sort key.
        boolean hasTieBreaker = sort.stream().anyMatch(s -> s.field().equals(def.tieBreaker()));
        if (!hasTieBreaker) {
            Direction dir = sort.isEmpty() ? Direction.DESC : sort.get(sort.size() - 1).direction();
            sort.add(new SortOrder(def.tieBreaker(), dir));
        }
        return List.copyOf(sort);
    }

    public int pageSize(QueryRequest req) {
        int size = req.pageSize() <= 0 ? def.defaultPageSize() : req.pageSize();
        if (size > def.maxPageSize())
            throw new QueryValidationException("pageSize must be <= " + def.maxPageSize());
        return size;
    }

    public SqlQuery build(QueryRequest req, List<String> selectApiNames, Map<String, Object> cursorKeys) {
        List<SortOrder> sort = effectiveSort(req);
        int size = pageSize(req);
        Map<String, Object> params = new LinkedHashMap<>();
        List<String> where = new ArrayList<>();

        validateRequiredRanges(req.filters());

        // --- user filters -----------------------------------------------------------------
        int i = 0;
        for (Filter f : req.filters()) {
            Column c = def.requireFilterable(f.field());
            where.add(predicate(c, f, "f" + (i++), params));
        }

        // --- keyset predicate -------------------------------------------------------------
        if (cursorKeys != null) {
            where.add(keysetPredicate(sort, cursorKeys, params));
        }

        // --- select list: requested columns + sort columns (needed for next cursor) -------
        LinkedHashSet<String> select = new LinkedHashSet<>(selectApiNames);
        sort.forEach(s -> select.add(s.field()));
        String selectSql = select.stream()
                .map(api -> { Column c = def.column(api); return c.sqlName(); })
                .collect(Collectors.joining(", "));

        String orderBy = sort.stream()
                .map(s -> def.column(s.field()).sqlName() + " " + s.direction())
                .collect(Collectors.joining(", "));

        StringBuilder sql = new StringBuilder(256)
                .append("SELECT ").append(selectSql)
                .append(" FROM ").append(def.table());
        if (!where.isEmpty()) sql.append(" WHERE ").append(String.join(" AND ", where));
        sql.append(" ORDER BY ").append(orderBy)
           .append(" LIMIT ").append(size + 1);           // +1 row to compute hasNext cheaply

        return new SqlQuery(sql.toString(), params, sort, size);
    }

    // -------------------------------------------------------------------------------------

    private void validateRequiredRanges(List<Filter> filters) {
        for (Column c : def.requiredRangeColumns()) {
            boolean lower = false, upper = false;
            for (Filter f : filters) {
                if (!f.field().equals(c.apiName())) continue;
                switch (f.op()) {
                    case EQ, BETWEEN -> { lower = true; upper = true; }
                    case GT, GTE     -> lower = true;
                    case LT, LTE     -> upper = true;
                    default -> {}
                }
            }
            if (!(lower && upper))
                throw new QueryValidationException(
                        "Field '" + c.apiName() + "' requires a bounded range (both lower and upper bound)");
        }
    }

    private String predicate(Column c, Filter f, String p, Map<String, Object> params) {
        String col = c.sqlName();
        List<Object> v = f.values();
        return switch (f.op()) {
            case EQ  -> { one(f); params.put(p, coercer.coerce(v.get(0), c)); yield col + " = :" + p; }
            case NE  -> { one(f); params.put(p, coercer.coerce(v.get(0), c)); yield col + " <> :" + p; }
            case GT  -> { one(f); params.put(p, coercer.coerce(v.get(0), c)); yield col + " > :" + p; }
            case GTE -> { one(f); params.put(p, coercer.coerce(v.get(0), c)); yield col + " >= :" + p; }
            case LT  -> { one(f); params.put(p, coercer.coerce(v.get(0), c)); yield col + " < :" + p; }
            case LTE -> { one(f); params.put(p, coercer.coerce(v.get(0), c)); yield col + " <= :" + p; }
            case LIKE -> {
                one(f);
                if (c.type() != TableDefinition.ColumnType.STRING)
                    throw new QueryValidationException("LIKE only allowed on string field '" + c.apiName() + "'");
                params.put(p, v.get(0).toString());
                yield col + " LIKE :" + p;
            }
            case IN -> {
                if (v.isEmpty() || v.size() > 1000)
                    throw new QueryValidationException("IN requires 1..1000 values for '" + c.apiName() + "'");
                params.put(p, v.stream().map(x -> coercer.coerce(x, c)).toList());
                yield col + " IN (:" + p + ")";           // NamedParameterJdbcTemplate expands the list
            }
            case BETWEEN -> {
                if (v.size() != 2) throw new QueryValidationException("BETWEEN requires exactly 2 values");
                params.put(p + "a", coercer.coerce(v.get(0), c));
                params.put(p + "b", coercer.coerce(v.get(1), c));
                yield col + " BETWEEN :" + p + "a AND :" + p + "b";
            }
        };
    }

    private static void one(Filter f) {
        if (f.values().size() != 1)
            throw new QueryValidationException(f.op() + " requires exactly one value for '" + f.field() + "'");
    }

    /**
     * Row-value comparison expanded into an OR chain so that mixed ASC/DESC works and
     * StarRocks can still prune on the leading sort column:
     *   (c1 < :k0) OR (c1 = :k0 AND c2 < :k1) OR (c1 = :k0 AND c2 = :k1 AND c3 < :k2)
     * NOTE: sort columns must be NOT NULL (NULLs break the total order).
     */
    private String keysetPredicate(List<SortOrder> sort, Map<String, Object> keys, Map<String, Object> params) {
        List<String> ors = new ArrayList<>(sort.size());
        for (int i = 0; i < sort.size(); i++) {
            List<String> ands = new ArrayList<>(i + 1);
            for (int j = 0; j < i; j++) ands.add(def.column(sort.get(j).field()).sqlName() + " = :k" + j);
            SortOrder s = sort.get(i);
            String cmp = s.direction() == Direction.DESC ? " < " : " > ";
            ands.add(def.column(s.field()).sqlName() + cmp + ":k" + i);
            ors.add("(" + String.join(" AND ", ands) + ")");
        }
        for (int i = 0; i < sort.size(); i++) {
            Column c = def.column(sort.get(i).field());
            Object raw = keys.get(c.apiName());
            if (raw == null) throw new InvalidCursorException("Cursor missing key '" + c.apiName() + "'");
            params.put("k" + i, coercer.coerce(raw, c));
        }
        return "(" + String.join(" OR ", ors) + ")";
    }
}
