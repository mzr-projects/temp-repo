package com.acme.platform.query;

import java.util.List;
import java.util.function.Function;

public record CursorPage<T>(List<T> items, String nextCursor, boolean hasNext) {
    public static <T> CursorPage<T> empty() { return new CursorPage<>(List.of(), null, false); }

    public <R> CursorPage<R> map(Function<T, R> fn) {
        return new CursorPage<>(items.stream().map(fn).toList(), nextCursor, hasNext);
    }
}
