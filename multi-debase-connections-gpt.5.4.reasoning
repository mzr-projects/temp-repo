## Redis connector

Redis is key/value, so the query model is different.  
A safe production strategy is to allow only a **whitelist** of read commands.

```java
package com.example.datahub.connector.redis;

import com.example.datahub.connector.SourceConnector;
import com.example.datahub.dto.QueryRequest;
import com.example.datahub.dto.QueryResponse;
import com.example.datahub.dto.SchemaResponse;
import com.example.datahub.model.ConnectionDocument;
import com.example.datahub.model.SourceType;
import io.lettuce.core.RedisClient;
import io.lettuce.core.api.sync.RedisCommands;
import org.springframework.stereotype.Component;

import java.util.*;

@Component
public class RedisSourceConnector implements SourceConnector {

    private static final Set<String> ALLOWED_COMMANDS = Set.of("GET", "MGET", "HGETALL", "LRANGE", "SMEMBERS", "KEYS");

    @Override
    public SourceType supports() {
        return SourceType.REDIS;
    }

    @Override
    public void testConnection(ConnectionDocument connection, String decryptedSecret) {
        try (RedisClient client = RedisClient.create(connection.buildRedisUri(decryptedSecret))) {
            client.connect().sync().ping();
        } catch (Exception e) {
            throw new IllegalStateException("Redis connection failed: " + e.getMessage(), e);
        }
    }

    @Override
    public SchemaResponse discoverSchema(ConnectionDocument connection, String decryptedSecret) {
        try (RedisClient client = RedisClient.create(connection.buildRedisUri(decryptedSecret))) {
            RedisCommands<String, String> commands = client.connect().sync();
            List<String> keys = commands.keys("*");

            SchemaResponse response = new SchemaResponse();
            response.setConnectionType(connection.getSourceType().name());
            response.setObjects(keys.stream().limit(100).toList());
            return response;
        } catch (Exception e) {
            throw new IllegalStateException("Redis schema discovery failed: " + e.getMessage(), e);
        }
    }

    @Override
    public QueryResponse executeQuery(ConnectionDocument connection, String decryptedSecret, QueryRequest request) {
        long start = System.currentTimeMillis();

        try (RedisClient client = RedisClient.create(connection.buildRedisUri(decryptedSecret))) {
            RedisCommands<String, String> commands = client.connect().sync();

            String[] tokens = request.getQuery().trim().split("\\s+");
            String cmd = tokens[0].toUpperCase(Locale.ROOT);

            if (!ALLOWED_COMMANDS.contains(cmd)) {
                throw new IllegalArgumentException("Unsupported Redis command: " + cmd);
            }

            List<Map<String, Object>> rows = new ArrayList<>();

            switch (cmd) {
                case "GET" -> {
                    String value = commands.get(tokens[1]);
                    rows.add(Map.of("key", tokens[1], "value", value));
                }
                case "KEYS" -> {
                    List<String> keys = commands.keys(tokens.length > 1 ? tokens[1] : "*");
                    for (String key : keys.stream().limit(request.getLimit()).toList()) {
                        rows.add(Map.of("key", key));
                    }
                }
                case "HGETALL" -> {
                    Map<String, String> map = commands.hgetall(tokens[1]);
                    rows.add(new LinkedHashMap<>(map));
                }
                default -> throw new IllegalArgumentException("Command not yet implemented: " + cmd);
            }

            QueryResponse response = new QueryResponse();
            response.setConnectionId(connection.getId());
            response.setSourceType(connection.getSourceType().name());
            response.setRows(rows);
            response.setCount(rows.size());
            response.setExecutionTimeMs(System.currentTimeMillis() - start);
            return response;
        } catch (Exception e) {
            throw new IllegalStateException("Redis query failed: " + e.getMessage(), e);
        }
    }
}
```

