## JDBC connector

Supports PostgreSQL, MySQL, SQL Server, Oracle through the same implementation.

```java
package com.example.datahub.connector.jdbc;

import com.example.datahub.connector.SourceConnector;
import com.example.datahub.dto.QueryRequest;
import com.example.datahub.dto.QueryResponse;
import com.example.datahub.dto.SchemaResponse;
import com.example.datahub.model.ConnectionDocument;
import com.example.datahub.model.SourceType;
import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;
import org.springframework.stereotype.Component;

import java.sql.Connection;
import java.sql.DatabaseMetaData;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.time.Duration;
import java.util.*;

@Component
public class JdbcSourceConnector implements SourceConnector {

    @Override
    public SourceType supports() {
        throw new UnsupportedOperationException(
            "Use database-specific wrapper beans or register multiple JdbcSourceConnector instances"
        );
    }

    public void test(ConnectionDocument connectionDoc, String password) {
        HikariConfig config = new HikariConfig();
        config.setJdbcUrl(connectionDoc.buildJdbcUrl());
        config.setUsername(connectionDoc.getUsername());
        config.setPassword(password);
        config.setMaximumPoolSize(2);
        config.setMinimumIdle(0);
        config.setConnectionTimeout(Duration.ofSeconds(5).toMillis());

        try (HikariDataSource ds = new HikariDataSource(config);
             Connection ignored = ds.getConnection()) {
        } catch (Exception e) {
            throw new IllegalStateException("JDBC connection failed: " + e.getMessage(), e);
        }
    }

    public SchemaResponse schema(ConnectionDocument connectionDoc, String password) {
        HikariConfig config = new HikariConfig();
        config.setJdbcUrl(connectionDoc.buildJdbcUrl());
        config.setUsername(connectionDoc.getUsername());
        config.setPassword(password);

        List<String> tables = new ArrayList<>();

        try (HikariDataSource ds = new HikariDataSource(config);
             Connection conn = ds.getConnection()) {

            DatabaseMetaData metaData = conn.getMetaData();
            try (ResultSet rs = metaData.getTables(connectionDoc.getDatabaseName(), null, "%", new String[]{"TABLE"})) {
                while (rs.next()) {
                    tables.add(rs.getString("TABLE_NAME"));
                }
            }
        } catch (Exception e) {
            throw new IllegalStateException("Schema discovery failed: " + e.getMessage(), e);
        }

        SchemaResponse response = new SchemaResponse();
        response.setConnectionType(connectionDoc.getSourceType().name());
        response.setObjects(tables);
        return response;
    }

    public QueryResponse query(ConnectionDocument connectionDoc, String password, QueryRequest request) {
        long start = System.currentTimeMillis();

        HikariConfig config = new HikariConfig();
        config.setJdbcUrl(connectionDoc.buildJdbcUrl());
        config.setUsername(connectionDoc.getUsername());
        config.setPassword(password);

        List<Map<String, Object>> rows = new ArrayList<>();
        String sql = request.getQuery().trim();

        if (!sql.toLowerCase(Locale.ROOT).startsWith("select")) {
            throw new IllegalArgumentException("Only SELECT queries are allowed");
        }

        try (HikariDataSource ds = new HikariDataSource(config);
             Connection conn = ds.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setMaxRows(request.getLimit());

            try (ResultSet rs = ps.executeQuery()) {
                int columnCount = rs.getMetaData().getColumnCount();

                while (rs.next()) {
                    Map<String, Object> row = new LinkedHashMap<>();
                    for (int i = 1; i <= columnCount; i++) {
                        row.put(rs.getMetaData().getColumnLabel(i), rs.getObject(i));
                    }
                    rows.add(row);
                }
            }
        } catch (Exception e) {
            throw new IllegalStateException("Query execution failed: " + e.getMessage(), e);
        }

        QueryResponse response = new QueryResponse();
        response.setConnectionId(connectionDoc.getId());
        response.setSourceType(connectionDoc.getSourceType().name());
        response.setRows(rows);
        response.setCount(rows.size());
        response.setExecutionTimeMs(System.currentTimeMillis() - start);
        return response;
    }

    @Override
    public void testConnection(ConnectionDocument connection, String decryptedSecret) {
        test(connection, decryptedSecret);
    }

    @Override
    public SchemaResponse discoverSchema(ConnectionDocument connection, String decryptedSecret) {
        return schema(connection, decryptedSecret);
    }

    @Override
    public QueryResponse executeQuery(ConnectionDocument connection, String decryptedSecret, QueryRequest request) {
        return query(connection, decryptedSecret, request);
    }
}
```

### Better production approach for JDBC registration

Because one connector supports multiple JDBC source types, register wrappers:

```java
package com.example.datahub.connector.jdbc;

import com.example.datahub.connector.SourceConnector;
import com.example.datahub.dto.QueryRequest;
import com.example.datahub.dto.QueryResponse;
import com.example.datahub.dto.SchemaResponse;
import com.example.datahub.model.ConnectionDocument;
import com.example.datahub.model.SourceType;
import org.springframework.stereotype.Component;

@Component
public class PostgresConnector implements SourceConnector {

    private final JdbcSourceConnector delegate = new JdbcSourceConnector();

    @Override
    public SourceType supports() {
        return SourceType.POSTGRESQL;
    }

    @Override
    public void testConnection(ConnectionDocument connection, String decryptedSecret) {
        delegate.testConnection(connection, decryptedSecret);
    }

    @Override
    public SchemaResponse discoverSchema(ConnectionDocument connection, String decryptedSecret) {
        return delegate.discoverSchema(connection, decryptedSecret);
    }

    @Override
    public QueryResponse executeQuery(ConnectionDocument connection, String decryptedSecret, QueryRequest request) {
        return delegate.executeQuery(connection, decryptedSecret, request);
    }
}
```

Create the same wrapper for `MYSQL`, `SQLSERVER`, and `ORACLE`.

---

## MongoDB connector

```java
package com.example.datahub.connector.mongo;

import com.example.datahub.connector.SourceConnector;
import com.example.datahub.dto.QueryRequest;
import com.example.datahub.dto.QueryResponse;
import com.example.datahub.dto.SchemaResponse;
import com.example.datahub.model.ConnectionDocument;
import com.example.datahub.model.SourceType;
import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.mongodb.client.*;
import org.bson.Document;
import org.springframework.stereotype.Component;

import java.util.*;

@Component
public class MongoSourceConnector implements SourceConnector {

    private final ObjectMapper objectMapper = new ObjectMapper();

    @Override
    public SourceType supports() {
        return SourceType.MONGODB;
    }

    @Override
    public void testConnection(ConnectionDocument connection, String decryptedSecret) {
        try (MongoClient client = MongoClients.create(connection.buildMongoUri(decryptedSecret))) {
            client.listDatabaseNames().first();
        } catch (Exception e) {
            throw new IllegalStateException("Mongo connection failed: " + e.getMessage(), e);
        }
    }

    @Override
    public SchemaResponse discoverSchema(ConnectionDocument connection, String decryptedSecret) {
        try (MongoClient client = MongoClients.create(connection.buildMongoUri(decryptedSecret))) {
            MongoDatabase db = client.getDatabase(connection.getDatabaseName());
            List<String> collections = db.listCollectionNames().into(new ArrayList<>());

            SchemaResponse response = new SchemaResponse();
            response.setConnectionType(connection.getSourceType().name());
            response.setObjects(collections);
            return response;
        } catch (Exception e) {
            throw new IllegalStateException("Mongo schema discovery failed: " + e.getMessage(), e);
        }
    }

    @Override
    public QueryResponse executeQuery(ConnectionDocument connection, String decryptedSecret, QueryRequest request) {
        long start = System.currentTimeMillis();

        try (MongoClient client = MongoClients.create(connection.buildMongoUri(decryptedSecret))) {
            MongoDatabase db = client.getDatabase(connection.getDatabaseName());

            Map<String, Object> payload = objectMapper.readValue(
                request.getQuery(), new TypeReference<>() {}
            );

            String collectionName = Objects.toString(payload.get("collection"));
            Map<String, Object> filterMap = (Map<String, Object>) payload.getOrDefault("filter", Map.of());

            MongoCollection<Document> collection = db.getCollection(collectionName);
            FindIterable<Document> docs = collection.find(new Document(filterMap)).limit(request.getLimit());

            List<Map<String, Object>> rows = new ArrayList<>();
            for (Document doc : docs) {
                rows.add(doc);
            }

            QueryResponse response = new QueryResponse();
            response.setConnectionId(connection.getId());
            response.setSourceType(connection.getSourceType().name());
            response.setRows(rows);
            response.setCount(rows.size());
            response.setExecutionTimeMs(System.currentTimeMillis() - start);
            return response;
        } catch (Exception e) {
            throw new IllegalStateException("Mongo query failed: " + e.getMessage(), e);
        }
    }
}
```

### Example Mongo query payload

```json
{
    "collection": "customers",
    "filter": {
        "country": "US"
    }
}
```

