## Connector abstraction

This is the key extensibility point.

```java
package com.example.datahub.connector;

import com.example.datahub.dto.QueryRequest;
import com.example.datahub.dto.QueryResponse;
import com.example.datahub.dto.SchemaResponse;
import com.example.datahub.model.ConnectionDocument;
import com.example.datahub.model.SourceType;

public interface SourceConnector {

    SourceType supports();

    void testConnection(ConnectionDocument connection, String decryptedSecret);

    SchemaResponse discoverSchema(ConnectionDocument connection, String decryptedSecret);

    QueryResponse executeQuery(ConnectionDocument connection, String decryptedSecret, QueryRequest request);
}
```

---

## Connector factory

```java
package com.example.datahub.connector;

import com.example.datahub.model.SourceType;
import org.springframework.stereotype.Component;

import java.util.EnumMap;
import java.util.List;
import java.util.Map;

@Component
public class ConnectorFactory {

    private final Map<SourceType, SourceConnector> connectors = new EnumMap<>(SourceType.class);

    public ConnectorFactory(List<SourceConnector> connectorList) {
        for (SourceConnector connector : connectorList) {
            connectors.put(connector.supports(), connector);
        }
    }

    public SourceConnector get(SourceType sourceType) {
        SourceConnector connector = connectors.get(sourceType);
        if (connector == null) {
            throw new IllegalArgumentException("No connector registered for " + sourceType);
        }
        return connector;
    }
}
```

