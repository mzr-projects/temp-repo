## Query service

```java
package com.example.datahub.service;

import com.example.datahub.connector.ConnectorFactory;
import com.example.datahub.dto.QueryRequest;
import com.example.datahub.dto.QueryResponse;
import com.example.datahub.dto.SchemaResponse;
import com.example.datahub.model.ConnectionDocument;
import com.example.datahub.security.SecretCryptoService;
import org.springframework.stereotype.Service;

@Service
public class QueryService {

    private final ConnectionService connectionService;
    private final SecretCryptoService cryptoService;
    private final ConnectorFactory connectorFactory;

    public QueryService(ConnectionService connectionService,
                        SecretCryptoService cryptoService,
                        ConnectorFactory connectorFactory) {
        this.connectionService = connectionService;
        this.cryptoService = cryptoService;
        this.connectorFactory = connectorFactory;
    }

    public QueryResponse execute(QueryRequest request) {
        ConnectionDocument doc = connectionService.getDocument(request.getConnectionId());
        String secret = cryptoService.decrypt(doc.getEncryptedSecret());
        return connectorFactory.get(doc.getSourceType()).executeQuery(doc, secret, request);
    }

    public SchemaResponse schema(String connectionId) {
        ConnectionDocument doc = connectionService.getDocument(connectionId);
        String secret = cryptoService.decrypt(doc.getEncryptedSecret());
        return connectorFactory.get(doc.getSourceType()).discoverSchema(doc, secret);
    }
}
```

