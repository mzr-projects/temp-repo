## Service layer

```java
package com.example.datahub.service;

import com.example.datahub.connector.ConnectorFactory;
import com.example.datahub.dto.ConnectionCreateRequest;
import com.example.datahub.dto.ConnectionResponse;
import com.example.datahub.model.ConnectionDocument;
import com.example.datahub.repository.ConnectionSearchRepository;
import com.example.datahub.security.SecretCryptoService;
import org.springframework.stereotype.Service;

import java.time.Instant;
import java.util.List;

@Service
public class ConnectionService {

    private final ConnectionSearchRepository repository;
    private final SecretCryptoService cryptoService;
    private final ConnectorFactory connectorFactory;

    public ConnectionService(ConnectionSearchRepository repository,
                             SecretCryptoService cryptoService,
                             ConnectorFactory connectorFactory) {
        this.repository = repository;
        this.cryptoService = cryptoService;
        this.connectorFactory = connectorFactory;
    }

    public ConnectionResponse create(ConnectionCreateRequest request, String createdBy) {
        ConnectionDocument doc = new ConnectionDocument();
        doc.setName(request.getName());
        doc.setSourceType(request.getSourceType());
        doc.setCategory(request.getSourceType().getCategory());
        doc.setHost(request.getHost());
        doc.setPort(request.getPort());
        doc.setDatabaseName(request.getDatabaseName());
        doc.setUsername(request.getUsername());
        doc.setEncryptedSecret(cryptoService.encrypt(request.getSecret()));
        doc.setSslEnabled(request.isSslEnabled());
        doc.setProperties(request.getProperties());
        doc.setCreatedAt(Instant.now());
        doc.setUpdatedAt(Instant.now());
        doc.setCreatedBy(createdBy);
        doc.setLastConnectionStatus("UNKNOWN");

        ConnectionDocument saved = repository.save(doc);
        return map(saved);
    }

    public List<ConnectionResponse> list() {
        return ((List<ConnectionDocument>) repository.findAll()).stream().map(this::map).toList();
    }

    public ConnectionDocument getDocument(String id) {
        return repository.findById(id).orElseThrow(() -> new IllegalArgumentException("Connection not found: " + id));
    }

    public void testConnection(String id) {
        ConnectionDocument doc = getDocument(id);
        String secret = cryptoService.decrypt(doc.getEncryptedSecret());

        try {
            connectorFactory.get(doc.getSourceType()).testConnection(doc, secret);
            doc.setLastConnectionStatus("SUCCESS");
            doc.setLastConnectionMessage("Connection successful");
        } catch (Exception e) {
            doc.setLastConnectionStatus("FAILED");
            doc.setLastConnectionMessage(e.getMessage());
            repository.save(doc);
            throw e;
        }

        doc.setUpdatedAt(Instant.now());
        repository.save(doc);
    }

    private ConnectionResponse map(ConnectionDocument doc) {
        ConnectionResponse response = new ConnectionResponse();
        response.setId(doc.getId());
        response.setName(doc.getName());
        response.setSourceType(doc.getSourceType().name());
        response.setCategory(doc.getCategory().name());
        response.setHost(doc.getHost());
        response.setPort(doc.getPort());
        response.setDatabaseName(doc.getDatabaseName());
        response.setUsername(doc.getUsername());
        response.setSslEnabled(doc.isSslEnabled());
        response.setProperties(doc.getProperties());
        response.setCreatedAt(doc.getCreatedAt());
        response.setUpdatedAt(doc.getUpdatedAt());
        response.setLastConnectionStatus(doc.getLastConnectionStatus());
        response.setLastConnectionMessage(doc.getLastConnectionMessage());
        return response;
    }
}
```

