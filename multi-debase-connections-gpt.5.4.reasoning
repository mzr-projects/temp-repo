package com.example.datahub.model;

public enum SourceType {
    POSTGRESQL(SourceCategory.RDBMS),
    MYSQL(SourceCategory.RDBMS),
    SQLSERVER(SourceCategory.RDBMS),
    ORACLE(SourceCategory.RDBMS),
    MONGODB(SourceCategory.DOCUMENT),
    REDIS(SourceCategory.KEY_VALUE);

    private final SourceCategory category;

    SourceType(SourceCategory category) {
        this.category = category;
    }

    public SourceCategory getCategory() {
        return category;
    }
}
