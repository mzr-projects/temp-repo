## Elasticsearch document

This is the metadata stored in Elasticsearch.

```java
package com.example.datahub.model;

import org.springframework.data.annotation.Id;
import org.springframework.data.elasticsearch.annotations.DateFormat;
import org.springframework.data.elasticsearch.annotations.Document;
import org.springframework.data.elasticsearch.annotations.Field;
import org.springframework.data.elasticsearch.annotations.FieldType;

import java.time.Instant;
import java.util.Map;

@Document(indexName = "connection-registry")
public class ConnectionDocument {

    @Id
    private String id;

    @Field(type = FieldType.Keyword)
    private String name;

    @Field(type = FieldType.Keyword)
    private SourceType sourceType;

    @Field(type = FieldType.Keyword)
    private SourceCategory category;

    @Field(type = FieldType.Keyword)
    private String host;

    @Field(type = FieldType.Integer)
    private Integer port;

    @Field(type = FieldType.Keyword)
    private String databaseName;

    @Field(type = FieldType.Keyword)
    private String username;

    @Field(type = FieldType.Text, index = false)
    private String encryptedSecret;

    @Field(type = FieldType.Keyword)
    private boolean sslEnabled;

    @Field(type = FieldType.Object)
    private Map<String, Object> properties;

    @Field(type = FieldType.Date, format = DateFormat.date_time)
    private Instant createdAt;

    @Field(type = FieldType.Date, format = DateFormat.date_time)
    private Instant updatedAt;

    @Field(type = FieldType.Keyword)
    private String createdBy;

    @Field(type = FieldType.Keyword)
    private String lastConnectionStatus;

    @Field(type = FieldType.Text, index = false)
    private String lastConnectionMessage;

    public ConnectionDocument() {
    }

    public String buildJdbcUrl() {
        return switch (sourceType) {
            case POSTGRESQL -> "jdbc:postgresql://%s:%d/%s".formatted(host, port, databaseName);
            case MYSQL -> "jdbc:mysql://%s:%d/%s".formatted(host, port, databaseName);
            case SQLSERVER -> "jdbc:sqlserver://%s:%d;databaseName=%s".formatted(host, port, databaseName);
            case ORACLE -> "jdbc:oracle:thin:@%s:%d/%s".formatted(host, port, databaseName);
            default -> throw new IllegalStateException("Not a JDBC source type: " + sourceType);
        };
    }

    public String buildMongoUri(String password) {
        return "mongodb://%s:%s@%s:%d/%s".formatted(username, password, host, port, databaseName);
    }

    public String buildRedisUri(String password) {
        return "redis://:%s@%s:%d".formatted(password, host, port);
    }

    // getters and setters omitted for brevity
}
```

