## 5. Complete Service Implementation

```java
@Slf4j
@Service
@RequiredArgsConstructor
public class MultiIndexSirenPaginationService {
    
    private final RestTemplate restTemplate;
    private final ObjectMapper objectMapper;
    private static final String ES_HOST = "http://localhost:9200";
    
    /**
     * Execute search with multiple parent and child indexes
     */
    public PaginationResponse<Map<String, Object>> searchMultiIndex(
            MultiIndexPaginationRequest request) {
        
        String url = String.format("%s/siren/_search", ES_HOST);
        
        Map<String, Object> requestBody = buildCompleteMultiIndexQuery(request);
        
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        
        try {
            String jsonBody = objectMapper.writeValueAsString(requestBody);
            log.debug("Executing multi-index search: {}", jsonBody);
            
            HttpEntity<String> entity = new HttpEntity<>(jsonBody, headers);
            
            ResponseEntity<String> response = restTemplate.exchange(
                url, HttpMethod.GET, entity, String.class
            );
            
            return parseResponse(response.getBody());
            
        } catch (Exception e) {
            log.error("Error executing multi-index search", e);
            throw new RuntimeException("Failed to execute search", e);
        }
    }
    
    /**
     * Build complete query for multiple indexes and joins
     */
    private Map<String, Object> buildCompleteMultiIndexQuery(
            MultiIndexPaginationRequest request) {
        
        Map<String, Object> query = new HashMap<>();
        MultiJoinConfig config = request.getJoinConfig();
        
        // Sort
        query.put("sort", Collections.singletonMap("_shard_doc", "asc"));
        
        // PIT
        if (request.getPitId() != null) {
            query.put("pit", Collections.singletonMap("id", request.getPitId()));
        }
        
        // search_after
        if (request.getSearchAfter() != null && !request.getSearchAfter().isEmpty()) {
            query.put("search_after", request.getSearchAfter());
        }
        
        query.put("size", request.getPageSize());
        
        // Build the join query
        Map<String, Object> rootQuery = new HashMap<>();
        
        // Check if we need a bool query to combine parent filter with join
        if (config.getParentFilter() != null) {
            Map<String, Object> boolQuery = new HashMap<>();
            List<Map<String, Object>> mustClauses = new ArrayList<>();
            
            // Add parent filter
            mustClauses.add(config.getParentFilter());
            
            // Add join
            mustClauses.add(Collections.singletonMap("join", 
                buildMultiLevelJoin(config)));
            
            boolQuery.put("must", mustClauses);
            rootQuery.put("bool", boolQuery);
        } else {
            rootQuery.put("join", buildMultiLevelJoin(config));
        }
        
        query.put("query", rootQuery);
        
        return query;
    }
    
    /**
     * Build multi-level join structure
     */
    private Map<String, Object> buildMultiLevelJoin(MultiJoinConfig config) {
        Map<String, Object> joinQuery = new HashMap<>();
        
        // Child1 indexes
        joinQuery.put("indices", config.getChild1Indexes());
        joinQuery.put("on", Arrays.asList(config.getParentField(), config.getChild1Field()));
        
        // Build child1 request
        Map<String, Object> child1Request = new HashMap<>();
        
        // If there's a second level join
        if (config.getChild2Indexes() != null && !config.getChild2Indexes().isEmpty()) {
            Map<String, Object> nestedJoin = new HashMap<>();
            nestedJoin.put("indices", config.getChild2Indexes());
            nestedJoin.put("on", Arrays.asList(config.getChild1Field(), config.getChild2Field()));
            
            // Child2 request
            Map<String, Object> child2Request = new HashMap<>();
            if (config.getChild2Filter() != null) {
                child2Request.put("query", config.getChild2Filter());
            } else {
                child2Request.put("query", Collections.singletonMap("match_all", new HashMap<>()));
            }
            nestedJoin.put("request", child2Request);
            
            // Add to child1 query
            if (config.getChild1Filter() != null) {
                Map<String, Object> boolQuery = new HashMap<>();
                boolQuery.put("must", Arrays.asList(
                    config.getChild1Filter(),
                    Collections.singletonMap("join", nestedJoin)
                ));
                child1Request.put("query", Collections.singletonMap("bool", boolQuery));
            } else {
                child1Request.put("query", Collections.singletonMap("join", nestedJoin));
            }
        } else {
            // No nested join, just filter or match_all
            if (config.getChild1Filter() != null) {
                child1Request.put("query", config.getChild1Filter());
            } else {
                child1Request.put("query", Collections.singletonMap("match_all", new HashMap<>()));
            }
        }
        
        joinQuery.put("request", child1Request);
        
        return joinQuery;
    }
    
    /**
     * Parse response (same as before)
     */
    private PaginationResponse<Map<String, Object>> parseResponse(String responseBody) 
            throws IOException {
        
        JsonNode root = objectMapper.readTree(responseBody);
        PaginationResponse<Map<String, Object>> response = new PaginationResponse<>();
        
        if (root.has("pit_id")) {
            response.setPitId(root.get("pit_id").asText());
        }
        
        JsonNode hitsNode = root.path("hits").path("hits");
        List<Map<String, Object>> results = new ArrayList<>();
        List<Object> lastSort = null;
        
        for (JsonNode hit : hitsNode) {
            Map<String, Object> document = new HashMap<>();
            document.put("_id", hit.get("_id").asText());
            document.put("_index", hit.get("_index").asText());
            document.put("_source", objectMapper.convertValue(
                hit.get("_source"), Map.class));
            
            if (hit.has("sort")) {
                lastSort = objectMapper.convertValue(hit.get("sort"), List.class);
                document.put("sort", lastSort);
            }
            
            results.add(document);
        }
        
        response.setResults(results);
        response.setSearchAfter(lastSort);
        response.setHasMore(results.size() >= root.path("size").asInt());
        response.setTotalHits(root.path("hits").path("total").path("value").asLong());
        
        return response;
    }
}
```

## 6. Controller for Multi-Index

```java
@RestController
@RequestMapping("/api/siren/multi")
@RequiredArgsConstructor
public class MultiIndexSirenController {
    
    private final MultiIndexSirenPaginationService sirenService;
    
    /**
     * Initialize pagination for multiple parent indexes
     */
    @PostMapping("/pagination/init")
    public ResponseEntity<Map<String, String>> initMultiIndexPagination(
            @RequestBody List<String> parentIndexes,
            @RequestParam(defaultValue = "5m") String keepAlive) {
        
        String pitId = sirenService.openPitForMultipleIndexes(parentIndexes, keepAlive);
        return ResponseEntity.ok(Map.of("pitId", pitId));
    }
    
    /**
     * Search with multiple joins
     */
    @PostMapping("/pagination/search")
    public ResponseEntity<PaginationResponse<Map<String, Object>>> searchMultiIndex(
            @RequestBody MultiIndexPaginationRequest request) {
        
        PaginationResponse<Map<String, Object>> response = 
            sirenService.searchMultiIndex(request);
        
        return ResponseEntity.ok(response);
    }
}
```

## 7. Usage Examples

### Example 1: Multiple Parent Indexes, Single Child

```java
// Initialize
List<String> parentIndexes = Arrays.asList("machine-*", "server-*", "device-*");
String pitId = sirenService.openPitForMultipleIndexes(parentIndexes, "5m");

// Build config
MultiJoinConfig config = MultiJoinConfig.builder()
    .parentIndexes(parentIndexes)
    .child1Indexes(Arrays.asList("beat-*", "metric-*"))
    .parentField("id")
    .child1Field("machine_id")
    .build();

// Search
MultiIndexPaginationRequest request = new MultiIndexPaginationRequest();
request.setPitId(pitId);
request.setPageSize(50);
request.setJoinConfig(config);

PaginationResponse<Map<String, Object>> response = 
    sirenService.searchMultiIndex(request);
```

### Example 2: Nested Joins (Parent -> Child1 -> Child2)

```java
MultiJoinConfig config = MultiJoinConfig.builder()
    // Parent: machines
    .parentIndexes(Arrays.asList("machine-*"))
    
    // First join: machine -> logs
    .child1Indexes(Arrays.asList("logs-*"))
    .parentField("machine_id")
    .child1Field("machine_id")
    
    // Second join: logs -> errors
    .child2Indexes(Arrays.asList("errors-*"))
    .child2Field("log_id")
    
    // Optional filters
    .parentFilter(Map.of("range", Map.of("created_date", 
        Map.of("gte", "2024-01-01"))))
    .child1Filter(Map.of("term", Map.of("level", "ERROR")))
    
    .build();

String pitId = sirenService.openPitForMultipleIndexes(
    config.getParentIndexes(), "10m");

MultiIndexPaginationRequest request = new MultiIndexPaginationRequest();
request.setPitId(pitId);
request.setPageSize(100);
request.setJoinConfig(config);

// Paginate through all results
do {
    PaginationResponse<Map<String, Object>> response = 
        sirenService.searchMultiIndex(request);
    
    // Process results
    processResults(response.getResults());
    
    // Update for next page
    request.setPitId(response.getPitId());
    request.setSearchAfter(response.getSearchAfter());
    
} while (response.isHasMore());
```

