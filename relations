/**
 * Represents a branch: its root and all relations reachable from it, in order.
 */
record BranchResult(
        String         root,
        List<Relation> relations,  // topologically ordered
        int            depth,      // longest path from root
        boolean        isMain      // true for the root with most descendants
) {}


/**
 * Detects all branches (one per root), ordered by descendant count descending.
 * The first entry is always the "main" branch.
 */
public List<BranchResult> detectBranches(List<Relation> relations) {
    if (relations == null || relations.isEmpty()) return List.of();

    GraphData g = buildGraph(relations);

    // bySource lookup for relation reconstruction
    Map<String, List<Relation>> bySource = relations.stream()
            .collect(Collectors.groupingBy(Relation::source));

    List<String> roots = g.insertionOrder().stream()
            .filter(n -> g.inDegree().get(n) == 0)
            .collect(Collectors.toList());

    // Build one BranchResult per root
    List<BranchResult> branches = roots.stream()
            .map(root -> buildBranch(root, g.adjacency(), bySource))
            .sorted(Comparator.comparingInt(
                    (BranchResult b) -> b.relations().size()).reversed())
            .collect(Collectors.toList());

    // Mark the first (largest) as main
    if (!branches.isEmpty()) {
        BranchResult first = branches.get(0);
        branches.set(0, new BranchResult(
                first.root(), first.relations(), first.depth(), true));
    }

    return branches;
}

/**
 * BFS from a single root — collects reachable relations in topological order.
 */
private BranchResult buildBranch(
        String root,
        Map<String, List<String>>  adjacency,
        Map<String, List<Relation>> bySource
) {
    List<Relation>  ordered  = new ArrayList<>();
    Set<String>     visited  = new LinkedHashSet<>();
    Queue<String>   queue    = new LinkedList<>();
    Map<String, Integer> depthMap = new HashMap<>();

    queue.offer(root);
    depthMap.put(root, 0);

    while (!queue.isEmpty()) {
        String node = queue.poll();
        if (!visited.add(node)) continue;

        ordered.addAll(bySource.getOrDefault(node, List.of()));

        for (String neighbor : adjacency.getOrDefault(node, List.of())) {
            if (!visited.contains(neighbor)) {
                queue.offer(neighbor);
                depthMap.merge(neighbor,
                        depthMap.getOrDefault(node, 0) + 1, Math::max);
            }
        }
    }

    int maxDepth = depthMap.values().stream()
            .mapToInt(Integer::intValue).max().orElse(0);

    return new BranchResult(root, ordered, maxDepth, false);
}

