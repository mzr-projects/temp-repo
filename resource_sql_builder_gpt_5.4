## Metadata Service

This uses JDBC `DatabaseMetaData` to fetch schemas, tables, columns, and primary keys.

    package com.example.multidb.metadata.service;

    import com.example.multidb.connection.model.ConnectionConfigDocument;
    import com.example.multidb.connection.service.ConnectionService;
    import com.example.multidb.connection.service.DynamicDataSourceManager;
    import com.example.multidb.metadata.model.ColumnMetadata;
    import com.example.multidb.metadata.model.MetadataDocument;
    import com.example.multidb.metadata.model.TableMetadata;
    import com.example.multidb.metadata.repository.MetadataRepository;
    import java.sql.Connection;
    import java.sql.DatabaseMetaData;
    import java.sql.ResultSet;
    import java.util.ArrayList;
    import java.util.HashSet;
    import java.util.List;
    import java.util.Set;
    import java.util.UUID;
    import lombok.RequiredArgsConstructor;
    import org.springframework.stereotype.Service;

    @Service
    @RequiredArgsConstructor
    public class MetadataService {

        private final DynamicDataSourceManager dataSourceManager;
        private final ConnectionService connectionService;
        private final MetadataRepository metadataRepository;

        public List<String> getSchemas(String connectionId) {
            List<String> schemas = new ArrayList<>();
            try (Connection con = dataSourceManager.getConnection(connectionId)) {
                DatabaseMetaData meta = con.getMetaData();
                try (ResultSet rs = meta.getSchemas()) {
                    while (rs.next()) {
                        schemas.add(rs.getString("TABLE_SCHEM"));
                    }
                }
                return schemas;
            } catch (Exception ex) {
                throw new IllegalStateException("Failed to read schemas", ex);
            }
        }

        public List<TableMetadata> getTables(String connectionId, String schema) {
            List<TableMetadata> tables = new ArrayList<>();
            try (Connection con = dataSourceManager.getConnection(connectionId)) {
                DatabaseMetaData meta = con.getMetaData();
                try (ResultSet rs = meta.getTables(null, schema, "%", new String[]{"TABLE", "VIEW"})) {
                    while (rs.next()) {
                        TableMetadata tm = new TableMetadata();
                        tm.setCatalog(rs.getString("TABLE_CAT"));
                        tm.setSchema(rs.getString("TABLE_SCHEM"));
                        tm.setTableName(rs.getString("TABLE_NAME"));
                        tm.setTableType(rs.getString("TABLE_TYPE"));
                        tables.add(tm);
                    }
                }
                return tables;
            } catch (Exception ex) {
                throw new IllegalStateException("Failed to read tables", ex);
            }
        }

        public List<ColumnMetadata> getColumns(String connectionId, String schema, String table) {
            try (Connection con = dataSourceManager.getConnection(connectionId)) {
                DatabaseMetaData meta = con.getMetaData();

                Set<String> primaryKeys = new HashSet<>();
                try (ResultSet pkRs = meta.getPrimaryKeys(null, schema, table)) {
                    while (pkRs.next()) {
                        primaryKeys.add(pkRs.getString("COLUMN_NAME"));
                    }
                }

                List<ColumnMetadata> columns = new ArrayList<>();
                try (ResultSet rs = meta.getColumns(null, schema, table, "%")) {
                    while (rs.next()) {
                        ColumnMetadata cm = new ColumnMetadata(
                                rs.getString("COLUMN_NAME"),
                                String.valueOf(rs.getInt("DATA_TYPE")),
                                rs.getString("TYPE_NAME"),
                                "YES".equalsIgnoreCase(rs.getString("IS_NULLABLE")),
                                primaryKeys.contains(rs.getString("COLUMN_NAME")),
                                rs.getInt("COLUMN_SIZE"),
                                rs.getInt("DECIMAL_DIGITS")
                        );
                        columns.add(cm);
                    }
                }

                return columns;
            } catch (Exception ex) {
                throw new IllegalStateException("Failed to read columns", ex);
            }
        }

        public void discoverAndIndex(String connectionId) {
            ConnectionConfigDocument cfg = connectionService.get(connectionId);
            List<String> schemas = getSchemas(connectionId);

            for (String schema : schemas) {
                List<TableMetadata> tables = getTables(connectionId, schema);
                for (TableMetadata table : tables) {
                    List<ColumnMetadata> columns = getColumns(connectionId, schema, table.getTableName());
                    for (ColumnMetadata column : columns) {
                        MetadataDocument doc = new MetadataDocument();
                        doc.setId(UUID.randomUUID().toString());
                        doc.setConnectionId(connectionId);
                        doc.setDbType(cfg.getDbType().name());
                        doc.setCatalog(table.getCatalog());
                        doc.setSchemaName(schema);
                        doc.setTableName(table.getTableName());
                        doc.setTableType(table.getTableType());
                        doc.setColumnName(column.getName());
                        doc.setJdbcType(column.getJdbcType());
                        doc.setDbTypeName(column.getDbTypeName());
                        doc.setNullable(column.isNullable());
                        doc.setPrimaryKey(column.isPrimaryKey());
                        metadataRepository.save(doc);
                    }
                }
            }
        }
    }

