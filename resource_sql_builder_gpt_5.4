## Query Execution Service

    package com.example.multidb.query.service;

    import com.example.multidb.config.AppProperties;
    import com.example.multidb.connection.service.DynamicDataSourceManager;
    import com.example.multidb.query.model.QueryPreviewRequest;
    import com.example.multidb.query.model.QueryPreviewResponse;
    import java.sql.Connection;
    import java.sql.PreparedStatement;
    import java.sql.ResultSet;
    import java.sql.ResultSetMetaData;
    import java.util.ArrayList;
    import java.util.LinkedHashMap;
    import java.util.List;
    import java.util.Map;
    import org.springframework.stereotype.Service;

    @Service
    public class QueryExecutionService {

        private final QueryBuilderService queryBuilderService;
        private final DynamicDataSourceManager dataSourceManager;
        private final AppProperties appProperties;

        public QueryExecutionService(
                QueryBuilderService queryBuilderService,
                DynamicDataSourceManager dataSourceManager,
                AppProperties appProperties) {
            this.queryBuilderService = queryBuilderService;
            this.dataSourceManager = dataSourceManager;
            this.appProperties = appProperties;
        }

        public QueryPreviewResponse preview(QueryPreviewRequest request) {
            QueryBuilderService.BuiltQuery built = queryBuilderService.build(request);
            List<Map<String, Object>> rows = new ArrayList<>();

            try (Connection con = dataSourceManager.getConnection(request.getConnectionId());
                 PreparedStatement ps = con.prepareStatement(built.sql())) {

                ps.setQueryTimeout(appProperties.getQuery().getQueryTimeoutSeconds());

                List<Object> params = built.params();
                for (int i = 0; i < params.size(); i++) {
                    ps.setObject(i + 1, params.get(i));
                }

                try (ResultSet rs = ps.executeQuery()) {
                    ResultSetMetaData md = rs.getMetaData();
                    int columnCount = md.getColumnCount();

                    while (rs.next()) {
                        Map<String, Object> row = new LinkedHashMap<>();
                        for (int i = 1; i <= columnCount; i++) {
                            row.put(md.getColumnLabel(i), rs.getObject(i));
                        }
                        rows.add(row);
                    }
                }

                return new QueryPreviewResponse(built.sql(), built.params(), rows);
            } catch (Exception ex) {
                throw new IllegalStateException("Query preview failed: " + ex.getMessage(), ex);
            }
        }
    }

