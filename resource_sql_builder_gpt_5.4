## SQL Dialect Helper

This handles quoting and pagination differences.

    package com.example.multidb.query.service;

    import com.example.multidb.connection.model.DbType;
    import org.springframework.stereotype.Component;

    @Component
    public class SqlDialect {

        public String quote(DbType dbType, String identifier) {
            return switch (dbType) {
                case POSTGRESQL, ORACLE, SQLSERVER -> "\"" + identifier + "\"";
            };
        }

        public String qualifiedTable(DbType dbType, String schema, String table) {
            return quote(dbType, schema) + "." + quote(dbType, table);
        }

        public String paginate(DbType dbType, int limit, int offset) {
            return switch (dbType) {
                case POSTGRESQL -> " LIMIT " + limit + " OFFSET " + offset;
                case ORACLE -> " OFFSET " + offset + " ROWS FETCH NEXT " + limit + " ROWS ONLY";
                case SQLSERVER -> " OFFSET " + offset + " ROWS FETCH NEXT " + limit + " ROWS ONLY";
            };
        }
    }

