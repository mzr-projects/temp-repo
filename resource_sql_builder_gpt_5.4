## Query Builder Service

This is the core of the **safe SQL builder**.

Important protections:

* validates selected columns against actual metadata
* validates filtered columns
* only allows supported operators
* uses prepared statement parameters
* enforces pagination

    package com.example.multidb.query.service;

    import com.example.multidb.config.AppProperties;
    import com.example.multidb.connection.model.ConnectionConfigDocument;
    import com.example.multidb.connection.service.ConnectionService;
    import com.example.multidb.metadata.model.ColumnMetadata;
    import com.example.multidb.metadata.service.MetadataService;
    import com.example.multidb.query.model.FilterCondition;
    import com.example.multidb.query.model.FilterOperator;
    import com.example.multidb.query.model.QueryPreviewRequest;
    import com.example.multidb.query.model.SortCondition;
    import java.util.ArrayList;
    import java.util.HashSet;
    import java.util.List;
    import java.util.Locale;
    import java.util.Set;
    import org.springframework.stereotype.Service;

    @Service
    public class QueryBuilderService {

        private final MetadataService metadataService;
        private final ConnectionService connectionService;
        private final SqlDialect sqlDialect;
        private final AppProperties appProperties;

        public QueryBuilderService(
                MetadataService metadataService,
                ConnectionService connectionService,
                SqlDialect sqlDialect,
                AppProperties appProperties) {
            this.metadataService = metadataService;
            this.connectionService = connectionService;
            this.sqlDialect = sqlDialect;
            this.appProperties = appProperties;
        }

        public BuiltQuery build(QueryPreviewRequest request) {
            ConnectionConfigDocument cfg = connectionService.get(request.getConnectionId());

            List<ColumnMetadata> actualColumns = metadataService.getColumns(
                    request.getConnectionId(),
                    request.getSchema(),
                    request.getTable()
            );

            Set<String> allowedColumns = new HashSet<>();
            for (ColumnMetadata c : actualColumns) {
                allowedColumns.add(c.getName().toLowerCase(Locale.ROOT));
            }

            List<String> selectColumns = request.getSelectColumns();
            if (selectColumns == null || selectColumns.isEmpty()) {
                selectColumns = actualColumns.stream().map(ColumnMetadata::getName).toList();
            }

            for (String col : selectColumns) {
                validateColumn(col, allowedColumns);
            }

            int size = Math.min(
                    request.getSize() == null ? appProperties.getQuery().getDefaultPageSize() : request.getSize(),
                    appProperties.getQuery().getMaxPageSize()
            );
            int page = request.getPage() == null ? 0 : request.getPage();
            int offset = page * size;

            StringBuilder sql = new StringBuilder();
            List<Object> params = new ArrayList<>();

            sql.append("SELECT ");
            for (int i = 0; i < selectColumns.size(); i++) {
                if (i > 0) {
                    sql.append(", ");
                }
                sql.append(sqlDialect.quote(cfg.getDbType(), selectColumns.get(i)));
            }

            sql.append(" FROM ");
            sql.append(sqlDialect.qualifiedTable(cfg.getDbType(), request.getSchema(), request.getTable()));

            if (request.getFilters() != null && !request.getFilters().isEmpty()) {
                sql.append(" WHERE ");
                for (int i = 0; i < request.getFilters().size(); i++) {
                    if (i > 0) {
                        sql.append(" AND ");
                    }
                    appendFilter(sql, params, request.getFilters().get(i), allowedColumns, cfg.getDbType(), sqlDialect);
                }
            }

            if (request.getSorts() != null && !request.getSorts().isEmpty()) {
                sql.append(" ORDER BY ");
                for (int i = 0; i < request.getSorts().size(); i++) {
                    SortCondition sort = request.getSorts().get(i);
                    validateColumn(sort.getField(), allowedColumns);
                    if (i > 0) {
                        sql.append(", ");
                    }
                    String direction = "DESC".equalsIgnoreCase(sort.getDirection()) ? "DESC" : "ASC";
                    sql.append(sqlDialect.quote(cfg.getDbType(), sort.getField())).append(" ").append(direction);
                }
            } else if (cfg.getDbType().name().equals("SQLSERVER")) {
                sql.append(" ORDER BY 1");
            }

            sql.append(sqlDialect.paginate(cfg.getDbType(), size, offset));

            return new BuiltQuery(sql.toString(), params);
        }

        private void validateColumn(String field, Set<String> allowedColumns) {
            if (field == null || !allowedColumns.contains(field.toLowerCase(Locale.ROOT))) {
                throw new IllegalArgumentException("Invalid column: " + field);
            }
        }

        private void appendFilter(
                StringBuilder sql,
                List<Object> params,
                FilterCondition filter,
                Set<String> allowedColumns,
                com.example.multidb.connection.model.DbType dbType,
                SqlDialect sqlDialect) {

            validateColumn(filter.getField(), allowedColumns);
            String col = sqlDialect.quote(dbType, filter.getField());

            FilterOperator op = filter.getOperator();
            if (op == null) {
                throw new IllegalArgumentException("Operator is required");
            }

            switch (op) {
                case EQ -> {
                    sql.append(col).append(" = ?");
                    params.add(filter.getValue());
                }
                case NE -> {
                    sql.append(col).append(" <> ?");
                    params.add(filter.getValue());
                }
                case GT -> {
                    sql.append(col).append(" > ?");
                    params.add(filter.getValue());
                }
                case GTE -> {
                    sql.append(col).append(" >= ?");
                    params.add(filter.getValue());
                }
                case LT -> {
                    sql.append(col).append(" < ?");
                    params.add(filter.getValue());
                }
                case LTE -> {
                    sql.append(col).append(" <= ?");
                    params.add(filter.getValue());
                }
                case LIKE -> {
                    sql.append(col).append(" LIKE ?");
                    params.add(filter.getValue());
                }
                case IS_NULL -> sql.append(col).append(" IS NULL");
                case IS_NOT_NULL -> sql.append(col).append(" IS NOT NULL");
                case BETWEEN -> {
                    sql.append(col).append(" BETWEEN ? AND ?");
                    params.add(filter.getValue());
                    params.add(filter.getSecondValue());
                }
                case IN -> {
                    if (!(filter.getValue() instanceof List<?> list) || list.isEmpty()) {
                        throw new IllegalArgumentException("IN operator requires a non-empty list");
                    }
                    sql.append(col).append(" IN (");
                    for (int i = 0; i < list.size(); i++) {
                        if (i > 0) {
                            sql.append(", ");
                        }
                        sql.append("?");
                        params.add(list.get(i));
                    }
                    sql.append(")");
                }
            }
        }

        public record BuiltQuery(String sql, List<Object> params) {
        }
    }

