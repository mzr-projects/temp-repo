## Dynamic DataSource Manager

This caches a `HikariDataSource` per registered connection.

    package com.example.multidb.connection.service;

    import com.example.multidb.config.AppProperties;
    import com.example.multidb.connection.model.ConnectionConfigDocument;
    import com.example.multidb.connection.repository.ConnectionConfigRepository;
    import com.example.multidb.crypto.SecretCryptoService;
    import com.zaxxer.hikari.HikariConfig;
    import com.zaxxer.hikari.HikariDataSource;
    import java.sql.Connection;
    import java.sql.SQLException;
    import java.util.Map;
    import java.util.concurrent.ConcurrentHashMap;
    import javax.sql.DataSource;
    import org.springframework.stereotype.Service;

    @Service
    public class DynamicDataSourceManager {

        private final ConnectionConfigRepository repository;
        private final SecretCryptoService cryptoService;
        private final DriverResolver driverResolver;
        private final AppProperties appProperties;
        private final Map<String, DataSource> cache = new ConcurrentHashMap<>();

        public DynamicDataSourceManager(
                ConnectionConfigRepository repository,
                SecretCryptoService cryptoService,
                DriverResolver driverResolver,
                AppProperties appProperties) {
            this.repository = repository;
            this.cryptoService = cryptoService;
            this.driverResolver = driverResolver;
            this.appProperties = appProperties;
        }

        public Connection getConnection(String connectionId) throws SQLException {
            DataSource ds = cache.computeIfAbsent(connectionId, this::createDataSource);
            return ds.getConnection();
        }

        public void evict(String connectionId) {
            DataSource dataSource = cache.remove(connectionId);
            if (dataSource instanceof HikariDataSource hikari) {
                hikari.close();
            }
        }

        private DataSource createDataSource(String connectionId) {
            ConnectionConfigDocument doc = repository.findById(connectionId)
                    .orElseThrow(() -> new IllegalArgumentException("Connection not found: " + connectionId));

            HikariConfig config = new HikariConfig();
            config.setDriverClassName(driverResolver.resolveDriverClass(doc.getDbType()));
            config.setJdbcUrl(doc.getJdbcUrl());
            config.setUsername(doc.getUsername());
            config.setPassword(cryptoService.decrypt(doc.getEncryptedPassword()));
            config.setMaximumPoolSize(appProperties.getDatasource().getMaxPoolSize());
            config.setConnectionTimeout(appProperties.getDatasource().getConnectionTimeoutMs());
            config.setIdleTimeout(appProperties.getDatasource().getIdleTimeoutMs());
            config.setPoolName("db-" + connectionId);

            return new HikariDataSource(config);
        }
    }

