## 4. Pipeline: one independent reactive stream per topic/group

```java
@Component
@RequiredArgsConstructor
@Slf4j
public class KafkaIngestionPipeline implements SmartLifecycle {

    private final TopicHandlerRegistry registry;
    private final ReceiverOptionsFactory optionsFactory;
    private final NationalCodeLookup lookup;
    private final ObjectMapper mapper;
    private final DeadLetterPublisher dlt;
    private final AppProperties props;
    private final MeterRegistry meters;

    private final Map<String, Disposable> streams = new ConcurrentHashMap<>();

    @Override
    public void start() {
        registry.all().forEach(handler -> {
            var rc = optionsFactory.resolve(handler);
            if (!rc.enabled()) {
                log.warn("Consumer for topic={} is disabled by configuration", rc.topic());
                return;
            }
            streams.put(rc.topic(), startStream(handler, rc));
            log.info("Started consumer topic={} group={} concurrency={}", rc.topic(), rc.groupId(), rc.concurrency());
        });
    }

    private <T> Disposable startStream(TopicHandler<T> handler, ReceiverOptionsFactory.ResolvedConsumer rc) {
        return KafkaReceiver.create(rc.options())
            .receive()
            .groupBy(rec -> rec.receiverOffset().topicPartition())
            .flatMap(partition -> partition.concatMap(rec -> process(handler, rc.groupId(), rec)), rc.concurrency())
            // each stream self-heals independently – a broker hiccup on one group doesn't touch the others
            .retryWhen(Retry.backoff(Long.MAX_VALUE, Duration.ofSeconds(1)).maxBackoff(Duration.ofSeconds(30))
                    .doBeforeRetry(s -> log.error("[{}] stream failed, restarting", rc.groupId(), s.failure())))
            .subscribeOn(Schedulers.boundedElastic())   // isolates each receiver's poll loop
            .subscribe(
                v -> {},
                e -> log.error("[{}] stream terminated fatally", rc.groupId(), e),
                () -> log.info("[{}] stream completed", rc.groupId()));
    }

    private <T> Mono<Void> process(TopicHandler<T> handler, String groupId, ReceiverRecord<String, byte[]> rec) {
        var tags = Tags.of("topic", rec.topic(), "group", groupId);
        var sample = Timer.start(meters);

        return Mono.fromCallable(() -> mapper.readValue(rec.value(), handler.payloadType()))
            .flatMap(payload -> {
                String nc = handler.extractNationalCode(payload);
                if (nc == null || nc.isBlank()) return Mono.error(new InvalidMessageException("nationalCode missing"));
                return lookup.exists(nc)
                    .flatMap(exists -> exists ? handler.onMatch(payload, nc) : handler.onNoMatch(payload, nc));
            })
            .timeout(props.processing().timeout())
            .doOnSuccess(v -> meters.counter("msg.processed", tags.and("result", "ok")).increment())
            .onErrorResume(err -> {
                meters.counter("msg.processed", tags.and("result", "failed")).increment();
                log.error("[{}] failed topic={} partition={} offset={}", groupId, rec.topic(), rec.partition(), rec.offset(), err);
                return dlt.publish(rec, err);
            })
            .doFinally(sig -> {
                rec.receiverOffset().acknowledge();
                sample.stop(meters.timer("msg.latency", tags));
            });
    }

    /** Operational hooks – stop/start a single business at runtime (expose via an Actuator endpoint if you like). */
    public void stopTopic(String topic)  { Optional.ofNullable(streams.remove(topic)).ifPresent(Disposable::dispose); }
    public void startTopic(String topic) {
        if (streams.containsKey(topic)) return;
        var handler = registry.forTopic(topic);
        streams.put(topic, startStream(handler, optionsFactory.resolve(handler)));
    }

    @Override public void stop()       { streams.values().forEach(Disposable::dispose); streams.clear(); }
    @Override public boolean isRunning(){ return !streams.isEmpty(); }
    @Override public int getPhase()    { return Integer.MAX_VALUE - 100; } // start after Redis/WebClient beans, stop early
}
```

