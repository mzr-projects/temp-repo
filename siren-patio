## 4. SIREN Service Class

```java
import co.elastic.clients.elasticsearch.ElasticsearchClient;
import co.elastic.clients.elasticsearch._types.SortOrder;
import co.elastic.clients.json.JsonData;
import co.elastic.clients.transport.endpoints.BooleanResponse;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.*;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import java.io.IOException;
import java.util.*;
import java.util.stream.Collectors;

@Slf4j
@Service
@RequiredArgsConstructor
public class SirenPaginationService {
    
    private final RestTemplate restTemplate = new RestTemplate();
    private final ObjectMapper objectMapper = new ObjectMapper();
    private static final String ES_HOST = "http://localhost:9200";
    
    /**
     * Step 1: Open Point in Time for parent indices
     */
    public String openPit(String parentIndex, String keepAlive) {
        String url = String.format("%s/siren/%s/_pit?keep_alive=%s", 
            ES_HOST, parentIndex, keepAlive);
        
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        
        HttpEntity<String> entity = new HttpEntity<>(headers);
        
        try {
            ResponseEntity<PitResponse> response = restTemplate.exchange(
                url, 
                HttpMethod.POST, 
                entity, 
                PitResponse.class
            );
            
            String pitId = response.getBody().getId();
            log.info("Opened PIT with ID: {}", pitId);
            return pitId;
            
        } catch (Exception e) {
            log.error("Error opening PIT", e);
            throw new RuntimeException("Failed to open PIT", e);
        }
    }
    
    /**
     * Step 2: Execute join query with pagination
     */
    public PaginationResponse<Map<String, Object>> searchWithJoin(
            PaginationRequest paginationRequest,
            String parentIndex,
            String childIndex,
            String parentField,
            String childField) {
        
        String url = String.format("%s/siren/_search", ES_HOST);
        
        // Build the request body
        Map<String, Object> requestBody = buildJoinQueryWithPagination(
            paginationRequest,
            childIndex,
            parentField,
            childField
        );
        
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        
        try {
            String jsonBody = objectMapper.writeValueAsString(requestBody);
            HttpEntity<String> entity = new HttpEntity<>(jsonBody, headers);
            
            ResponseEntity<String> response = restTemplate.exchange(
                url,
                HttpMethod.GET,
                entity,
                String.class
            );
            
            return parseResponse(response.getBody());
            
        } catch (Exception e) {
            log.error("Error executing search", e);
            throw new RuntimeException("Failed to execute search", e);
        }
    }
    
    /**
     * Build the SIREN join query with PIT and pagination parameters
     */
    private Map<String, Object> buildJoinQueryWithPagination(
            PaginationRequest paginationRequest,
            String childIndex,
            String parentField,
            String childField) {
        
        Map<String, Object> query = new HashMap<>();
        
        // Add sort with tiebreaker
        Map<String, String> sort = new HashMap<>();
        sort.put("_shard_doc", "asc");
        query.put("sort", sort);
        
        // Add PIT
        if (paginationRequest.getPitId() != null) {
            Map<String, String> pit = new HashMap<>();
            pit.put("id", paginationRequest.getPitId());
            query.put("pit", pit);
        }
        
        // Add search_after for pagination (if not first page)
        if (paginationRequest.getSearchAfter() != null && 
            !paginationRequest.getSearchAfter().isEmpty()) {
            query.put("search_after", paginationRequest.getSearchAfter());
        }
        
        // Add size
        query.put("size", paginationRequest.getPageSize());
        
        // Build the join query
        Map<String, Object> joinQuery = new HashMap<>();
        joinQuery.put("indices", Arrays.asList(childIndex));
        joinQuery.put("on", Arrays.asList(parentField, childField));
        
        // Child request
        Map<String, Object> childRequest = new HashMap<>();
        Map<String, Object> matchAll = new HashMap<>();
        childRequest.put("query", Collections.singletonMap("match_all", matchAll));
        joinQuery.put("request", childRequest);
        
        // Wrap in query
        Map<String, Object> outerQuery = new HashMap<>();
        outerQuery.put("join", joinQuery);
        query.put("query", outerQuery);
        
        return query;
    }
    
    /**
     * Parse the Elasticsearch response
     */
    private PaginationResponse<Map<String, Object>> parseResponse(String responseBody) 
            throws IOException {
        
        JsonNode root = objectMapper.readTree(responseBody);
        PaginationResponse<Map<String, Object>> response = new PaginationResponse<>();
        
        // Extract PIT ID (may have changed)
        if (root.has("pit_id")) {
            response.setPitId(root.get("pit_id").asText());
        }
        
        // Extract hits
        JsonNode hitsNode = root.path("hits").path("hits");
        List<Map<String, Object>> results = new ArrayList<>();
        List<Object> lastSort = null;
        
        for (JsonNode hit : hitsNode) {
            Map<String, Object> document = new HashMap<>();
            document.put("_id", hit.get("_id").asText());
            document.put("_source", objectMapper.convertValue(
                hit.get("_source"), Map.class));
            
            // Extract sort values
            if (hit.has("sort")) {
                lastSort = objectMapper.convertValue(
                    hit.get("sort"), List.class);
                document.put("sort", lastSort);
            }
            
            results.add(document);
        }
        
        response.setResults(results);
        response.setSearchAfter(lastSort);
        response.setHasMore(results.size() == root.path("size").asInt());
        response.setTotalHits(root.path("hits").path("total").path("value").asLong());
        
        return response;
    }
    
    /**
     * Step 3: Close the PIT when done
     */
    public void closePit(String pitId) {
        String url = String.format("%s/siren/_pit", ES_HOST);
        
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        
        Map<String, String> body = Collections.singletonMap("id", pitId);
        
        try {
            String jsonBody = objectMapper.writeValueAsString(body);
            HttpEntity<String> entity = new HttpEntity<>(jsonBody, headers);
            
            restTemplate.exchange(url, HttpMethod.DELETE, entity, String.class);
            log.info("Closed PIT: {}", pitId);
            
        } catch (Exception e) {
            log.error("Error closing PIT", e);
        }
    }
}
```

## 5. Controller

```java
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.Map;

@RestController
@RequestMapping("/api/siren")
@RequiredArgsConstructor
public class SirenPaginationController {
    
    private final SirenPaginationService sirenService;
    
    /**
     * Initialize pagination - opens PIT
     */
    @PostMapping("/pagination/init")
    public ResponseEntity<Map<String, String>> initPagination(
            @RequestParam String parentIndex,
            @RequestParam(defaultValue = "5m") String keepAlive) {
        
        String pitId = sirenService.openPit(parentIndex, keepAlive);
        return ResponseEntity.ok(Map.of("pitId", pitId));
    }
    
    /**
     * Get page of results with join
     */
    @PostMapping("/pagination/search")
    public ResponseEntity<PaginationResponse<Map<String, Object>>> searchPage(
            @RequestBody PaginationRequest request,
            @RequestParam String parentIndex,
            @RequestParam String childIndex,
            @RequestParam String parentField,
            @RequestParam String childField) {
        
        PaginationResponse<Map<String, Object>> response = 
            sirenService.searchWithJoin(
                request, 
                parentIndex, 
                childIndex, 
                parentField, 
                childField
            );
        
        return ResponseEntity.ok(response);
    }
    
    /**
     * Close PIT when done
     */
    @DeleteMapping("/pagination/close")
    public ResponseEntity<Void> closePagination(@RequestParam String pitId) {
        sirenService.closePit(pitId);
        return ResponseEntity.noContent().build();
    }
}
```

## 6. Complete Pagination Example

```java
@Service
@RequiredArgsConstructor
public class DataExportService {
    
    private final SirenPaginationService sirenService;
    
    /**
     * Example: Export all data with pagination
     */
    public List<Map<String, Object>> exportAllData(
            String parentIndex,
            String childIndex,
            String parentField,
            String childField) {
        
        List<Map<String, Object>> allResults = new ArrayList<>();
        String pitId = null;
        
        try {
            // Step 1: Open PIT
            pitId = sirenService.openPit(parentIndex, "5m");
            
            // Step 2: Get first page
            PaginationRequest request = new PaginationRequest();
            request.setPitId(pitId);
            request.setPageSize(100);
            
            PaginationResponse<Map<String, Object>> response;
            
            do {
                // Execute search
                response = sirenService.searchWithJoin(
                    request,
                    parentIndex,
                    childIndex,
                    parentField,
                    childField
                );
                
                // Collect results
                allResults.addAll(response.getResults());
                
                // Update for next page
                request.setPitId(response.getPitId()); // Use updated PIT ID
                request.setSearchAfter(response.getSearchAfter());
                
                log.info("Retrieved {} documents, total so far: {}", 
                    response.getResults().size(), allResults.size());
                
            } while (response.isHasMore());
            
            log.info("Export completed. Total documents: {}", allResults.size());
            return allResults;
            
        } finally {
            // Step 3: Always close PIT
            if (pitId != null) {
                sirenService.closePit(pitId);
            }
        }
    }
}
```

## 7. Usage Example

```bash
# 1. Initialize pagination (get PIT ID)
curl -X POST "http://localhost:8080/api/siren/pagination/init?parentIndex=machine-*&keepAlive=5m"

# Response: {"pitId": "AQ92aV82NzVhOTQ5YV80MWU=#..."}

# 2. Get first page
curl -X POST "http://localhost:8080/api/siren/pagination/search?parentIndex=machine-*&childIndex=beat-*&parentField=id&childField=machine" \
-H "Content-Type: application/json" \
-d '{
  "pitId": "AQ92aV82NzVhOTQ5YV80MWU=#...",
  "pageSize": 10
}'

# 3. Get next page (use pitId and searchAfter from previous response)
curl -X POST "http://localhost:8080/api/siren/pagination/search?parentIndex=machine-*&childIndex=beat-*&parentField=id&childField=machine" \
-H "Content-Type: application/json" \
-d '{
  "pitId": "updated_pit_id_from_response",
  "pageSize": 10,
  "searchAfter": [1]
}'

# 4. Close PIT when done
curl -X DELETE "http://localhost:8080/api/siren/pagination/close?pitId=AQ92aV82NzVhOTQ5YV80MWU=#..."
```

## Key Points

* **Always use the updated PIT ID** from each response for the next request
* **Sort with `_shard_doc`** is required as the tiebreaker
* **Don't include index pattern** in search URL when using PIT
* **Always close PIT** to free resources (use try-finally)
* **PIT ID is single-use** in SIREN - each request may return a new ID
* **Keep-alive extends** the PIT lifetime with each request

This example provides a complete, production-ready implementation for paginating SIREN join queries using Point in Time in Spring Boot.

