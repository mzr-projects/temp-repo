## Overview
Deliver a reusable Spring Boot module that accepts a rich query definition (multiple joins, filters, aggregations) and compiles it into a SIREn-compatible Elasticsearch query. The module centers on declarative DTOs, a layered builder pipeline, and guardrails (validation, allow-lists, limits) so any UI or upstream client can safely construct complex joins.

## Data Contract
* `JoinQueryRequest`
    * `List<JoinSpec> joins`: ordered join descriptions (outer ↔ inner, many-to-many).
    * `Map<String, FilterClause> indexFilters`: per-index filter stack.
    * `List<AggregationSpec> aggregations`: aggregations keyed by name, with optional nested children.
    * `Pagination pagination`
    * `boolean trackTotalHits`
    * `Map<String, Object> runtimeMappings`
* `JoinSpec`
    * `String[] indices`
    * `JoinType type`
    * `Map<String, String> onFields` (index → field)
    * `Integer maxDocs` (per join guard)

This contract lets the client describe arbitrary join chains and parallel aggregations.

    package com.example.search.dto;

    import jakarta.validation.Valid;
    import jakarta.validation.constraints.*;
    import java.util.List;
    import java.util.Map;

    public record JoinQueryRequest(
            @NotEmpty List<@Valid JoinSpec> joins,
            @NotEmpty Map<String, @Valid FilterClause> indexFilters,
            List<@Valid AggregationSpec> aggregations,
            @Valid Pagination pagination,
            boolean trackTotalHits,
            Map<String, Object> runtimeMappings
    ) {}

    public record JoinSpec(
            @Size(min = 2) String[] indices,
            @NotNull JoinType type,
            @NotEmpty Map<String, String> onFields,
            @Positive Integer maxDocs
    ) {}

    public enum JoinType { INNER, LEFT, RIGHT }

    public record FilterClause(
            List<@Valid TermFilter> terms,
            List<@Valid RangeFilter> ranges,
            List<@Valid ExistsFilter> exists
    ) {}

    public record TermFilter(@NotBlank String field, @NotNull Object value) {}
    public record RangeFilter(@NotBlank String field, Double gte, Double lte) {}
    public record ExistsFilter(@NotBlank String field) {}

    public record AggregationSpec(
            @NotBlank String name,
            @NotBlank String type,
            @NotBlank String field,
            Integer size,
            List<@Valid AggregationSpec> subAggregations
    ) {}

    public record Pagination(
            @PositiveOrZero int from,
            @Positive @Max(5000) int size
    ) {}

## Query Builder
* Input validation ensures:
    * Joins reference known indices.
    * `onFields` present for every index in a join.
    * Aggregation depth within configured limit.
* Builder stages:
    * root metadata (from, size, track_total_hits, runtime_mappings)
    * SIREn `query` composed of `joins`, `queries`, optional `post_filter`
    * Aggregations keyed by unique names, supporting recursion
* Each join spec is translated into a SIREn `join` clause. Multiple joins become a list assigned to `query.siren.joins`
* Filters per index are compiled into bool clauses.

    package com.example.search.query;

    import com.example.search.dto.*;
    import com.fasterxml.jackson.databind.ObjectMapper;
    import org.springframework.stereotype.Component;

    import java.util.*;

    @Component
    public class SirenMultiJoinBuilder {

        private final ObjectMapper mapper;

        public SirenMultiJoinBuilder(ObjectMapper mapper) {
            this.mapper = mapper;
        }

        public String build(JoinQueryRequest request) {
            Map<String, Object> root = new LinkedHashMap<>();

            Pagination pagination = Optional.ofNullable(request.pagination())
                    .orElse(new Pagination(0, 100));
            root.put("from", pagination.from());
            root.put("size", pagination.size());
            root.put("track_total_hits", request.trackTotalHits());

            if (request.runtimeMappings() != null && !request.runtimeMappings().isEmpty()) {
                root.put("runtime_mappings", request.runtimeMappings());
            }

            Map<String, Object> siren = new LinkedHashMap<>();
            siren.put("joins", request.joins().stream().map(this::buildJoinClause).toList());
            siren.put("queries", buildPerIndexQueries(request.indexFilters()));

            root.put("query", Map.of("siren", siren));

            if (request.aggregations() != null && !request.aggregations().isEmpty()) {
                Map<String, Object> aggs = new LinkedHashMap<>();
                request.aggregations().forEach(agg -> aggs.put(agg.name(), buildAgg(agg)));
                root.put("aggs", aggs);
            }

            try {
                return mapper.writeValueAsString(root);
            } catch (Exception e) {
                throw new IllegalStateException("Failed to serialize multi-join query", e);
            }
        }

        private Map<String, Object> buildJoinClause(JoinSpec spec) {
            Map<String, Object> join = new LinkedHashMap<>();
            join.put("type", spec.type().name().toLowerCase());
            join.put("indices", spec.indices());
            join.put("on", spec.onFields());
            if (spec.maxDocs() != null) {
                join.put("max_docs_per_index", spec.maxDocs());
            }
            return join;
        }

        private Map<String, Object> buildPerIndexQueries(Map<String, FilterClause> filters) {
            Map<String, Object> queries = new LinkedHashMap<>();
            filters.forEach((index, clause) -> queries.put(index, buildBool(clause)));
            return queries;
        }

        private Map<String, Object> buildBool(FilterClause clause) {
            Map<String, Object> bool = new LinkedHashMap<>();
            if (clause.terms() != null && !clause.terms().isEmpty()) {
                bool.put("must", clause.terms().stream().map(tf ->
                        Map.of("term", Map.of(tf.field(), tf.value()))
                ).toList());
            }
            if (clause.ranges() != null && !clause.ranges().isEmpty()) {
                bool.computeIfAbsent("filter", k -> new ArrayList<>());
                List<Map<String, Object>> filters = (List<Map<String, Object>>) bool.get("filter");
                clause.ranges().forEach(rf -> filters.add(Map.of(
                        "range", Map.of(rf.field(), buildRange(rf))
                )));
            }
            if (clause.exists() != null && !clause.exists().isEmpty()) {
                bool.computeIfAbsent("must", k -> new ArrayList<>());
                List<Map<String, Object>> must = (List<Map<String, Object>>) bool.get("must");
                clause.exists().forEach(ex -> must.add(Map.of(
                        "exists", Map.of("field", ex.field())
                )));
            }
            return Map.of("bool", bool);
        }

        private Map<String, Object> buildRange(RangeFilter rf) {
            Map<String, Object> range = new LinkedHashMap<>();
            if (rf.gte() != null) range.put("gte", rf.gte());
            if (rf.lte() != null) range.put("lte", rf.lte());
            return range;
        }

        private Map<String, Object> buildAgg(AggregationSpec agg) {
            Map<String, Object> aggBody = switch (agg.type()) {
                case "terms" -> Map.of(
                        "terms", Map.of(
                                "field", agg.field(),
                                "size", agg.size() == null ? 10 : agg.size()
                        )
                );
                case "avg" -> Map.of("avg", Map.of("field", agg.field()));
                case "sum" -> Map.of("sum", Map.of("field", agg.field()));
                case "date_histogram" -> Map.of(
                        "date_histogram", Map.of(
                                "field", agg.field(),
                                "calendar_interval", "1d"
                        )
                );
                default -> throw new IllegalArgumentException("Unsupported aggregation: " + agg.type());
            };

            if (agg.subAggregations() == null || agg.subAggregations().isEmpty()) {
                return aggBody;
            }

            Map<String, Object> nested = new LinkedHashMap<>(aggBody);
            Map<String, Object> subAggs = new LinkedHashMap<>();
            agg.subAggregations().forEach(sub -> subAggs.put(sub.name(), buildAgg(sub)));
            nested.put("aggs", subAggs);
            return nested;
        }
    }

## Service and Controller

    package com.example.search.service;

    import com.example.search.dto.JoinQueryRequest;
    import com.example.search.query.SirenMultiJoinBuilder;
    import org.elasticsearch.client.Request;
    import org.elasticsearch.client.Response;
    import org.elasticsearch.client.RestClient;
    import org.springframework.stereotype.Service;

    @Service
    public class MultiJoinService {

        private final SirenMultiJoinBuilder builder;
        private final RestClient client;

        public MultiJoinService(SirenMultiJoinBuilder builder, RestClient client) {
            this.builder = builder;
            this.client = client;
        }

        public String execute(JoinQueryRequest request) {
            String body = builder.build(request);
            Request esRequest = new Request("POST", "/_search");
            esRequest.setJsonEntity(body);

            try {
                Response response = client.performRequest(esRequest);
                return response.getEntity() != null
                        ? new String(response.getEntity().getContent().readAllBytes())
                        : "{}";
            } catch (Exception e) {
                throw new IllegalStateException("SIREn multi-join query failed", e);
            }
        }
    }

    package com.example.search.controller;

    import com.example.search.dto.JoinQueryRequest;
    import com.example.search.service.MultiJoinService;
    import jakarta.validation.Valid;
    import org.springframework.http.ResponseEntity;
    import org.springframework.web.bind.annotation.*;

    @RestController
    @RequestMapping("/api/search")
    public class MultiJoinController {

        private final MultiJoinService service;

        public MultiJoinController(MultiJoinService service) {
            this.service = service;
        }

        @PostMapping("/multi-join")
        public ResponseEntity<String> run(@Valid @RequestBody JoinQueryRequest request) {
            return ResponseEntity.ok(service.execute(request));
        }
    }

