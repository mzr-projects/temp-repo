## Writing to the Outbox in Your Business Transaction

If the same Spring Boot app writes your business data, do this:

```java
package com.example.order.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.Map;
import java.util.UUID;

@Service
public class OrderService {

    private final JdbcTemplate jdbcTemplate;
    private final ObjectMapper objectMapper;

    public OrderService(
        JdbcTemplate jdbcTemplate,
        ObjectMapper objectMapper
    ) {
        this.jdbcTemplate = jdbcTemplate;
        this.objectMapper = objectMapper;
    }

    @Transactional
    public void createOrder(Long customerId, double amount) throws Exception {
        Long orderId = getNextOrderId();

        jdbcTemplate.update(
            """
            INSERT INTO ORDERS (
                ORDER_ID,
                CUSTOMER_ID,
                AMOUNT,
                CREATED_AT
            )
            VALUES (?, ?, ?, CURRENT_TIMESTAMP)
            """,
            orderId,
            customerId,
            amount
        );

        String payload = objectMapper.writeValueAsString(
            Map.of(
                "orderId", orderId,
                "customerId", customerId,
                "amount", amount
            )
        );

        jdbcTemplate.update(
            """
            INSERT INTO OUTBOX_EVENT (
                EVENT_ID,
                AGGREGATE_TYPE,
                AGGREGATE_ID,
                EVENT_TYPE,
                PAYLOAD,
                STATUS
            )
            VALUES (?, ?, ?, ?, ?, 'NEW')
            """,
            UUID.randomUUID().toString(),
            "ORDER",
            orderId.toString(),
            "ORDER_CREATED",
            payload
        );
    }

    private Long getNextOrderId() {
        return jdbcTemplate.queryForObject(
            "SELECT ORDER_SEQ.NEXTVAL FROM DUAL",
            Long.class
        );
    }
}
```

