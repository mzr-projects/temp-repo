## Polling Worker

```java
package com.example.outbox.worker;

import com.example.outbox.model.OutboxEvent;
import com.example.outbox.processor.OutboxEventHandler;
import com.example.outbox.processor.OutboxEventHandlerRegistry;
import com.example.outbox.repository.OutboxRepository;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.util.List;

@Component
public class OutboxWorker {

    private final OutboxRepository repository;
    private final OutboxEventHandlerRegistry handlerRegistry;

    public OutboxWorker(
        OutboxRepository repository,
        OutboxEventHandlerRegistry handlerRegistry
    ) {
        this.repository = repository;
        this.handlerRegistry = handlerRegistry;
    }

    @Scheduled(fixedDelayString = "#{@outboxProperties.pollingIntervalMs}")
    public void processOutbox() {
        List<OutboxEvent> events = repository.claimBatch();

        for (OutboxEvent event : events) {
            try {
                OutboxEventHandler handler = handlerRegistry.getHandler(event.getEventType());

                handler.handle(event);

                repository.markProcessed(event.getId());
            } catch (Exception ex) {
                repository.markFailed(event.getId(), ex.getMessage());
            }
        }
    }
}
```

