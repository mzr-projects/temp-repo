## Repository

This repository does three important things:

* Claims events using row locking
* Marks events as processed
* Marks failed events for retry or final failure

```java
package com.example.outbox.repository;

import com.example.outbox.config.OutboxProperties;
import com.example.outbox.model.OutboxEvent;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

@Repository
public class OutboxRepository {

    private final JdbcTemplate jdbcTemplate;
    private final OutboxProperties properties;

    public OutboxRepository(
        JdbcTemplate jdbcTemplate,
        OutboxProperties properties
    ) {
        this.jdbcTemplate = jdbcTemplate;
        this.properties = properties;
    }

    @Transactional
    public List<OutboxEvent> claimBatch() {
        String workerId = properties.getWorkerId();

        String claimSql = """
            UPDATE OUTBOX_EVENT
            SET STATUS = 'PROCESSING',
                LOCKED_BY = ?,
                LOCKED_AT = CURRENT_TIMESTAMP,
                ATTEMPT_COUNT = ATTEMPT_COUNT + 1
            WHERE ID IN (
                SELECT ID
                FROM (
                    SELECT ID
                    FROM OUTBOX_EVENT
                    WHERE (
                            STATUS = 'NEW'
                            OR (
                                STATUS = 'PROCESSING'
                                AND LOCKED_AT < CURRENT_TIMESTAMP - NUMTODSINTERVAL(?, 'MINUTE')
                            )
                        )
                      AND ATTEMPT_COUNT < MAX_ATTEMPTS
                    ORDER BY CREATED_AT, ID
                )
                WHERE ROWNUM <= ?
            )
            """;

        jdbcTemplate.update(
            claimSql,
            workerId,
            properties.getLockTimeoutMinutes(),
            properties.getBatchSize()
        );

        String selectSql = """
            SELECT *
            FROM OUTBOX_EVENT
            WHERE STATUS = 'PROCESSING'
              AND LOCKED_BY = ?
            ORDER BY CREATED_AT, ID
            """;

        return jdbcTemplate.query(
            selectSql,
            new OutboxEventRowMapper(),
            workerId
        );
    }

    public void markProcessed(Long id) {
        String sql = """
            UPDATE OUTBOX_EVENT
            SET STATUS = 'PROCESSED',
                PROCESSED_AT = CURRENT_TIMESTAMP,
                LOCKED_BY = NULL,
                LOCKED_AT = NULL,
                ERROR_MESSAGE = NULL
            WHERE ID = ?
            """;

        jdbcTemplate.update(sql, id);
    }

    public void markFailed(Long id, String errorMessage) {
        String sql = """
            UPDATE OUTBOX_EVENT
            SET STATUS =
                    CASE
                        WHEN ATTEMPT_COUNT >= MAX_ATTEMPTS THEN 'FAILED'
                        ELSE 'NEW'
                    END,
                LOCKED_BY = NULL,
                LOCKED_AT = NULL,
                ERROR_MESSAGE = ?
            WHERE ID = ?
            """;

        jdbcTemplate.update(sql, truncate(errorMessage), id);
    }

    private String truncate(String value) {
        if (value == null) {
            return null;
        }

        return value.length() > 4000 ? value.substring(0, 4000) : value;
    }
}
```

