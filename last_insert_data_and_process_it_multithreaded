## Composite Watermark State

```java
package com.example.datareader.watermark;

import com.example.datareader.config.TableReaderProperties;

import java.sql.Timestamp;
import java.time.Instant;
import java.util.List;
import java.util.Map;

public class WatermarkState {

    private Object watermarkValue;
    private Object tieBreakerValue;

    public static WatermarkState empty() {
        return new WatermarkState();
    }

    public static WatermarkState fromLastRow(
        TableReaderProperties table,
        List<Map<String, Object>> rows
    ) {
        Map<String, Object> lastRow = rows.get(rows.size() - 1);

        WatermarkState state = new WatermarkState();
        state.watermarkValue = getColumnValue(lastRow, table.getWatermarkColumn());

        if (table.hasTieBreaker()) {
            state.tieBreakerValue = getColumnValue(lastRow, table.getTieBreakerColumn());
        }

        return state;
    }

    public boolean hasWatermark() {
        return watermarkValue != null;
    }

    public Object getWatermarkValue() {
        return watermarkValue;
    }

    public void setWatermarkValue(Object watermarkValue) {
        this.watermarkValue = watermarkValue;
    }

    public Object getTieBreakerValue() {
        return tieBreakerValue;
    }

    public void setTieBreakerValue(Object tieBreakerValue) {
        this.tieBreakerValue = tieBreakerValue;
    }

    public String serializeWatermarkValue() {
        return serialize(watermarkValue);
    }

    public String serializeTieBreakerValue() {
        return serialize(tieBreakerValue);
    }

    private static Object getColumnValue(Map<String, Object> row, String columnName) {
        Object value = row.get(columnName);

        if (value == null) {
            value = row.get(columnName.toUpperCase());
        }

        if (value == null) {
            value = row.get(columnName.toLowerCase());
        }

        return value;
    }

    private static String serialize(Object value) {
        if (value == null) {
            return null;
        }

        if (value instanceof Timestamp timestamp) {
            return timestamp.toInstant().toString();
        }

        return value.toString();
    }
}
