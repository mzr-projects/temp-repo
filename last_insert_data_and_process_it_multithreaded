## Better Split for Retry

```text
TablePollingWorker
    |
    |-- calls BatchPollingService.processOneBatch()
```

### `BatchPollingService.java`

```java
package com.example.datareader.reader;

import com.example.datareader.config.ReaderProperties;
import com.example.datareader.config.TableReaderProperties;
import com.example.datareader.datasource.DataSourceRegistry;
import com.example.datareader.processor.DataProcessor;
import com.example.datareader.processor.DataProcessorRegistry;
import com.example.datareader.watermark.WatermarkRepository;
import com.example.datareader.watermark.WatermarkState;
import org.springframework.dao.TransientDataAccessException;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.retry.annotation.Backoff;
import org.springframework.retry.annotation.Retryable;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.Map;

@Service
public class BatchPollingService {

    private final ReaderProperties readerProperties;
    private final DataSourceRegistry dataSourceRegistry;
    private final WatermarkRepository watermarkRepository;
    private final DataProcessorRegistry processorRegistry;

    public BatchPollingService(
        ReaderProperties readerProperties,
        DataSourceRegistry dataSourceRegistry,
        WatermarkRepository watermarkRepository,
        DataProcessorRegistry processorRegistry
    ) {
        this.readerProperties = readerProperties;
        this.dataSourceRegistry = dataSourceRegistry;
        this.watermarkRepository = watermarkRepository;
        this.processorRegistry = processorRegistry;
    }

    @Retryable(
        retryFor = TransientDataAccessException.class,
        maxAttempts = 3,
        backoff = @Backoff(delay = 1000, multiplier = 2)
    )
    public int processOneBatch(TableReaderProperties table) {
        JdbcTemplate jdbcTemplate = dataSourceRegistry.getJdbcTemplate(table.getDatabase());

        WatermarkState watermarkState = watermarkRepository.getWatermark(table)
            .orElseGet(WatermarkState::empty);

        String sql = QueryBuilder.buildQuery(table, watermarkState.hasWatermark());

        List<Map<String, Object>> rows = fetchRows(
            jdbcTemplate,
            table,
            watermarkState,
            sql
        );

        if (rows.isEmpty()) {
            return 0;
        }

        DataProcessor processor = processorRegistry.getProcessor(table.getProcessor());

        processor.process(table, rows);

        WatermarkState newWatermark = WatermarkState.fromLastRow(table, rows);

        watermarkRepository.updateWatermark(table, newWatermark);

        return rows.size();
    }

    private List<Map<String, Object>> fetchRows(
        JdbcTemplate jdbcTemplate,
        TableReaderProperties table,
        WatermarkState watermarkState,
        String sql
    ) {
        if (watermarkState.hasWatermark() && table.hasTieBreaker()) {
            return jdbcTemplate.queryForList(
                sql,
                watermarkState.getWatermarkValue(),
                watermarkState.getWatermarkValue(),
                watermarkState.getTieBreakerValue(),
                readerProperties.getBatchSize()
            );
        }

        if (watermarkState.hasWatermark()) {
            return jdbcTemplate.queryForList(
                sql,
                watermarkState.getWatermarkValue(),
                readerProperties.getBatchSize()
            );
        }

        return jdbcTemplate.queryForList(
            sql,
            readerProperties.getBatchSize()
        );
    }
}
```

### Updated `TablePollingWorker.java`

```java
package com.example.datareader.reader;

import com.example.datareader.config.ReaderProperties;
import com.example.datareader.config.TableReaderProperties;
import org.springframework.stereotype.Service;

@Service
public class TablePollingWorker {

    private final ReaderProperties readerProperties;
    private final DatabaseConcurrencyLimiter databaseConcurrencyLimiter;
    private final BatchPollingService batchPollingService;

    public TablePollingWorker(
        ReaderProperties readerProperties,
        DatabaseConcurrencyLimiter databaseConcurrencyLimiter,
        BatchPollingService batchPollingService
    ) {
        this.readerProperties = readerProperties;
        this.databaseConcurrencyLimiter = databaseConcurrencyLimiter;
        this.batchPollingService = batchPollingService;
    }

    public void run(TableReaderProperties table) {
        if (!databaseConcurrencyLimiter.tryAcquire(table.getDatabase())) {
            return;
        }

        try {
            for (int i = 0; i < readerProperties.getMaxBatchesPerRun(); i++) {
                int count = batchPollingService.processOneBatch(table);

                if (count == 0) {
                    break;
                }
            }
        } finally {
            databaseConcurrencyLimiter.release(table.getDatabase());
        }
    }
}
```

