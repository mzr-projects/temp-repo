          AND WATERMARK_COLUMN = ?
        """;

    int updated = jdbcTemplate.update(
        updateSql,
        table.getWatermarkType().name(),
        watermarkState.serializeWatermarkValue(),
        table.getTieBreakerColumn(),
        table.getTieBreakerType() == null ? null : table.getTieBreakerType().name(),
        watermarkState.serializeTieBreakerValue(),
        table.getDatabase(),
