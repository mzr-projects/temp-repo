package com.example.datareader.watermark;

import com.example.datareader.config.TableReaderProperties;

import java.sql.Timestamp;
import java.time.Instant;

public class WatermarkParser {

    public static Object parse(String value, TableReaderProperties.WatermarkType type) {
        if (value == null) {
            return null;
        }

        return switch (type) {
            case NUMBER -> Long.parseLong(value);
            case TIMESTAMP -> Timestamp.from(Instant.parse(value));
        };
    }
}
```

Your `JdbcWatermarkRepository.getWatermark()` should use this.

```java
@Override
public Optional<WatermarkState> getWatermark(TableReaderProperties table) {
    JdbcTemplate jdbcTemplate = dataSourceRegistry.getJdbcTemplate(table.getDatabase());

    String sql = """
        SELECT WATERMARK_VALUE,
               TIE_BREAKER_VALUE
        FROM DATA_READER_WATERMARK
        WHERE DATABASE_NAME = ?
          AND TABLE_NAME = ?
          AND WATERMARK_COLUMN = ?
        """;

    return jdbcTemplate.query(sql, rs -> {
        if (!rs.next()) {
            return Optional.empty();
        }

        WatermarkState state = new WatermarkState();

        state.setWatermarkValue(
            WatermarkParser.parse(
                rs.getString("WATERMARK_VALUE"),
                table.getWatermarkType()
            )
        );

        if (table.hasTieBreaker()) {
            state.setTieBreakerValue(
                WatermarkParser.parse(
                    rs.getString("TIE_BREAKER_VALUE"),
                    table.getTieBreakerType()
                )
            );
        }

        return Optional.of(state);
    }, table.getDatabase(), table.getQualifiedTableName(), table.getWatermarkColumn());
}
