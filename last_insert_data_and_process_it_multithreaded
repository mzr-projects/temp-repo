## Multithreaded Scheduler

This scheduler submits table polling jobs to the executor.

```java
package com.example.datareader.reader;

import com.example.datareader.config.ReaderProperties;
import com.example.datareader.config.TableReaderProperties;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.util.concurrent.Executor;

@Component
public class TablePollingScheduler {

    private final ReaderProperties readerProperties;
    private final TablePollingWorker tablePollingWorker;
    private final LocalTableLockManager localTableLockManager;
    private final Executor readerExecutor;

    public TablePollingScheduler(
        ReaderProperties readerProperties,
        TablePollingWorker tablePollingWorker,
        LocalTableLockManager localTableLockManager,
        @Qualifier("readerExecutor") Executor readerExecutor
    ) {
        this.readerProperties = readerProperties;
        this.tablePollingWorker = tablePollingWorker;
        this.localTableLockManager = localTableLockManager;
        this.readerExecutor = readerExecutor;
    }

    @Scheduled(fixedDelayString = "#{@readerProperties.schedulerIntervalMs}")
    public void schedule() {
        for (TableReaderProperties table : readerProperties.getTables()) {
            if (!table.isEnabled()) {
                continue;
            }

            if (!localTableLockManager.tryLock(table)) {
                continue;
            }

            readerExecutor.execute(() -> {
                try {
                    tablePollingWorker.run(table);
                } catch (Exception ex) {
                    System.err.println(
                        "Table job failed. table=" + table.getJobKey()
                            + ", error=" + ex.getMessage()
                    );
                    ex.printStackTrace();
                } finally {
                    localTableLockManager.unlock(table);
                }
            });
        }
    }
}
```

