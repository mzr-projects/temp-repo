## Safer Query Builder

This supports both simple and composite watermarks.

```java
package com.example.datareader.reader;

import com.example.datareader.config.TableReaderProperties;

public class QueryBuilder {

    public static String buildQuery(TableReaderProperties table, boolean hasWatermark) {
        String qualifiedTableName = table.getQualifiedTableName();
        String watermarkColumn = table.getWatermarkColumn();

        if (!table.hasTieBreaker()) {
            if (hasWatermark) {
                return """
                    SELECT *
                    FROM %s
                    WHERE %s > ?
                    ORDER BY %s
                    FETCH FIRST ? ROWS ONLY
                    """.formatted(
                        qualifiedTableName,
                        watermarkColumn,
                        watermarkColumn
                    );
            }

            return """
                SELECT *
                FROM %s
                ORDER BY %s
                FETCH FIRST ? ROWS ONLY
                """.formatted(
                    qualifiedTableName,
                    watermarkColumn
                );
        }

        String tieBreakerColumn = table.getTieBreakerColumn();

        if (hasWatermark) {
            return """
                SELECT *
                FROM %s
                WHERE %s > ?
                   OR (
                        %s = ?
                        AND %s > ?
                   )
                ORDER BY %s, %s
                FETCH FIRST ? ROWS ONLY
                """.formatted(
                    qualifiedTableName,
                    watermarkColumn,
                    watermarkColumn,
                    tieBreakerColumn,
                    watermarkColumn,
                    tieBreakerColumn
                );
        }

        return """
            SELECT *
            FROM %s
            ORDER BY %s, %s
            FETCH FIRST ? ROWS ONLY
            """.formatted(
                qualifiedTableName,
                watermarkColumn,
                tieBreakerColumn
            );
    }
}
