## Per-Database Concurrency Limiter

Even if your global thread pool has 12 threads, you may not want 12 queries hitting the same Oracle DB.

Use a `Semaphore` per database.

```java
package com.example.datareader.reader;

import com.example.datareader.config.ReaderProperties;
import org.springframework.stereotype.Component;

import java.util.HashMap;
import java.util.Map;
import java.util.concurrent.Semaphore;

@Component
public class DatabaseConcurrencyLimiter {

    private final Map<String, Semaphore> semaphores = new HashMap<>();

    public DatabaseConcurrencyLimiter(ReaderProperties properties) {
        properties.getDatabases().forEach((databaseName, dbProps) ->
            semaphores.put(
                databaseName,
                new Semaphore(dbProps.getMaxConcurrentTableJobs())
            )
        );
    }

    public boolean tryAcquire(String databaseName) {
        Semaphore semaphore = semaphores.get(databaseName);

        if (semaphore == null) {
            throw new IllegalArgumentException("Unknown database: " + databaseName);
        }

        return semaphore.tryAcquire();
    }

    public void release(String databaseName) {
        Semaphore semaphore = semaphores.get(databaseName);

        if (semaphore != null) {
            semaphore.release();
        }
    }
}
```

