```bash
curl -X POST http://localhost:8080/api/sources/{id}/query \
  -H "Content-Type: application/json" \
  -d '{
    "namespace":"public",
    "entity":"employees",
    "select":["id","name","department"],
    "filters":[
      {"field":"department","op":"EQ","value":"IT"},
      {"field":"name","op":"CONTAINS","value":"john"}
    ],
    "sort":[{"field":"id","dir":"DESC"}],
    "limit":50,
    "offset":0
  }'
