### `src/main/java/com/acme/datagateway/connector/sql/SqlQueryTranslator.java`

```java
package com.acme.datagateway.connector.sql;

import com.acme.datagateway.dto.metadata.FieldMeta;
import com.acme.datagateway.dto.query.FilterCriterion;
import com.acme.datagateway.dto.query.Operator;
import com.acme.datagateway.dto.query.SortCriterion;
import com.acme.datagateway.dto.query.UnifiedQueryRequest;
import com.acme.datagateway.model.SourceType;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.Collection;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Component
public class SqlQueryTranslator {

    public SqlPlan build(SourceType sourceType, UnifiedQueryRequest req, List<FieldMeta> availableFields) {
        SqlIdentifierValidator.validate(req.getEntity());
        if (req.getNamespace() != null && !req.getNamespace().isBlank()) {
            SqlIdentifierValidator.validate(req.getNamespace());
        }

        Map<String, String> canonicalFields = new HashMap<>();
        for (FieldMeta f : availableFields) {
            canonicalFields.put(f.getName().toLowerCase(), f.getName());
        }

        List<String> selected = new ArrayList<>();
        if (req.getSelect() == null || req.getSelect().isEmpty()) {
            for (FieldMeta f : availableFields) {
                selected.add(f.getName());
            }
        } else {
            for (String s : req.getSelect()) {
                String actual = canonicalFields.get(s.toLowerCase());
                if (actual == null) {
                    throw new IllegalArgumentException("Unknown select field: " + s);
                }
                selected.add(actual);
            }
        }

        List<Object> params = new ArrayList<>();

        String tableName = qualify(sourceType, req.getNamespace(), req.getEntity());
        StringBuilder sql = new StringBuilder("SELECT ");
        sql.append(selected.stream().map(col -> quote(sourceType, col)).reduce((a, b) -> a + ", " + b).orElse("*"));
        sql.append(" FROM ").append(tableName);

        List<String> whereClauses = new ArrayList<>();
        if (req.getFilters() != null) {
            for (FilterCriterion f : req.getFilters()) {
                String actualField = canonicalFields.get(f.getField().toLowerCase());
                if (actualField == null) {
                    throw new IllegalArgumentException("Unknown filter field: " + f.getField());
                }
                String col = quote(sourceType, actualField);
                Operator op = f.getOp();

                switch (op) {
                    case EQ -> {
                        whereClauses.add(col + " = ?");
                        params.add(f.getValue());
                    }
                    case NE -> {
                        whereClauses.add(col + " <> ?");
                        params.add(f.getValue());
                    }
                    case GT -> {
                        whereClauses.add(col + " > ?");
                        params.add(f.getValue());
                    }
                    case GTE -> {
                        whereClauses.add(col + " >= ?");
                        params.add(f.getValue());
                    }
                    case LT -> {
                        whereClauses.add(col + " < ?");
                        params.add(f.getValue());
                    }
                    case LTE -> {
                        whereClauses.add(col + " <= ?");
                        params.add(f.getValue());
                    }
                    case IS_NULL -> whereClauses.add(col + " IS NULL");
                    case NOT_NULL -> whereClauses.add(col + " IS NOT NULL");
                    case CONTAINS -> {
                        whereClauses.add("LOWER(" + col + ") LIKE ?");
                        params.add("%" + toLower(f.getValue()) + "%");
                    }
                    case STARTS_WITH -> {
                        whereClauses.add("LOWER(" + col + ") LIKE ?");
                        params.add(toLower(f.getValue()) + "%");
                    }
                    case ENDS_WITH -> {
                        whereClauses.add("LOWER(" + col + ") LIKE ?");
                        params.add("%" + toLower(f.getValue()));
                    }
                    case IN -> {
                        if (!(f.getValue() instanceof Collection<?> values) || values.isEmpty()) {
                            throw new IllegalArgumentException("IN requires non-empty array");
                        }
                        String placeholders = values.stream().map(v -> "?").reduce((a, b) -> a + "," + b).orElse("?");
                        whereClauses.add(col + " IN (" + placeholders + ")");
                        params.addAll(values);
                    }
                    case BETWEEN -> {
                        if (!(f.getValue() instanceof List<?> vals) || vals.size() != 2) {
                            throw new IllegalArgumentException("BETWEEN requires [from, to]");
                        }
                        whereClauses.add(col + " BETWEEN ? AND ?");
                        params.add(vals.get(0));
                        params.add(vals.get(1));
                    }
                }
            }
        }

        if (!whereClauses.isEmpty()) {
            sql.append(" WHERE ").append(String.join(" AND ", whereClauses));
        }

        boolean hasSort = req.getSort() != null && !req.getSort().isEmpty();
        if (hasSort) {
            List<String> sorts = new ArrayList<>();
            for (SortCriterion s : req.getSort()) {
                String actual = canonicalFields.get(s.getField().toLowerCase());
                if (actual == null) {
                    throw new IllegalArgumentException("Unknown sort field: " + s.getField());
                }
                String dir = "DESC".equalsIgnoreCase(s.getDir()) ? "DESC" : "ASC";
                sorts.add(quote(sourceType, actual) + " " + dir);
            }
            sql.append(" ORDER BY ").append(String.join(", ", sorts));
        }

        int limit = req.getLimit();
        int offset = req.getOffset();

        switch (sourceType) {
            case POSTGRESQL -> sql.append(" LIMIT ").append(limit).append(" OFFSET ").append(offset);
            case ORACLE -> sql.append(" OFFSET ").append(offset).append(" ROWS FETCH NEXT ").append(limit).append(" ROWS ONLY");
            case SQLSERVER -> {
                if (!hasSort) {
                    sql.append(" ORDER BY (SELECT NULL)");
                }
                sql.append(" OFFSET ").append(offset).append(" ROWS FETCH NEXT ").append(limit).append(" ROWS ONLY");
            }
            default -> throw new IllegalArgumentException("Not a SQL source type: " + sourceType);
        }

        return new SqlPlan(sql.toString(), params);
    }

    private static String qualify(SourceType type, String namespace, String entity) {
        if (namespace == null || namespace.isBlank()) {
            return quote(type, entity);
        }
        return quote(type, namespace) + "." + quote(type, entity);
    }

    private static String quote(SourceType type, String identifier) {
        SqlIdentifierValidator.validate(identifier);
        return switch (type) {
            case POSTGRESQL, ORACLE -> "\"" + identifier + "\"";
            case SQLSERVER -> "[" + identifier + "]";
            default -> throw new IllegalArgumentException("Unsupported SQL type: " + type);
        };
    }

    private static String toLower(Object value) {
        return value == null ? "" : String.valueOf(value).toLowerCase();
    }
}
