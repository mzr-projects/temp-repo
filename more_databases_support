import org.springframework.stereotype.Component;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.ResultSetMetaData;
import java.util.*;

@Component
public class SqlConnector implements DataSourceConnector {

    private final CryptoService cryptoService;
    private final SqlQueryTranslator translator;

    public SqlConnector(CryptoService cryptoService, SqlQueryTranslator translator) {
        this.cryptoService = cryptoService;
        this.translator = translator;
    }

    @Override
    public boolean supports(SourceType sourceType) {
        return sourceType.isSql();
    }

    @Override
    public boolean testConnection(SourceConfigDoc cfg) {
        try (Connection conn = open(cfg)) {
            return conn.isValid(5);
        } catch (Exception e) {
            throw new RuntimeException("SQL connection test failed: " + e.getMessage(), e);
        }
    }

    @Override
    public List<String> listNamespaces(SourceConfigDoc cfg) {
        try (Connection conn = open(cfg);
             ResultSet rs = conn.getMetaData().getSchemas()) {
            List<String> out = new ArrayList<>();
            while (rs.next()) {
                out.add(rs.getString("TABLE_SCHEM"));
            }
            return out;
        } catch (Exception e) {
            throw new RuntimeException("Failed to list SQL schemas", e);
        }
    }

    @Override
    public List<EntityMeta> listEntities(SourceConfigDoc cfg, String namespace) {
        String schema = normalizeSchema(cfg.getSourceType(), chooseNamespace(cfg, namespace));
        try (Connection conn = open(cfg);
             ResultSet rs = conn.getMetaData().getTables(conn.getCatalog(), schema, "%", new String[]{"TABLE", "VIEW"})) {
            List<EntityMeta> out = new ArrayList<>();
            while (rs.next()) {
                out.add(EntityMeta.builder()
                        .namespace(rs.getString("TABLE_SCHEM"))
                        .name(rs.getString("TABLE_NAME"))
                        .type(rs.getString("TABLE_TYPE"))
                        .build());
            }
            return out;
        } catch (Exception e) {
            throw new RuntimeException("Failed to list SQL entities", e);
        }
    }

    @Override
    public List<FieldMeta> listFields(SourceConfigDoc cfg, String namespace, String entity) {
        SqlIdentifierValidator.validate(entity);
        String schema = normalizeSchema(cfg.getSourceType(), chooseNamespace(cfg, namespace));

        try (Connection conn = open(cfg);
             ResultSet rs = conn.getMetaData().getColumns(conn.getCatalog(), schema, entity, "%")) {
            List<FieldMeta> out = new ArrayList<>();
            while (rs.next()) {
                out.add(FieldMeta.builder()
                        .name(rs.getString("COLUMN_NAME"))
                        .dataType(rs.getString("TYPE_NAME"))
                        .nullable("YES".equalsIgnoreCase(rs.getString("IS_NULLABLE")))
                        .indexed(false)
                        .build());
            }
            return out;
        } catch (Exception e) {
            throw new RuntimeException("Failed to list SQL fields", e);
        }
    }

    @Override
    public QueryResult executeQuery(SourceConfigDoc cfg, UnifiedQueryRequest request) {
        long start = System.currentTimeMillis();

        List<FieldMeta> fields = listFields(cfg, request.getNamespace(), request.getEntity());
        SqlPlan plan = translator.build(cfg.getSourceType(), request, fields);

        List<Map<String, Object>> rows = new ArrayList<>();

        try (Connection conn = open(cfg);
             var ps = conn.prepareStatement(plan.sql())) {

            for (int i = 0; i < plan.params().size(); i++) {
                ps.setObject(i + 1, plan.params().get(i));
            }
            ps.setQueryTimeout(30);

            try (var rs = ps.executeQuery()) {
                ResultSetMetaData md = rs.getMetaData();
                int count = md.getColumnCount();
                while (rs.next()) {
                    Map<String, Object> row = new LinkedHashMap<>();
                    for (int i = 1; i <= count; i++) {
                        row.put(md.getColumnLabel(i), rs.getObject(i));
                    }
                    rows.add(row);
                }
            }
        } catch (Exception e) {
            throw new RuntimeException("SQL query failed: " + e.getMessage(), e);
        }

        long took = System.currentTimeMillis() - start;
        return QueryResult.builder()
                .engine(cfg.getSourceType().name())
                .executedQuery(plan.sql())
                .rowCount(rows.size())
                .tookMs(took)
                .rows(rows)
                .build();
    }

    @Override
    public Set<Capability> capabilities() {
        return Set.of(
                Capability.FILTER,
                Capability.SORT,
                Capability.PAGINATION,
                Capability.PROJECTION,
                Capability.FULL_TEXT
        );
    }

    private Connection open(SourceConfigDoc cfg) throws Exception {
        String password = cryptoService.decrypt(cfg.getPasswordCipherText());
        String username = cfg.getUsername();
        String endpoint = cfg.getEndpoint();

        if (username != null && !username.isBlank()) {
            return DriverManager.getConnection(endpoint, username, password);
        }
        return DriverManager.getConnection(endpoint);
    }

    private static String chooseNamespace(SourceConfigDoc cfg, String namespace) {
        if (namespace != null && !namespace.isBlank()) {
            return namespace;
        }
        return cfg.getDatabaseName();
    }

    private static String normalizeSchema(SourceType type, String schema) {
        if (schema == null) {
            return null;
        }
        if (type == SourceType.ORACLE) {
            return schema.toUpperCase();
        }
        return schema;
    }
