package com.acme.datagateway.connector.elastic;

import com.acme.datagateway.dto.query.FilterCriterion;
import com.acme.datagateway.dto.query.Operator;
import com.acme.datagateway.dto.query.SortCriterion;
import com.acme.datagateway.dto.query.UnifiedQueryRequest;
import org.springframework.stereotype.Component;

import java.util.*;

@Component
public class ElasticQueryTranslator {

    public Map<String, Object> buildSearchBody(UnifiedQueryRequest req) {
        Map<String, Object> body = new LinkedHashMap<>();
        body.put("from", req.getOffset());
        body.put("size", req.getLimit());

        if (req.getSelect() != null && !req.getSelect().isEmpty()) {
            body.put("_source", req.getSelect());
        }

        List<Map<String, Object>> must = new ArrayList<>();
        List<Map<String, Object>> filter = new ArrayList<>();
        List<Map<String, Object>> mustNot = new ArrayList<>();

        if (req.getFilters() != null) {
            for (FilterCriterion f : req.getFilters()) {
                String field = f.getField();
                Operator op = f.getOp();
                Object value = f.getValue();

                switch (op) {
                    case EQ -> filter.add(Map.of("term", Map.of(field, Map.of("value", value))));
                    case NE -> mustNot.add(Map.of("term", Map.of(field, Map.of("value", value))));
                    case GT -> filter.add(Map.of("range", Map.of(field, Map.of("gt", value))));
                    case GTE -> filter.add(Map.of("range", Map.of(field, Map.of("gte", value))));
                    case LT -> filter.add(Map.of("range", Map.of(field, Map.of("lt", value))));
                    case LTE -> filter.add(Map.of("range", Map.of(field, Map.of("lte", value))));
                    case IN -> {
                        if (!(value instanceof Collection<?> values) || values.isEmpty()) {
                            throw new IllegalArgumentException("IN requires non-empty array");
                        }
                        filter.add(Map.of("terms", Map.of(field, values)));
                    }
                    case BETWEEN -> {
                        if (!(value instanceof List<?> vals) || vals.size() != 2) {
                            throw new IllegalArgumentException("BETWEEN requires [from, to]");
                        }
                        filter.add(Map.of("range", Map.of(field, Map.of("gte", vals.get(0), "lte", vals.get(1)))));
                    }
                    case CONTAINS -> must.add(Map.of("match", Map.of(field, String.valueOf(value))));
                    case STARTS_WITH -> filter.add(Map.of("prefix", Map.of(field, String.valueOf(value))));
                    case ENDS_WITH -> filter.add(Map.of("wildcard", Map.of(field, "*" + String.valueOf(value))));
                    case IS_NULL -> mustNot.add(Map.of("exists", Map.of("field", field)));
                    case NOT_NULL -> filter.add(Map.of("exists", Map.of("field", field)));
                }
            }
        }

        if (req.getText() != null && !req.getText().isBlank()) {
            must.add(Map.of("simple_query_string", Map.of("query", req.getText())));
        }

        Map<String, Object> bool = new LinkedHashMap<>();
        if (!must.isEmpty()) {
            bool.put("must", must);
        }
        if (!filter.isEmpty()) {
            bool.put("filter", filter);
        }
        if (!mustNot.isEmpty()) {
            bool.put("must_not", mustNot);
        }

        if (bool.isEmpty()) {
            body.put("query", Map.of("match_all", Map.of()));
        } else {
            body.put("query", Map.of("bool", bool));
        }

        if (req.getSort() != null && !req.getSort().isEmpty()) {
            List<Map<String, Object>> sort = new ArrayList<>();
            for (SortCriterion s : req.getSort()) {
                String dir = "DESC".equalsIgnoreCase(s.getDir()) ? "desc" : "asc";
                sort.add(Map.of(s.getField(), Map.of("order", dir)));
            }
            body.put("sort", sort);
        }

        return body;
    }
}
