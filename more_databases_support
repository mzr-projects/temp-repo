        return List.of("default");
    }

    @Override
    public List<EntityMeta> listEntities(SourceConfigDoc cfg, String namespace) {
        try (RestClient client = clientFactory.create(cfg)) {
            Request req = new Request("GET", "/_cat/indices?format=json&h=index");
            Response res = client.performRequest(req);

            List<Map<String, Object>> items = readJsonAsList(res.getEntity().getContent());
            List<EntityMeta> out = new ArrayList<>();
            for (Map<String, Object> item : items) {
                String index = String.valueOf(item.get("index"));
                out.add(EntityMeta.builder()
                        .namespace("default")
                        .name(index)
                        .type("INDEX")
                        .build());
            }
            return out;
        } catch (Exception e) {
            throw new RuntimeException("Failed to list Elasticsearch indices", e);
        }
    }

    @Override
    public List<FieldMeta> listFields(SourceConfigDoc cfg, String namespace, String entity) {
        try (RestClient client = clientFactory.create(cfg)) {
            Request req = new Request("GET", "/" + entity + "/_mapping");
            Response res = client.performRequest(req);

            Map<String, Object> root = readJsonAsMap(res.getEntity().getContent());
            Object idxObj = root.get(entity);
            if (!(idxObj instanceof Map<?, ?> idxMap)) {
                return List.of();
            }

            Object mappingsObj = idxMap.get("mappings");
            if (!(mappingsObj instanceof Map<?, ?> mappingsMap)) {
                return List.of();
            }

            Object propsObj = mappingsMap.get("properties");
            if (!(propsObj instanceof Map<?, ?> props)) {
                return List.of();
            }

            List<FieldMeta> out = new ArrayList<>();
            collectFields("", castMap(props), out);
            return out;
        } catch (Exception e) {
            throw new RuntimeException("Failed to read Elasticsearch mapping fields", e);
        }
    }

    @Override
    public QueryResult executeQuery(SourceConfigDoc cfg, UnifiedQueryRequest request) {
        long start = System.currentTimeMillis();

        try (RestClient client = clientFactory.create(cfg)) {
            Map<String, Object> body = queryTranslator.buildSearchBody(request);
            String json = objectMapper.writeValueAsString(body);

            Request req = new Request("POST", "/" + request.getEntity() + "/_search");
            req.setJsonEntity(json);

            Response res = client.performRequest(req);
            Map<String, Object> response = readJsonAsMap(res.getEntity().getContent());

            List<Map<String, Object>> rows = new ArrayList<>();
            long took = 0L;

            Object tookObj = response.get("took");
            if (tookObj instanceof Number n) {
                took = n.longValue();
            }

            Object hitsObj = response.get("hits");
            if (hitsObj instanceof Map<?, ?> hitsMap) {
                Object hitItems = hitsMap.get("hits");
                if (hitItems instanceof List<?> list) {
                    for (Object one : list) {
                        if (one instanceof Map<?, ?> hit) {
                            Object src = hit.get("_source");
                            if (src instanceof Map<?, ?> m) {
                                rows.add(new LinkedHashMap<>(castMap(m)));
                            } else {
                                rows.add(new LinkedHashMap<>(castMap(hit)));
                            }
                        }
                    }
                }
            }

            long fallbackTook = System.currentTimeMillis() - start;
            return QueryResult.builder()
                    .engine("ELASTICSEARCH")
                    .executedQuery("POST /" + request.getEntity() + "/_search")
                    .rowCount(rows.size())
                    .tookMs(took > 0 ? took : fallbackTook)
                    .rows(rows)
                    .build();
        } catch (Exception e) {
            throw new RuntimeException("Elasticsearch query failed: " + e.getMessage(), e);
        }
    }

    @Override
    public Set<Capability> capabilities() {
        return Set.of(
                Capability.FILTER,
                Capability.SORT,
                Capability.PAGINATION,
                Capability.PROJECTION,
                Capability.FULL_TEXT
        );
    }

    private void collectFields(String prefix, Map<String, Object> props, List<FieldMeta> out) {
        for (Map.Entry<String, Object> e : props.entrySet()) {
            String field = prefix.isBlank() ? e.getKey() : prefix + "." + e.getKey();

            if (!(e.getValue() instanceof Map<?, ?> defRaw)) {
                continue;
            }
            Map<String, Object> def = castMap(defRaw);

            String type = def.get("type") == null ? "object" : String.valueOf(def.get("type"));
            out.add(FieldMeta.builder()
                    .name(field)
                    .dataType(type)
                    .nullable(true)
                    .indexed(true)
                    .build());

            Object nestedProps = def.get("properties");
            if (nestedProps instanceof Map<?, ?> nestedMap) {
                collectFields(field, castMap(nestedMap), out);
            }
        }
    }

    private Map<String, Object> readJsonAsMap(InputStream in) throws Exception {
        return objectMapper.readValue(in, new TypeReference<Map<String, Object>>() {
        });
    }

    private List<Map<String, Object>> readJsonAsList(InputStream in) throws Exception {
        return objectMapper.readValue(in, new TypeReference<List<Map<String, Object>>>() {
        });
    }

    @SuppressWarnings("unchecked")
    private static Map<String, Object> castMap(Object o) {
        return (Map<String, Object>) o;
    }
}
