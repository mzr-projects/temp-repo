package com.acme.datagateway.connector.mongo;

import com.acme.datagateway.dto.query.FilterCriterion;
import com.acme.datagateway.dto.query.Operator;
import com.acme.datagateway.dto.query.SortCriterion;
import com.acme.datagateway.dto.query.UnifiedQueryRequest;
import com.mongodb.client.model.Filters;
import com.mongodb.client.model.Projections;
import com.mongodb.client.model.Sorts;
import org.bson.conversions.Bson;

import java.util.ArrayList;
import java.util.Collection;
import java.util.List;
import java.util.regex.Pattern;

public final class MongoQueryTranslator {

    private MongoQueryTranslator() {
    }

    public static Bson toFilter(UnifiedQueryRequest req) {
        List<Bson> clauses = new ArrayList<>();

        if (req.getFilters() != null) {
            for (FilterCriterion f : req.getFilters()) {
                String field = f.getField();
                Operator op = f.getOp();

                switch (op) {
                    case EQ -> clauses.add(Filters.eq(field, f.getValue()));
                    case NE -> clauses.add(Filters.ne(field, f.getValue()));
                    case GT -> clauses.add(Filters.gt(field, f.getValue()));
                    case GTE -> clauses.add(Filters.gte(field, f.getValue()));
                    case LT -> clauses.add(Filters.lt(field, f.getValue()));
                    case LTE -> clauses.add(Filters.lte(field, f.getValue()));
                    case IS_NULL -> clauses.add(Filters.eq(field, null));
                    case NOT_NULL -> clauses.add(Filters.ne(field, null));
                    case IN -> {
                        if (!(f.getValue() instanceof Collection<?> values) || values.isEmpty()) {
                            throw new IllegalArgumentException("IN requires non-empty array");
                        }
                        clauses.add(Filters.in(field, values));
                    }
                    case BETWEEN -> {
                        if (!(f.getValue() instanceof List<?> vals) || vals.size() != 2) {
                            throw new IllegalArgumentException("BETWEEN requires [from, to]");
                        }
                        clauses.add(Filters.and(
                                Filters.gte(field, vals.get(0)),
                                Filters.lte(field, vals.get(1))
                        ));
                    }
                    case CONTAINS -> {
                        String v = String.valueOf(f.getValue());
                        clauses.add(Filters.regex(field, Pattern.compile(Pattern.quote(v), Pattern.CASE_INSENSITIVE)));
                    }
                    case STARTS_WITH -> {
                        String v = String.valueOf(f.getValue());
                        clauses.add(Filters.regex(field, Pattern.compile("^" + Pattern.quote(v), Pattern.CASE_INSENSITIVE)));
                    }
                    case ENDS_WITH -> {
                        String v = String.valueOf(f.getValue());
                        clauses.add(Filters.regex(field, Pattern.compile(Pattern.quote(v) + "$", Pattern.CASE_INSENSITIVE)));
                    }
                }
            }
        }

        if (req.getText() != null && !req.getText().isBlank()) {
            clauses.add(Filters.text(req.getText()));
        }

        if (clauses.isEmpty()) {
            return Filters.empty();
        }
        return Filters.and(clauses);
    }

    public static Bson toProjection(List<String> select) {
        if (select == null || select.isEmpty()) {
            return null;
        }
        if (select.contains("_id")) {
            return Projections.include(select);
        }
        List<String> includes = new ArrayList<>(select);
        return Projections.fields(Projections.include(includes), Projections.excludeId());
    }

    public static Bson toSort(List<SortCriterion> sort) {
        if (sort == null || sort.isEmpty()) {
            return null;
        }
        List<Bson> parts = new ArrayList<>();
        for (SortCriterion s : sort) {
            boolean desc = "DESC".equalsIgnoreCase(s.getDir());
            parts.add(desc ? Sorts.descending(s.getField()) : Sorts.ascending(s.getField()));
        }
        return Sorts.orderBy(parts);
    }
}
