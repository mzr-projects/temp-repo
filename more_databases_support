```java
package com.acme.datagateway.service;

import com.acme.datagateway.connector.ConnectorRegistry;
import com.acme.datagateway.crypto.CryptoService;
import com.acme.datagateway.dto.source.SourceCreateRequest;
import com.acme.datagateway.dto.source.SourceResponse;
import com.acme.datagateway.dto.source.SourceUpdateRequest;
import com.acme.datagateway.exception.NotFoundException;
import com.acme.datagateway.model.SourceConfigDoc;
import com.acme.datagateway.repository.SourceConfigRepository;
import org.springframework.stereotype.Service;

import java.time.Instant;
import java.util.List;
import java.util.stream.StreamSupport;

@Service
public class SourceService {
    private final SourceConfigRepository repository;
    private final CryptoService cryptoService;
    private final ConnectorRegistry connectorRegistry;

    public SourceService(SourceConfigRepository repository, CryptoService cryptoService, ConnectorRegistry connectorRegistry) {
        this.repository = repository;
        this.cryptoService = cryptoService;
        this.connectorRegistry = connectorRegistry;
    }

    public SourceResponse create(SourceCreateRequest req) {
        SourceConfigDoc doc = new SourceConfigDoc();
        doc.setName(req.getName());
        doc.setSourceType(req.getSourceType());
        doc.setEndpoint(req.getEndpoint());
        doc.setDatabaseName(req.getDatabaseName());
        doc.setUsername(req.getUsername());
        doc.setPasswordCipherText(cryptoService.encrypt(req.getPassword()));
        doc.setApiKeyCipherText(cryptoService.encrypt(req.getApiKey()));
        doc.setOptions(req.getOptions());
        doc.setActive(req.getActive() == null || req.getActive());
        doc.setCreatedAt(Instant.now());
        doc.setUpdatedAt(Instant.now());

        SourceConfigDoc saved = repository.save(doc);
        return toResponse(saved);
    }

    public SourceResponse update(String id, SourceUpdateRequest req) {
        SourceConfigDoc doc = getDocOrThrow(id);

        doc.setName(req.getName());
        doc.setEndpoint(req.getEndpoint());
        doc.setDatabaseName(req.getDatabaseName());
        doc.setUsername(req.getUsername());
        doc.setOptions(req.getOptions());
        doc.setActive(req.getActive() == null || req.getActive());

        if (req.getPassword() != null && !req.getPassword().isBlank()) {
            doc.setPasswordCipherText(cryptoService.encrypt(req.getPassword()));
        }
        if (req.getApiKey() != null && !req.getApiKey().isBlank()) {
            doc.setApiKeyCipherText(cryptoService.encrypt(req.getApiKey()));
        }

        doc.setUpdatedAt(Instant.now());
        SourceConfigDoc saved = repository.save(doc);
        return toResponse(saved);
    }

    public List<SourceResponse> list() {
        return StreamSupport.stream(repository.findAll().spliterator(), false)
                .map(this::toResponse)
                .toList();
    }

    public SourceResponse get(String id) {
        return toResponse(getDocOrThrow(id));
    }

    public void delete(String id) {
        repository.deleteById(id);
    }

    public boolean testConnection(String id) {
        SourceConfigDoc cfg = getDocOrThrow(id);
        return connectorRegistry.get(cfg.getSourceType()).testConnection(cfg);
    }

    public SourceConfigDoc getDocOrThrow(String id) {
        return repository.findById(id).orElseThrow(() -> new NotFoundException("Source not found: " + id));
    }

    private SourceResponse toResponse(SourceConfigDoc doc) {
        return SourceResponse.builder()
                .id(doc.getId())
                .name(doc.getName())
                .sourceType(doc.getSourceType())
                .endpoint(doc.getEndpoint())
                .databaseName(doc.getDatabaseName())
                .username(doc.getUsername())
                .options(doc.getOptions())
                .active(doc.getActive())
                .createdAt(doc.getCreatedAt())
                .updatedAt(doc.getUpdatedAt())
                .build();
    }
}
