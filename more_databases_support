import com.acme.datagateway.model.SourceConfigDoc;
import com.acme.datagateway.model.SourceType;
import com.mongodb.ConnectionString;
import com.mongodb.MongoCredential;
import com.mongodb.MongoException;
import com.mongodb.client.*;
import com.mongodb.client.model.Projections;
import org.bson.Document;
import org.bson.conversions.Bson;
import org.springframework.stereotype.Component;

import java.util.*;

@Component
public class MongoConnector implements DataSourceConnector {

    private final CryptoService cryptoService;

    public MongoConnector(CryptoService cryptoService) {
        this.cryptoService = cryptoService;
    }

    @Override
    public boolean supports(SourceType sourceType) {
        return sourceType == SourceType.MONGODB;
    }

    @Override
    public boolean testConnection(SourceConfigDoc cfg) {
        try (MongoClient client = createClient(cfg)) {
            client.listDatabaseNames().first();
            return true;
        } catch (MongoException e) {
            throw new RuntimeException("Mongo connection test failed: " + e.getMessage(), e);
        }
    }

    @Override
    public List<String> listNamespaces(SourceConfigDoc cfg) {
        try (MongoClient client = createClient(cfg)) {
            List<String> out = new ArrayList<>();
            for (String db : client.listDatabaseNames()) {
                out.add(db);
            }
            return out;
        } catch (Exception e) {
            throw new RuntimeException("Failed to list Mongo databases", e);
        }
    }

    @Override
    public List<EntityMeta> listEntities(SourceConfigDoc cfg, String namespace) {
        String dbName = resolveDatabase(cfg, namespace);
        try (MongoClient client = createClient(cfg)) {
            MongoDatabase db = client.getDatabase(dbName);
            List<EntityMeta> out = new ArrayList<>();
            for (String c : db.listCollectionNames()) {
                out.add(EntityMeta.builder()
                        .namespace(dbName)
                        .name(c)
                        .type("COLLECTION")
                        .build());
            }
            return out;
        } catch (Exception e) {
            throw new RuntimeException("Failed to list Mongo collections", e);
        }
    }

    @Override
    public List<FieldMeta> listFields(SourceConfigDoc cfg, String namespace, String entity) {
        String dbName = resolveDatabase(cfg, namespace);
        try (MongoClient client = createClient(cfg)) {
            MongoCollection<Document> col = client.getDatabase(dbName).getCollection(entity);

            Map<String, String> inferredTypes = new TreeMap<>();
            FindIterable<Document> docs = col.find().projection(Projections.excludeId()).limit(50);

            for (Document d : docs) {
                for (Map.Entry<String, Object> e : d.entrySet()) {
                    if (!inferredTypes.containsKey(e.getKey()) && e.getValue() != null) {
                        inferredTypes.put(e.getKey(), e.getValue().getClass().getSimpleName());
                    } else if (!inferredTypes.containsKey(e.getKey())) {
                        inferredTypes.put(e.getKey(), "Unknown");
                    }
                }
            }

            List<FieldMeta> out = new ArrayList<>();
            for (Map.Entry<String, String> e : inferredTypes.entrySet()) {
                out.add(FieldMeta.builder()
                        .name(e.getKey())
                        .dataType(e.getValue())
                        .nullable(true)
                        .indexed(false)
                        .build());
            }
            return out;
        } catch (Exception e) {
            throw new RuntimeException("Failed to inspect Mongo fields", e);
        }
    }

    @Override
    public QueryResult executeQuery(SourceConfigDoc cfg, UnifiedQueryRequest request) {
        long start = System.currentTimeMillis();
        String dbName = resolveDatabase(cfg, request.getNamespace());

        try (MongoClient client = createClient(cfg)) {
            MongoCollection<Document> col = client.getDatabase(dbName).getCollection(request.getEntity());

            Bson filter = MongoQueryTranslator.toFilter(request);
            Bson projection = MongoQueryTranslator.toProjection(request.getSelect());
            Bson sort = MongoQueryTranslator.toSort(request.getSort());

            FindIterable<Document> it = col.find(filter)
                    .skip(request.getOffset())
                    .limit(request.getLimit());

            if (projection != null) {
                it = it.projection(projection);
            }
            if (sort != null) {
                it = it.sort(sort);
            }

            List<Map<String, Object>> rows = new ArrayList<>();
            for (Document d : it) {
                rows.add(new LinkedHashMap<>(d));
            }

            long took = System.currentTimeMillis() - start;
            return QueryResult.builder()
                    .engine("MONGODB")
                    .executedQuery("find(" + request.getEntity() + ")")
                    .rowCount(rows.size())
                    .tookMs(took)
                    .rows(rows)
                    .build();
        } catch (Exception e) {
            throw new RuntimeException("Mongo query failed: " + e.getMessage(), e);
        }
    }

    @Override
    public Set<Capability> capabilities() {
        return Set.of(
                Capability.FILTER,
                Capability.SORT,
                Capability.PAGINATION,
                Capability.PROJECTION,
                Capability.FULL_TEXT
        );
    }

    private MongoClient createClient(SourceConfigDoc cfg) {
        ConnectionString cs = new ConnectionString(cfg.getEndpoint());
        MongoClientSettings.Builder builder = MongoClientSettings.builder().applyConnectionString(cs);

        String user = cfg.getUsername();
        String pass = cryptoService.decrypt(cfg.getPasswordCipherText());
        if (user != null && !user.isBlank() && pass != null && !pass.isBlank()) {
            String authDb = "admin";
            if (cfg.getOptions() != null && cfg.getOptions().containsKey("authDatabase")) {
                authDb = cfg.getOptions().get("authDatabase");
            } else if (cfg.getDatabaseName() != null && !cfg.getDatabaseName().isBlank()) {
                authDb = cfg.getDatabaseName();
            }
            builder.credential(MongoCredential.createCredential(user, authDb, pass.toCharArray()));
        }

        return MongoClients.create(builder.build());
    }

    private String resolveDatabase(SourceConfigDoc cfg, String namespace) {
        String db = (namespace != null && !namespace.isBlank()) ? namespace : cfg.getDatabaseName();
        if (db == null || db.isBlank()) {
            throw new IllegalArgumentException("Mongo database is required (namespace or source.databaseName)");
        }
        return db;
    }
}
