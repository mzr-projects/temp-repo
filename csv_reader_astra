## 6. CSV discovery, conversion, and resumable processing

This implementation:

- Rescans the directory periodically.
- Does not depend on filesystem watch notifications.
- Keeps checkpoints for all files.
- Handles quoted fields, embedded newlines, and an optional UTF-8 BOM.
- Rejects missing/duplicate headers and inconsistent row widths.
- Hashes each newly opened/resumed file.
- Skips already committed records when resuming.
- Prepares JSON before opening a Kafka transaction.
- Stops on malformed input instead of silently skipping data.

### `CsvSource.java`

```java
package com.example.ingest;

import java.io.IOException;
import java.io.PushbackReader;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.LinkOption;
import java.nio.file.Path;
import java.security.MessageDigest;
import java.util.ArrayList;
import java.util.Base64;
import java.util.HexFormat;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

import jakarta.annotation.PreDestroy;

import org.apache.commons.csv.CSVFormat;
import org.apache.commons.csv.CSVParser;
import org.apache.commons.csv.CSVRecord;
import org.apache.commons.csv.DuplicateHeaderMode;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import org.springframework.boot.health.contributor.Health;
import org.springframework.boot.health.contributor.HealthIndicator;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import io.micrometer.core.instrument.Counter;
import io.micrometer.core.instrument.MeterRegistry;
import tools.jackson.databind.json.JsonMapper;

@Component("csvSource")
public class CsvSource implements HealthIndicator {

    private static final Logger log =
            LoggerFactory.getLogger(CsvSource.class);

    private static final CSVFormat CSV_FORMAT =
            CSVFormat.RFC4180.builder()
                    .setHeader()
                    .setSkipHeaderRecord(true)
                    .setAllowMissingColumnNames(false)
                    .setDuplicateHeaderMode(DuplicateHeaderMode.DISALLOW)
                    .setIgnoreEmptyLines(false)
                    .get();

    private final IngestProperties config;
    private final JsonMapper json;

    private final Counter committedRecords;
    private final Counter committedTransactions;
    private final Counter failures;

    private KafkaJournal journal;

    private volatile boolean stopping;
    private volatile boolean initialized;
    private volatile Throwable failure;

    public CsvSource(
            IngestProperties config,
            JsonMapper json,
            MeterRegistry metrics
    ) {
        this.config = config;
        this.json = json;

        this.committedRecords =
                metrics.counter("csv.ingest.records.committed");
        this.committedTransactions =
                metrics.counter("csv.ingest.transactions.committed");
        this.failures =
                metrics.counter("csv.ingest.failures");
    }

    @Scheduled(fixedDelayString = "${ingest.scan-delay:2s}")
    public synchronized void scan() {
        if (stopping || failure != null) {
            return;
        }

        try {
            if (!Files.isDirectory(config.directory())) {
                throw new IOException(
                        "Input directory is unavailable: " + config.directory()
                );
            }

            if (journal == null) {
                journal = new KafkaJournal(config, json);
                journal.initialize();
                initialized = true;

                log.info("Recovered checkpoints for source={}",
                        config.sourceId());
            }

            verifyUnfinishedFilesExist();

            List<Path> files;
            try (var stream = Files.list(config.directory())) {
                files = stream
                        .filter(path ->
                                path.getFileName().toString().endsWith(".csv"))
                        .filter(path -> Files.isRegularFile(
                                path, LinkOption.NOFOLLOW_LINKS))
                        .sorted()
                        .toList();
            }

            for (Path file : files) {
                if (stopping) {
                    return;
                }

                String name = file.getFileName().toString();
                Checkpoint checkpoint = journal.checkpoint(name);

                if (checkpoint != null && checkpoint.completed()) {
                    continue;
                }

                processFile(file, checkpoint);
            }

        } catch (Exception exception) {
            // Fail closed. Do not restart from possibly stale local state.
            failure = exception;
            failures.increment();

            log.error(
                    "CSV ingestion stopped. Restart only after resolving "
                    + "the failure; recovery will use Kafka checkpoints.",
                    exception
            );

            closeJournal();
        }
    }

    private void processFile(
            Path file,
            Checkpoint previous
    ) throws Exception {

        String fileName = file.getFileName().toString();
        String sha256 = sha256(file);

        if (previous != null && !sha256.equals(previous.sha256())) {
            throw new IllegalStateException(
                    "Previously checkpointed file changed: " + fileName
            );
        }

        long nextRecord = previous == null ? 0 : previous.nextRecord();

        String fileId = config.sourceId() + ":" +
                Base64.getUrlEncoder()
                        .withoutPadding()
                        .encodeToString(
                                fileName.getBytes(StandardCharsets.UTF_8)
                        );

        try (PushbackReader reader = openUtf8(file);
             CSVParser parser = CSV_FORMAT.parse(reader)) {

            List<String> headers = parser.getHeaderNames();

            if (headers.isEmpty()
                    || headers.stream().anyMatch(String::isBlank)) {
                throw new IllegalStateException(
                        "Missing or blank CSV headers: " + fileName
                );
            }

            var iterator = parser.iterator();

            // Resume by logical CSV record, not by physical line.
            for (long skipped = 0; skipped < nextRecord; skipped++) {
                if (stopping) {
                    return;
                }

                if (!iterator.hasNext()) {
                    throw new IllegalStateException(
                            "Checkpoint is beyond EOF: " + fileName
                    );
                }

                iterator.next();
            }

            while (!stopping) {
                List<OutgoingRecord> batch =
                        new ArrayList<>(config.batchRows());

                long batchBytes = 0;

                while (batch.size() < config.batchRows()
                        && batchBytes < config.batchBytes()
                        && iterator.hasNext()) {

                    CSVRecord csv = iterator.next();

                    if (!csv.isConsistent()) {
                        throw new IllegalStateException(
                                "Column count mismatch: file=" + fileName
                                + ", record=" + nextRecord
                        );
                    }

                    Map<String, String> data = new LinkedHashMap<>();

                    for (int column = 0; column < headers.size(); column++) {
                        data.put(headers.get(column), csv.get(column));
                    }

                    String eventId = fileId + ":" + nextRecord;

                    Map<String, Object> event = new LinkedHashMap<>();
                    event.put("schemaVersion", 1);
                    event.put("eventId", eventId);
                    event.put("sourceId", config.sourceId());
                    event.put("fileName", fileName);
                    event.put("fileSha256", sha256);
                    event.put("recordIndex", nextRecord);
                    event.put("data", data);

                    String payload = json.writeValueAsString(event);

                    int recordBytes = payload
                            .getBytes(StandardCharsets.UTF_8).length;

                    if (recordBytes > config.maxRecordBytes()) {
                        throw new IllegalStateException(
                                "JSON event exceeds configured limit: file="
                                + fileName + ", record=" + nextRecord
                        );
                    }

                    batch.add(new OutgoingRecord(eventId, payload));
                    batchBytes += recordBytes;
                    nextRecord++;
                }

                boolean completed = !iterator.hasNext();

                if (stopping) {
                    // Prepared but uncommitted records will be reread.
                    return;
                }

                Checkpoint checkpoint = new Checkpoint(
                        1,
                        config.sourceId(),
                        fileName,
                        sha256,
                        nextRecord,
                        completed
                );

                // Also handles header-only files: zero records + completed.
                journal.commit(batch, checkpoint);

                committedRecords.increment(batch.size());
                committedTransactions.increment();

                log.info(
                        "Committed file={} nextRecord={} completed={} rows={}",
                        fileName,
                        nextRecord,
                        completed,
                        batch.size()
                );

                if (completed) {
                    return;
                }
            }
        }
    }

    private void verifyUnfinishedFilesExist() {
        for (Checkpoint checkpoint : journal.checkpoints()) {
            if (checkpoint.completed()) {
                continue;
            }

            Path file = config.directory().resolve(checkpoint.fileName());

            if (!Files.isRegularFile(file, LinkOption.NOFOLLOW_LINKS)) {
                throw new IllegalStateException(
                        "Unfinished source file is missing: "
                        + checkpoint.fileName()
                );
            }
        }
    }

    private static PushbackReader openUtf8(Path file) throws IOException {
        PushbackReader reader = new PushbackReader(
                Files.newBufferedReader(file, StandardCharsets.UTF_8),
                1
        );

        try {
            int first = reader.read();

            if (first != -1 && first != '\uFEFF') {
                reader.unread(first);
            }

            return reader;
        } catch (IOException | RuntimeException exception) {
            reader.close();
            throw exception;
        }
    }

    private String sha256(Path file) throws Exception {
        MessageDigest digest = MessageDigest.getInstance("SHA-256");

        try (var input = Files.newInputStream(file)) {
            byte[] buffer = new byte[64 * 1024];

            int count;
            while ((count = input.read(buffer)) != -1) {
                if (stopping) {
                    throw new IOException("Stopping while hashing file");
                }

                digest.update(buffer, 0, count);
            }
        }

        return HexFormat.of().formatHex(digest.digest());
    }

    @Override
    public Health health() {
        Throwable currentFailure = failure;

        if (currentFailure != null) {
            return Health.down()
                    .withDetail("state", "FAILED")
                    .withDetail(
                            "errorType",
                            currentFailure.getClass().getSimpleName()
                    )
                    .build();
        }

        if (!initialized || stopping) {
            return Health.outOfService()
                    .withDetail("state", stopping ? "STOPPING" : "RECOVERING")
                    .build();
        }

        return Health.up()
                .withDetail("sourceId", config.sourceId())
                .build();
    }

    @PreDestroy
    public void shutdown() {
        stopping = true;

        // Let the owner finish/exit its current bounded transaction.
        synchronized (this) {
            closeJournal();
        }
    }

    private void closeJournal() {
        if (journal == null) {
            return;
        }

        try {
            journal.close();
        } catch (Exception closeFailure) {
            log.warn("Error closing Kafka producer", closeFailure);
        } finally {
            journal = null;
        }
    }
}
```

