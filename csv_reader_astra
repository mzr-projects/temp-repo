## 5. Transactional Kafka writer and checkpoint recovery

Two details are particularly important:

1. Call `initTransactions()` **before recovering checkpoints**. It resolves transactions from the previous producer instance with the same transactional ID and fences older producer instances. ([kafka.apache.org](https://kafka.apache.org/40/javadoc/org/apache/kafka/clients/producer/KafkaProducer?utm_source=openai))
2. Do not assume that one empty consumer poll means checkpoint recovery is complete. A `read_committed` consumer is constrained by the last stable offset. This implementation writes a committed recovery marker and reads the checkpoint partition until it observes that marker. ([kafka.apache.org](https://kafka.apache.org/40/javadoc/org/apache/kafka/clients/consumer/KafkaConsumer.html))

The recovery marker is an implementation choice that establishes an explicit recovery boundary.

### `KafkaJournal.java`

```java
package com.example.ingest;

import java.time.Duration;
import java.util.ArrayList;
import java.util.Collection;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.TimeUnit;

import org.apache.kafka.clients.admin.Admin;
import org.apache.kafka.clients.consumer.ConsumerConfig;
import org.apache.kafka.clients.consumer.KafkaConsumer;
import org.apache.kafka.clients.producer.KafkaProducer;
import org.apache.kafka.clients.producer.ProducerConfig;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.apache.kafka.common.TopicPartition;
import org.apache.kafka.common.config.ConfigResource;
import org.apache.kafka.common.serialization.StringDeserializer;
import org.apache.kafka.common.serialization.StringSerializer;

import tools.jackson.databind.json.JsonMapper;

public final class KafkaJournal implements AutoCloseable {

    private static final String BARRIER_KEY = "__recovery_barrier";
    private static final String FILE_PREFIX = "file:";

    private final IngestProperties config;
    private final JsonMapper json;
    private final KafkaProducer<String, String> producer;

    // Accessed only by the ingestion thread.
    private final Map<String, Checkpoint> checkpoints = new HashMap<>();

    public KafkaJournal(IngestProperties config, JsonMapper json) {
        this.config = config;
        this.json = json;

        Map<String, Object> properties = commonProperties();

        properties.put(
                ProducerConfig.KEY_SERIALIZER_CLASS_CONFIG,
                StringSerializer.class
        );
        properties.put(
                ProducerConfig.VALUE_SERIALIZER_CLASS_CONFIG,
                StringSerializer.class
        );

        // Fixed logical-source identity, NOT a random instance UUID.
        properties.put(
                ProducerConfig.TRANSACTIONAL_ID_CONFIG,
                "csv-ingest-v1-" + config.sourceId()
        );

        properties.put(ProducerConfig.ENABLE_IDEMPOTENCE_CONFIG, true);
        properties.put(ProducerConfig.ACKS_CONFIG, "all");
        properties.put(ProducerConfig.RETRIES_CONFIG, Integer.MAX_VALUE);
        properties.put(
                ProducerConfig.MAX_IN_FLIGHT_REQUESTS_PER_CONNECTION,
                5
        );

        properties.put(ProducerConfig.COMPRESSION_TYPE_CONFIG, "zstd");
        properties.put(ProducerConfig.LINGER_MS_CONFIG, 5);

        properties.put(ProducerConfig.REQUEST_TIMEOUT_MS_CONFIG, 30_000);
        properties.put(ProducerConfig.DELIVERY_TIMEOUT_MS_CONFIG, 120_000);
        properties.put(ProducerConfig.MAX_BLOCK_MS_CONFIG, 120_000);
        properties.put(ProducerConfig.TRANSACTION_TIMEOUT_CONFIG, 180_000);

        this.producer = new KafkaProducer<>(properties);
    }

    public void initialize() throws Exception {
        validateTopics();

        // Resolve/fence the old producer BEFORE restoring source progress.
        producer.initTransactions();

        String barrier = UUID.randomUUID().toString();

        producer.beginTransaction();
        producer.send(new ProducerRecord<>(
                config.checkpointTopic(),
                0,
                BARRIER_KEY,
                barrier
        ));
        producer.commitTransaction();

        restoreUntil(barrier);
    }

    public Checkpoint checkpoint(String fileName) {
        return checkpoints.get(fileName);
    }

    public Collection<Checkpoint> checkpoints() {
        return List.copyOf(checkpoints.values());
    }

    public void commit(
            List<OutgoingRecord> records,
            Checkpoint checkpoint
    ) {
        // Serialize before starting the transaction.
        String checkpointJson = json.writeValueAsString(checkpoint);

        producer.beginTransaction();

        for (OutgoingRecord record : records) {
            producer.send(new ProducerRecord<>(
                    config.outputTopic(),
                    record.key(),
                    record.json()
            ));
        }

        producer.send(new ProducerRecord<>(
                config.checkpointTopic(),
                0,
                FILE_PREFIX + checkpoint.fileName(),
                checkpointJson
        ));

        // This also waits for pending sends and surfaces send failures.
        producer.commitTransaction();

        // Update local progress ONLY after successful commit.
        checkpoints.put(checkpoint.fileName(), checkpoint);
    }

    private void restoreUntil(String expectedBarrier) {
        Map<String, Object> properties = commonProperties();

        properties.put(
                ConsumerConfig.KEY_DESERIALIZER_CLASS_CONFIG,
                StringDeserializer.class
        );
        properties.put(
                ConsumerConfig.VALUE_DESERIALIZER_CLASS_CONFIG,
                StringDeserializer.class
        );
        properties.put(ConsumerConfig.ENABLE_AUTO_COMMIT_CONFIG, false);
        properties.put(ConsumerConfig.ISOLATION_LEVEL_CONFIG, "read_committed");
        properties.put(ConsumerConfig.AUTO_OFFSET_RESET_CONFIG, "none");
        properties.put(ConsumerConfig.ALLOW_AUTO_CREATE_TOPICS_CONFIG, false);
        properties.put(ConsumerConfig.MAX_POLL_RECORDS_CONFIG, 1000);
        properties.put(ConsumerConfig.DEFAULT_API_TIMEOUT_MS_CONFIG, 60_000);

        TopicPartition partition =
                new TopicPartition(config.checkpointTopic(), 0);

        long started = System.nanoTime();
        long timeoutNanos = config.recoveryTimeout().toNanos();

        try (KafkaConsumer<String, String> consumer =
                     new KafkaConsumer<>(properties)) {

            // Manual assignment: no group subscription or group commits.
            consumer.assign(List.of(partition));
            consumer.seekToBeginning(List.of(partition));

            while (System.nanoTime() - started < timeoutNanos) {
                var records = consumer.poll(Duration.ofMillis(500));

                for (var record : records) {
                    if (BARRIER_KEY.equals(record.key())) {
                        if (expectedBarrier.equals(record.value())) {
                            return;
                        }
                        continue;
                    }

                    if (record.key() == null
                            || !record.key().startsWith(FILE_PREFIX)
                            || record.value() == null) {
                        throw new IllegalStateException(
                                "Unexpected checkpoint record or tombstone"
                        );
                    }

                    Checkpoint checkpoint =
                            json.readValue(record.value(), Checkpoint.class);

                    validateCheckpoint(record.key(), checkpoint);
                    checkpoints.put(checkpoint.fileName(), checkpoint);
                }
            }
        }

        throw new IllegalStateException(
                "Checkpoint recovery timed out before reaching its barrier"
        );
    }

    private void validateCheckpoint(String key, Checkpoint checkpoint) {
        if (checkpoint.version() != 1
                || !config.sourceId().equals(checkpoint.sourceId())
                || checkpoint.fileName() == null
                || checkpoint.fileName().isBlank()
                || checkpoint.sha256() == null
                || !checkpoint.sha256().matches("[0-9a-f]{64}")
                || checkpoint.nextRecord() < 0
                || !key.equals(FILE_PREFIX + checkpoint.fileName())) {
            throw new IllegalStateException("Invalid checkpoint");
        }

        // Only direct children of the configured directory are supported.
        var resolved = config.directory()
                .resolve(checkpoint.fileName())
                .normalize();

        if (!config.directory().equals(resolved.getParent())) {
            throw new IllegalStateException(
                    "Checkpoint contains an invalid filename"
            );
        }
    }

    private void validateTopics() throws Exception {
        try (Admin admin = Admin.create(commonProperties())) {
            var topics = admin.describeTopics(List.of(
                    config.outputTopic(),
                    config.checkpointTopic()
            )).allTopicNames().get(30, TimeUnit.SECONDS);

            if (topics.get(config.checkpointTopic()).partitions().size() != 1) {
                throw new IllegalStateException(
                        "Checkpoint topic must have exactly one partition"
                );
            }

            ConfigResource resource = new ConfigResource(
                    ConfigResource.Type.TOPIC,
                    config.checkpointTopic()
            );

            var topicConfig = admin.describeConfigs(List.of(resource))
                    .all()
                    .get(30, TimeUnit.SECONDS)
                    .get(resource);

            String cleanupPolicy =
                    topicConfig.get("cleanup.policy").value();

            if (!"compact".equals(cleanupPolicy.trim())) {
                throw new IllegalStateException(
                        "Checkpoint topic must use cleanup.policy=compact"
                );
            }
        }
    }

    private Map<String, Object> commonProperties() {
        Map<String, Object> properties = new HashMap<>();
        properties.putAll(config.kafka());
        return properties;
    }

    @Override
    public void close() {
        producer.close(Duration.ofSeconds(10));
    }
}
```

**Error policy:** if a transaction operation throws, this application stops ingestion rather than reusing its in-memory position. After restart, it resolves the previous transaction and recovers authoritative progress from Kafka.

That includes an ambiguous `commitTransaction()` result: the application must not assume “exception means nothing committed.” Kafka documents both transaction initialization recovery and commit behavior. ([kafka.apache.org](https://kafka.apache.org/40/javadoc/org/apache/kafka/clients/producer/KafkaProducer?utm_source=openai))

