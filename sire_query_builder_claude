## 4. Service Layer - Query Builder

```java
@Service
@Slf4j
public class SirenQueryBuilderService {
    
    public Map<String, Object> buildSirenQuery(SirenQueryRequest request) {
        Map<String, Object> query = new HashMap<>();
        
        // Build the main query structure
        Map<String, Object> bool = new HashMap<>();
        List<Map<String, Object>> must = new ArrayList<>();
        
        // Add base filters
        if (request.getFilter() != null) {
            addFilters(must, request.getFilter());
        }
        
        // Add Siren join clauses
        if (request.getJoins() != null && !request.getJoins().isEmpty()) {
            for (JoinDefinition join : request.getJoins()) {
                must.add(buildSirenJoin(join));
            }
        }
        
        bool.put("must", must);
        query.put("bool", bool);
        
        return query;
    }
    
    private Map<String, Object> buildSirenJoin(JoinDefinition join) {
        Map<String, Object> sirenJoin = new HashMap<>();
        Map<String, Object> joinConfig = new HashMap<>();
        
        // Build indices array
        List<String> indices = List.of(join.getTargetIndex());
        joinConfig.put("indices", indices);
        
        // Build on clause - field mapping
        List<Map<String, String>> on = new ArrayList<>();
        Map<String, String> fieldMapping = new HashMap<>();
        fieldMapping.put(join.getJoinField(), join.getTargetField());
        on.add(fieldMapping);
        joinConfig.put("on", on);
        
        // Add join type if not default
        if (join.getJoinType() != null) {
            joinConfig.put("type", join.getJoinType().name().toLowerCase());
        }
        
        // Add request if there are filters or specific fields
        if (join.getTargetFilter() != null || join.getReturnFields() != null) {
            Map<String, Object> request = new HashMap<>();
            
            // Add query filters for target index
            if (join.getTargetFilter() != null) {
                Map<String, Object> targetQuery = new HashMap<>();
                Map<String, Object> targetBool = new HashMap<>();
                List<Map<String, Object>> targetMust = new ArrayList<>();
                
                addFilters(targetMust, join.getTargetFilter());
                targetBool.put("must", targetMust);
                targetQuery.put("bool", targetBool);
                request.put("query", targetQuery);
            }
            
            // Add source fields to return
            if (join.getReturnFields() != null && !join.getReturnFields().isEmpty()) {
                request.put("_source", join.getReturnFields());
            }
            
            joinConfig.put("request", request);
        }
        
        sirenJoin.put("siren_join", joinConfig);
        return sirenJoin;
    }
    
    private void addFilters(List<Map<String, Object>> must, QueryFilter filter) {
        if (filter.getMatch() != null) {
            filter.getMatch().forEach((field, value) -> {
                Map<String, Object> match = new HashMap<>();
                match.put("match", Map.of(field, value));
                must.add(match);
            });
        }
        
        if (filter.getTerm() != null) {
            filter.getTerm().forEach((field, value) -> {
                Map<String, Object> term = new HashMap<>();
                term.put("term", Map.of(field, value));
                must.add(term);
            });
        }
        
        if (filter.getRange() != null) {
            filter.getRange().forEach((field, value) -> {
                Map<String, Object> range = new HashMap<>();
                range.put("range", Map.of(field, value));
                must.add(range);
            });
        }
        
        if (filter.getMust() != null) {
            must.addAll(filter.getMust());
        }
    }
    
    public Map<String, Object> buildAggregations(AggregationDefinition aggDef) {
        Map<String, Object> aggregations = new HashMap<>();
        
        if (aggDef == null) {
            return aggregations;
        }
        
        Map<String, Object> aggConfig = new HashMap<>();
        
        switch (aggDef.getType()) {
            case TERMS:
                Map<String, Object> terms = new HashMap<>();
                terms.put("field", aggDef.getField());
                if (aggDef.getParams() != null) {
                    terms.putAll(aggDef.getParams());
                }
                aggConfig.put("terms", terms);
                break;
                
            case SUM:
            case AVG:
            case MAX:
            case MIN:
            case CARDINALITY:
                Map<String, Object> metric = new HashMap<>();
                metric.put("field", aggDef.getField());
                aggConfig.put(aggDef.getType().name().toLowerCase(), metric);
                break;
                
            case DATE_HISTOGRAM:
                Map<String, Object> dateHisto = new HashMap<>();
                dateHisto.put("field", aggDef.getField());
                if (aggDef.getParams() != null) {
                    dateHisto.putAll(aggDef.getParams());
                }
                aggConfig.put("date_histogram", dateHisto);
                break;
                
            case STATS:
                Map<String, Object> stats = new HashMap<>();
                stats.put("field", aggDef.getField());
                aggConfig.put("stats", stats);
                break;
        }
        
        aggregations.put(aggDef.getName(), aggConfig);
        return aggregations;
    }
}
```

## 5. Repository Layer

```java
@Repository
@Slf4j
public class SirenElasticsearchRepository {
    
    private final RestClient restClient;
    private final ObjectMapper objectMapper;
    
    @Autowired
    public SirenElasticsearchRepository(RestClient restClient) {
        this.restClient = restClient;
        this.objectMapper = new ObjectMapper();
    }
    
    public SirenQueryResponse executeQuery(SirenQueryRequest request, Map<String, Object> query, 
                                          Map<String, Object> aggregations) throws IOException {
        
        // Build the complete search request
        Map<String, Object> searchRequest = new HashMap<>();
        searchRequest.put("query", query);
        searchRequest.put("from", request.getFrom());
        searchRequest.put("size", request.getSize());
        
        if (request.getSourceFields() != null && !request.getSourceFields().isEmpty()) {
            searchRequest.put("_source", request.getSourceFields());
        }
        
        if (aggregations != null && !aggregations.isEmpty()) {
            searchRequest.put("aggs", aggregations);
        }
        
        String jsonRequest = objectMapper.writeValueAsString(searchRequest);
        log.debug("Executing Siren query: {}", jsonRequest);
        
        // Execute the request
        Request esRequest = new Request("POST", "/" + request.getBaseIndex() + "/_search");
        esRequest.setJsonEntity(jsonRequest);
        
        Response response = restClient.performRequest(esRequest);
        String responseBody = EntityUtils.toString(response.getEntity());
        
        log.debug("Elasticsearch response: {}", responseBody);
        
        return parseResponse(responseBody);
    }
    
    @SuppressWarnings("unchecked")
    private SirenQueryResponse parseResponse(String responseBody) throws IOException {
        Map<String, Object> responseMap = objectMapper.readValue(responseBody, Map.class);
        
        Map<String, Object> hits = (Map<String, Object>) responseMap.get("hits");
        Map<String, Object> total = (Map<String, Object>) hits.get("total");
        long totalHits = ((Number) total.get("value")).longValue();
        
        List<Map<String, Object>> hitsList = (List<Map<String, Object>>) hits.get("hits");
        List<Map<String, Object>> results = new ArrayList<>();
        
        for (Map<String, Object> hit : hitsList) {
            Map<String, Object> result = new HashMap<>();
            result.put("_id", hit.get("_id"));
            result.put("_index", hit.get("_index"));
            result.put("_source", hit.get("_source"));
            
            // Include joined data if present
            if (hit.containsKey("fields")) {
                result.put("fields", hit.get("fields"));
            }
            
            results.add(result);
        }
        
        Map<String, Object> aggregationsResult = 
            (Map<String, Object>) responseMap.getOrDefault("aggregations", new HashMap<>());
        
        long took = ((Number) responseMap.get("took")).longValue();
        
        return SirenQueryResponse.builder()
            .totalHits(totalHits)
            .results(results)
            .aggregations(aggregationsResult)
            .took(took)
            .build();
    }
    
    public boolean indexExists(String indexName) throws IOException {
        Request request = new Request("HEAD", "/" + indexName);
        Response response = restClient.performRequest(request);
        return response.getStatusLine().getStatusCode() == 200;
    }
}
```

## 6. Service Layer - Orchestration

```java
@Service
@Slf4j
public class SirenQueryService {
    
    private final SirenQueryBuilderService queryBuilder;
    private final SirenElasticsearchRepository repository;
    private final SirenQueryValidator validator;
    
    @Autowired
    public SirenQueryService(SirenQueryBuilderService queryBuilder,
                            SirenElasticsearchRepository repository,
                            SirenQueryValidator validator) {
        this.queryBuilder = queryBuilder;
        this.repository = repository;
        this.validator = validator;
    }
    
    public SirenQueryResponse executeQuery(SirenQueryRequest request) {
        try {
            // Validate request
            validator.validate(request);
            
            // Build query
            Map<String, Object> query = queryBuilder.buildSirenQuery(request);
            
            // Build aggregations if needed
            Map<String, Object> aggregations = null;
            if (request.getAggregation() != null) {
                aggregations = queryBuilder.buildAggregations(request.getAggregation());
            }
            
            // Execute query
            return repository.executeQuery(request, query, aggregations);
            
        } catch (Exception e) {
            log.error("Error executing Siren query", e);
            throw new SirenQueryException("Failed to execute query: " + e.getMessage(), e);
        }
    }
    
    public CompletableFuture<SirenQueryResponse> executeQueryAsync(SirenQueryRequest request) {
        return CompletableFuture.supplyAsync(() -> executeQuery(request));
    }
}
```

## 7. Validation

```java
@Component
@Slf4j
public class SirenQueryValidator {
    
    private final SirenElasticsearchRepository repository;
    
    @Autowired
    public SirenQueryValidator(SirenElasticsearchRepository repository) {
        this.repository = repository;
    }
    
    public void validate(SirenQueryRequest request) throws IOException {
        // Check base index exists
        if (!repository.indexExists(request.getBaseIndex())) {
            throw new IllegalArgumentException("Base index does not exist: " + request.getBaseIndex());
        }
        
        // Validate joins
        if (request.getJoins() != null) {
            for (JoinDefinition join : request.getJoins()) {
                if (!repository.indexExists(join.getTargetIndex())) {
                    throw new IllegalArgumentException(
                        "Target index does not exist: " + join.getTargetIndex()
                    );
                }
            }
        }
        
        // Validate pagination
        if (request.getFrom() + request.getSize() > 10000) {
            throw new IllegalArgumentException(
                "Result window is too large, from + size must be less than or equal to 10000"
            );
        }
    }
}
```

## 8. Controller

```java
@RestController
@RequestMapping("/api/v1/query")
@Slf4j
public class SirenQueryController {
    
    private final SirenQueryService queryService;
    
    @Autowired
    public SirenQueryController(SirenQueryService queryService) {
        this.queryService = queryService;
    }
    
    @PostMapping("/execute")
    public ResponseEntity<SirenQueryResponse> executeQuery(
            @Valid @RequestBody SirenQueryRequest request) {
        
        log.info("Received query request for index: {}", request.getBaseIndex());
        SirenQueryResponse response = queryService.executeQuery(request);
        return ResponseEntity.ok(response);
    }
    
    @PostMapping("/execute/async")
    public CompletableFuture<ResponseEntity<SirenQueryResponse>> executeQueryAsync(
            @Valid @RequestBody SirenQueryRequest request) {
        
        log.info("Received async query request for index: {}", request.getBaseIndex());
        return queryService.executeQueryAsync(request)
            .thenApply(ResponseEntity::ok);
    }
}
