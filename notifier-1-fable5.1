## 5. The generic reactive pipeline

```java
@Component
@RequiredArgsConstructor
@Slf4j
public class KafkaIngestionPipeline implements SmartLifecycle {

    private final ReceiverOptions<String, byte[]> baseReceiverOptions;
    private final TopicHandlerRegistry registry;
    private final NationalCodeLookup lookup;
    private final ObjectMapper mapper;
    private final DeadLetterPublisher dlt;
    private final AppProperties props;
    private final MeterRegistry meters;

    private Disposable subscription;

    @Override
    public void start() {
        var options = baseReceiverOptions.subscription(registry.topics());

        subscription = KafkaReceiver.create(options)
            .receive()
            // preserve ordering per partition, parallelism across partitions
            .groupBy(rec -> rec.receiverOffset().topicPartition())
            .flatMap(partition -> partition.concatMap(this::process), props.kafka().partitionConcurrency())
            // if the receiver itself dies (broker down etc.) – restart with backoff
            .retryWhen(Retry.backoff(Long.MAX_VALUE, Duration.ofSeconds(1)).maxBackoff(Duration.ofSeconds(30))
                    .doBeforeRetry(s -> log.error("Kafka stream failed, restarting", s.failure())))
            .subscribe();
    }

    private Mono<Void> process(ReceiverRecord<String, byte[]> rec) {
        TopicHandler<Object> handler = registry.forTopic(rec.topic());
        var sample = Timer.start(meters);

        return Mono.fromCallable(() -> mapper.readValue(rec.value(), handler.payloadType()))
            .flatMap(payload -> {
                String nc = handler.extractNationalCode(payload);
                if (nc == null || nc.isBlank()) {
                    return Mono.error(new InvalidMessageException("nationalCode missing"));
                }
                return lookup.exists(nc)
                    .flatMap(exists -> exists ? handler.onMatch(payload, nc) : handler.onNoMatch(payload, nc));
            })
            .timeout(props.processing().timeout())
            .doOnSuccess(v -> meters.counter("msg.processed", "topic", rec.topic(), "result", "ok").increment())
            .onErrorResume(err -> {
                meters.counter("msg.processed", "topic", rec.topic(), "result", "failed").increment();
                log.error("Failed record topic={} partition={} offset={}", rec.topic(), rec.partition(), rec.offset(), err);
                return dlt.publish(rec, err);      // poison pill -> DLT, never block the partition
            })
            // ack ALWAYS (after success or after DLT) so the consumer never stalls
            .doFinally(sig -> {
                rec.receiverOffset().acknowledge();
                sample.stop(meters.timer("msg.latency", "topic", rec.topic()));
            });
    }

    @Override public void stop() { if (subscription != null) subscription.dispose(); }
    @Override public boolean isRunning() { return subscription != null && !subscription.isDisposed(); }
}
```

Dead-letter publisher (reactive sender):

```java
@Component
@RequiredArgsConstructor
public class DeadLetterPublisher {
    private final KafkaSender<String, byte[]> sender;

    public Mono<Void> publish(ReceiverRecord<String, byte[]> rec, Throwable err) {
        var out = new ProducerRecord<>(rec.topic() + ".DLT", rec.key(), rec.value());
        out.headers().add("x-error", err.toString().getBytes(UTF_8));
        out.headers().add("x-origin-offset", String.valueOf(rec.offset()).getBytes(UTF_8));
        return sender.send(Mono.just(SenderRecord.create(out, null))).then()
                     .onErrorResume(e -> Mono.empty()); // last resort: log & ack, don't stall
    }
}
```

