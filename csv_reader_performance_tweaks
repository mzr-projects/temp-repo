private final Map<String, Checkpoint> unfinished = new HashMap<>();

private void remember(Checkpoint checkpoint) {
    checkpoints.put(checkpoint.fileName(), checkpoint);

    if (checkpoint.completed()) {
        unfinished.remove(checkpoint.fileName());
    } else {
        unfinished.put(checkpoint.fileName(), checkpoint);
    }
}

public Collection<Checkpoint> unfinishedCheckpoints() {
    // Owner-thread access only.
    return unfinished.values();
}
