## Table Polling Service

```java
package com.example.datareader.reader;

import com.example.datareader.config.ReaderProperties;
import com.example.datareader.config.TableReaderProperties;
import com.example.datareader.datasource.DataSourceRegistry;
import com.example.datareader.processor.DataProcessor;
import com.example.datareader.processor.DataProcessorRegistry;
import com.example.datareader.watermark.WatermarkRepository;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Service;

import java.sql.Timestamp;
import java.time.Instant;
import java.util.List;
import java.util.Map;
import java.util.Optional;

@Service
public class TablePollingService {

    private final ReaderProperties readerProperties;
    private final DataSourceRegistry dataSourceRegistry;
    private final WatermarkRepository watermarkRepository;
    private final DataProcessorRegistry processorRegistry;

    public TablePollingService(
        ReaderProperties readerProperties,
        DataSourceRegistry dataSourceRegistry,
        WatermarkRepository watermarkRepository,
        DataProcessorRegistry processorRegistry
    ) {
        this.readerProperties = readerProperties;
        this.dataSourceRegistry = dataSourceRegistry;
        this.watermarkRepository = watermarkRepository;
        this.processorRegistry = processorRegistry;
    }

    public void pollTable(TableReaderProperties table) {
        JdbcTemplate jdbcTemplate = dataSourceRegistry.getJdbcTemplate(table.getDatabase());

        Optional<String> watermark = watermarkRepository.getWatermark(table);
        boolean hasWatermark = watermark.isPresent();

        String sql = QueryBuilder.buildQuery(table, hasWatermark);

        List<Map<String, Object>> rows;

        if (hasWatermark) {
            Object parsedWatermark = parseWatermark(table, watermark.get());

            rows = jdbcTemplate.queryForList(
                sql,
                parsedWatermark,
                readerProperties.getBatchSize()
            );
        } else {
            rows = jdbcTemplate.queryForList(
                sql,
                readerProperties.getBatchSize()
            );
        }

        if (rows.isEmpty()) {
            return;
        }

        DataProcessor processor = processorRegistry.getProcessor(table.getProcessor());

        processor.process(table, rows);

        Object newWatermark = extractMaxWatermark(table, rows);

        watermarkRepository.updateWatermark(table, newWatermark);
    }

    private Object parseWatermark(TableReaderProperties table, String value) {
        if (value == null) {
            return null;
        }

        return switch (table.getWatermarkType()) {
            case NUMBER -> Long.parseLong(value);
            case TIMESTAMP -> Timestamp.from(Instant.parse(value));
        };
    }

    private Object extractMaxWatermark(TableReaderProperties table, List<Map<String, Object>> rows) {
        Object value = null;

        for (Map<String, Object> row : rows) {
            Object current = getColumnValue(row, table.getWatermarkColumn());

            if (current != null) {
                value = current;
            }
        }

        if (value instanceof Timestamp timestamp) {
            return timestamp.toInstant().toString();
        }

        return value;
    }

    private Object getColumnValue(Map<String, Object> row, String columnName) {
        Object value = row.get(columnName);

        if (value == null) {
            value = row.get(columnName.toUpperCase());
        }

        if (value == null) {
            value = row.get(columnName.toLowerCase());
        }

        return value;
    }
}
```

