### `JdbcWatermarkRepository.java`

For a real project, you may want a separate metadata datasource. To keep this simple, this implementation stores the watermark in the same database as the monitored table.

```java
package com.example.datareader.watermark;

import com.example.datareader.config.TableReaderProperties;
import com.example.datareader.datasource.DataSourceRegistry;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.stereotype.Repository;

import java.util.Optional;

@Repository
public class JdbcWatermarkRepository implements WatermarkRepository {

    private final DataSourceRegistry dataSourceRegistry;

    public JdbcWatermarkRepository(DataSourceRegistry dataSourceRegistry) {
        this.dataSourceRegistry = dataSourceRegistry;
    }

    @Override
    public Optional<String> getWatermark(TableReaderProperties table) {
        JdbcTemplate jdbcTemplate = dataSourceRegistry.getJdbcTemplate(table.getDatabase());

        String sql = """
            SELECT WATERMARK_VALUE
            FROM DATA_READER_WATERMARK
            WHERE DATABASE_NAME = ?
              AND TABLE_NAME = ?
              AND WATERMARK_COLUMN = ?
            """;

        return jdbcTemplate.query(sql, rs -> {
            if (rs.next()) {
                return Optional.ofNullable(rs.getString("WATERMARK_VALUE"));
            }

            return Optional.empty();
        }, table.getDatabase(), table.getQualifiedTableName(), table.getWatermarkColumn());
    }

    @Override
    public void updateWatermark(TableReaderProperties table, Object watermarkValue) {
        JdbcTemplate jdbcTemplate = dataSourceRegistry.getJdbcTemplate(table.getDatabase());

        String value = watermarkValue == null ? null : watermarkValue.toString();

        String updateSql = """
            UPDATE DATA_READER_WATERMARK
            SET WATERMARK_VALUE = ?,
                WATERMARK_TYPE = ?,
                UPDATED_AT = CURRENT_TIMESTAMP
            WHERE DATABASE_NAME = ?
              AND TABLE_NAME = ?
              AND WATERMARK_COLUMN = ?
            """;

        int updated = jdbcTemplate.update(
            updateSql,
            value,
            table.getWatermarkType().name(),
            table.getDatabase(),
            table.getQualifiedTableName(),
            table.getWatermarkColumn()
        );

        if (updated == 0) {
            String insertSql = """
                INSERT INTO DATA_READER_WATERMARK (
                    DATABASE_NAME,
                    TABLE_NAME,
                    WATERMARK_COLUMN,
                    WATERMARK_TYPE,
                    WATERMARK_VALUE
                )
                VALUES (?, ?, ?, ?, ?)
                """;

            jdbcTemplate.update(
                insertSql,
                table.getDatabase(),
                table.getQualifiedTableName(),
                table.getWatermarkColumn(),
                table.getWatermarkType().name(),
                value
            );
        }
    }
}
```

