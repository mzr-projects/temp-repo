package com.acme.dbgateway.service;

import com.acme.dbgateway.crypto.CryptoService;
import com.acme.dbgateway.datasource.DataSourceRegistry;
import com.acme.dbgateway.dto.connection.ConnectionCreateRequest;
import com.acme.dbgateway.dto.connection.ConnectionResponse;
import com.acme.dbgateway.exception.NotFoundException;
import com.acme.dbgateway.model.ConnectionConfigDoc;
import com.acme.dbgateway.repository.ConnectionConfigRepository;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;
import java.sql.Connection;
import java.time.Instant;
import java.util.List;
import java.util.stream.StreamSupport;

@Service
public class ConnectionService {
    private final ConnectionConfigRepository repository;
    private final CryptoService cryptoService;
    private final DataSourceRegistry dataSourceRegistry;

    public ConnectionService(ConnectionConfigRepository repository, CryptoService cryptoService, DataSourceRegistry dataSourceRegistry) {
        this.repository = repository;
        this.cryptoService = cryptoService;
        this.dataSourceRegistry = dataSourceRegistry;
    }

    public ConnectionResponse create(ConnectionCreateRequest req) {
        ConnectionConfigDoc doc = new ConnectionConfigDoc();
        doc.setName(req.getName());
        doc.setDbType(req.getDbType());
        doc.setJdbcUrl(req.getJdbcUrl());
        doc.setUsername(req.getUsername());
        doc.setPasswordCipherText(cryptoService.encrypt(req.getPassword()));
        doc.setSchemaName(req.getSchemaName());
        doc.setOptions(req.getOptions());
        doc.setActive(true);
        doc.setCreatedAt(Instant.now());
        doc.setUpdatedAt(Instant.now());

        ConnectionConfigDoc saved = repository.save(doc);
        return toResponse(saved);
    }

    public List<ConnectionResponse> list() {
        return StreamSupport.stream(repository.findAll().spliterator(), false).map(this::toResponse).toList();
    }

    public ConnectionConfigDoc getDocOrThrow(String id) {
        return repository.findById(id).orElseThrow(() -> new NotFoundException("Connection not found: " + id));
    }

    public void delete(String id) {
        repository.deleteById(id);
        dataSourceRegistry.invalidate(id);
    }

    public boolean test(String id) {
        ConnectionConfigDoc cfg = getDocOrThrow(id);
        DataSource ds = dataSourceRegistry.getOrCreate(cfg);
        try (Connection c = ds.getConnection()) {
            return c.isValid(5);
        } catch (Exception e) {
            throw new RuntimeException("Connection test failed: " + e.getMessage(), e);
        }
    }

    private ConnectionResponse toResponse(ConnectionConfigDoc d) {
        ConnectionResponse r = new ConnectionResponse();
        r.setId(d.getId());
        r.setName(d.getName());
        r.setDbType(d.getDbType().name());
        r.setJdbcUrl(d.getJdbcUrl());
        r.setUsername(d.getUsername());
        r.setSchemaName(d.getSchemaName());
        r.setOptions(d.getOptions());
        r.setActive(d.getActive());
        r.setCreatedAt(d.getCreatedAt());
        r.setUpdatedAt(d.getUpdatedAt());
        return r;
    }
}
