package com.acme.dbgateway.query;

import com.acme.dbgateway.dto.query.FilterCriterion;
import com.acme.dbgateway.dto.query.Operator;
import com.acme.dbgateway.dto.query.QueryRequest;
import com.acme.dbgateway.dto.query.SortCriterion;
import com.acme.dbgateway.model.DbType;
import org.springframework.stereotype.Component;

import java.util.ArrayList;
import java.util.Collection;
import java.util.List;
import java.util.Set;
import java.util.stream.Collectors;

@Component
public class SqlBuilder {

    public SqlAndParams build(DbType dbType, QueryRequest req, Set<String> allowedColumns) {
        IdentifierValidator.validate(req.getTable());
        String schema = req.getSchema();
        if (schema != null && !schema.isBlank()) IdentifierValidator.validate(schema);

        List<Object> params = new ArrayList<>();
        String qTable = qualify(dbType, schema, req.getTable());

        List<String> selected = req.getSelect() == null || req.getSelect().isEmpty()
                ? new ArrayList<>(allowedColumns)
                : req.getSelect();

        for (String col : selected) {
            IdentifierValidator.validate(col);
            if (!allowedColumns.contains(col)) {
                throw new IllegalArgumentException("Unknown column in select: " + col);
            }
        }

        String selectSql = selected.stream().map(c -> quote(dbType, c)).collect(Collectors.joining(", "));
        StringBuilder sql = new StringBuilder("SELECT ").append(selectSql).append(" FROM ").append(qTable);

        if (req.getFilters() != null && !req.getFilters().isEmpty()) {
            List<String> clauses = new ArrayList<>();
            for (FilterCriterion f : req.getFilters()) {
                IdentifierValidator.validate(f.getField());
                if (!allowedColumns.contains(f.getField())) {
                    throw new IllegalArgumentException("Unknown filter column: " + f.getField());
                }
                String col = quote(dbType, f.getField());
                Operator op = f.getOp();

                switch (op) {
                    case EQ -> { clauses.add(col + " = ?"); params.add(f.getValue()); }
                    case NE -> { clauses.add(col + " <> ?"); params.add(f.getValue()); }
                    case GT -> { clauses.add(col + " > ?"); params.add(f.getValue()); }
                    case GTE -> { clauses.add(col + " >= ?"); params.add(f.getValue()); }
                    case LT -> { clauses.add(col + " < ?"); params.add(f.getValue()); }
                    case LTE -> { clauses.add(col + " <= ?"); params.add(f.getValue()); }
                    case IS_NULL -> clauses.add(col + " IS NULL");
                    case NOT_NULL -> clauses.add(col + " IS NOT NULL");
                    case CONTAINS -> { clauses.add("LOWER(" + col + ") LIKE ?"); params.add("%" + lower(f.getValue()) + "%"); }
                    case STARTS_WITH -> { clauses.add("LOWER(" + col + ") LIKE ?"); params.add(lower(f.getValue()) + "%"); }
                    case ENDS_WITH -> { clauses.add("LOWER(" + col + ") LIKE ?"); params.add("%" + lower(f.getValue())); }
                    case IN -> {
                        if (!(f.getValue() instanceof Collection<?> values) || values.isEmpty()) {
                            throw new IllegalArgumentException("IN requires a non-empty array");
                        }
                        String placeholders = values.stream().map(v -> "?").collect(Collectors.joining(","));
                        clauses.add(col + " IN (" + placeholders + ")");
                        params.addAll(values);
                    }
                    case BETWEEN -> {
                        if (!(f.getValue() instanceof List<?> l) || l.size() != 2) {
                            throw new IllegalArgumentException("BETWEEN requires array with exactly 2 items");
                        }
                        clauses.add(col + " BETWEEN ? AND ?");
                        params.add(l.get(0));
                        params.add(l.get(1));
                    }
                    default -> throw new IllegalArgumentException("Unsupported operator: " + op);
                }
            }
            sql.append(" WHERE ").append(String.join(" AND ", clauses));
        }

        boolean hasSort = req.getSort() != null && !req.getSort().isEmpty();
        if (hasSort) {
            List<String> sorts = new ArrayList<>();
            for (SortCriterion s : req.getSort()) {
                IdentifierValidator.validate(s.getField());
                if (!allowedColumns.contains(s.getField())) {
                    throw new IllegalArgumentException("Unknown sort column: " + s.getField());
                }
                String dir = "DESC".equalsIgnoreCase(s.getDir()) ? "DESC" : "ASC";
                sorts.add(quote(dbType, s.getField()) + " " + dir);
            }
            sql.append(" ORDER BY ").append(String.join(", ", sorts));
        }

        int limit = req.getLimit();
        int offset = req.getOffset();

        switch (dbType) {
            case POSTGRESQL -> sql.append(" LIMIT ").append(limit).append(" OFFSET ").append(offset);
            case ORACLE -> sql.append(" OFFSET ").append(offset).append(" ROWS FETCH NEXT ").append(limit).append(" ROWS ONLY");
            case SQLSERVER -> {
                if (!hasSort) sql.append(" ORDER BY (SELECT NULL)");
                sql.append(" OFFSET ").append(offset).append(" ROWS FETCH NEXT ").append(limit).append(" ROWS ONLY");
            }
        }

        return new SqlAndParams(sql.toString(), params);
    }

    private String qualify(DbType dbType, String schema, String table) {
        return (schema == null || schema.isBlank())
                ? quote(dbType, table)
                : quote(dbType, schema) + "." + quote(dbType, table);
    }

    private String quote(DbType dbType, String id) {
        return switch (dbType) {
            case POSTGRESQL, ORACLE -> "\"" + id + "\"";
            case SQLSERVER -> "[" + id + "]";
        };
    }

    private String lower(Object v) {
        return v == null ? "" : String.valueOf(v).toLowerCase();
    }
}
