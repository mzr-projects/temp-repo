package com.acme.dbgateway.service;

import com.acme.dbgateway.datasource.DataSourceRegistry;
import com.acme.dbgateway.dto.metadata.ColumnMetaResponse;
import com.acme.dbgateway.dto.query.QueryRequest;
import com.acme.dbgateway.dto.query.QueryResponse;
import com.acme.dbgateway.model.ConnectionConfigDoc;
import com.acme.dbgateway.query.SqlAndParams;
import com.acme.dbgateway.query.SqlBuilder;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;
import java.sql.ResultSetMetaData;
import java.util.*;

@Service
public class QueryService {
    private final ConnectionService connectionService;
    private final MetadataService metadataService;
    private final DataSourceRegistry dataSourceRegistry;
    private final SqlBuilder sqlBuilder;

    public QueryService(ConnectionService connectionService, MetadataService metadataService,
                        DataSourceRegistry dataSourceRegistry, SqlBuilder sqlBuilder) {
        this.connectionService = connectionService;
        this.metadataService = metadataService;
        this.dataSourceRegistry = dataSourceRegistry;
        this.sqlBuilder = sqlBuilder;
    }

    public QueryResponse run(String connectionId, QueryRequest req) {
        ConnectionConfigDoc cfg = connectionService.getDocOrThrow(connectionId);
        String schema = req.getSchema() != null ? req.getSchema() : cfg.getSchemaName();

        List<ColumnMetaResponse> columns = metadataService.columns(connectionId, schema, req.getTable());
        Set<String> allowed = new HashSet<>();
        for (ColumnMetaResponse c : columns) allowed.add(c.getName());

        SqlAndParams sap = sqlBuilder.build(cfg.getDbType(), req, allowed);
        DataSource ds = dataSourceRegistry.getOrCreate(cfg);

        List<Map<String, Object>> rows = new ArrayList<>();
        try (var conn = ds.getConnection();
             var ps = conn.prepareStatement(sap.sql())) {

            for (int i = 0; i < sap.params().size(); i++) {
                ps.setObject(i + 1, sap.params().get(i));
            }

            ps.setQueryTimeout(30);

            try (var rs = ps.executeQuery()) {
                ResultSetMetaData md = rs.getMetaData();
                int cols = md.getColumnCount();
                while (rs.next()) {
                    Map<String, Object> row = new LinkedHashMap<>();
                    for (int i = 1; i <= cols; i++) {
                        row.put(md.getColumnLabel(i), rs.getObject(i));
                    }
                    rows.add(row);
                }
            }
        } catch (Exception e) {
            throw new RuntimeException("Query execution failed: " + e.getMessage(), e);
        }

        return new QueryResponse(sap.sql(), rows);
    }
}
