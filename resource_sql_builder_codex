import com.acme.dbgateway.rdbms.RdbmsAdapterRegistry;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;
import java.sql.DatabaseMetaData;
import java.sql.ResultSet;
import java.util.ArrayList;
import java.util.List;

@Service
public class MetadataService {
    private final ConnectionService connectionService;
    private final DataSourceRegistry dataSourceRegistry;
    private final RdbmsAdapterRegistry adapterRegistry;

    public MetadataService(ConnectionService connectionService, DataSourceRegistry dataSourceRegistry, RdbmsAdapterRegistry adapterRegistry) {
        this.connectionService = connectionService;
        this.dataSourceRegistry = dataSourceRegistry;
        this.adapterRegistry = adapterRegistry;
    }

    public List<TableMetaResponse> tables(String connectionId, String schema) {
        ConnectionConfigDoc cfg = connectionService.getDocOrThrow(connectionId);
        DataSource ds = dataSourceRegistry.getOrCreate(cfg);
        RdbmsAdapter adapter = adapterRegistry.get(cfg.getDbType());
        String schemaPattern = adapter.normalizeSchema(schema != null ? schema : cfg.getSchemaName());

        List<TableMetaResponse> out = new ArrayList<>();
        try (var conn = ds.getConnection()) {
            DatabaseMetaData md = conn.getMetaData();
            try (ResultSet rs = md.getTables(conn.getCatalog(), schemaPattern, "%", new String[]{"TABLE", "VIEW"})) {
                while (rs.next()) {
                    TableMetaResponse t = new TableMetaResponse();
                    t.setSchema(rs.getString("TABLE_SCHEM"));
                    t.setName(rs.getString("TABLE_NAME"));
                    t.setType(rs.getString("TABLE_TYPE"));
                    out.add(t);
                }
            }
        } catch (Exception e) {
            throw new RuntimeException("Failed to list tables", e);
        }
        return out;
    }

    public List<ColumnMetaResponse> columns(String connectionId, String schema, String table) {
        ConnectionConfigDoc cfg = connectionService.getDocOrThrow(connectionId);
        DataSource ds = dataSourceRegistry.getOrCreate(cfg);
        RdbmsAdapter adapter = adapterRegistry.get(cfg.getDbType());
        String schemaPattern = adapter.normalizeSchema(schema != null ? schema : cfg.getSchemaName());

        List<ColumnMetaResponse> out = new ArrayList<>();
        try (var conn = ds.getConnection()) {
            DatabaseMetaData md = conn.getMetaData();
            try (ResultSet rs = md.getColumns(conn.getCatalog(), schemaPattern, table, "%")) {
                while (rs.next()) {
                    ColumnMetaResponse c = new ColumnMetaResponse();
                    c.setName(rs.getString("COLUMN_NAME"));
                    c.setDataType(rs.getString("TYPE_NAME"));
                    c.setSize(rs.getInt("COLUMN_SIZE"));
                    c.setNullable("YES".equalsIgnoreCase(rs.getString("IS_NULLABLE")));
                    out.add(c);
                }
            }
        } catch (Exception e) {
            throw new RuntimeException("Failed to list columns", e);
        }
        return out;
    }
}
