package com.acme.dbgateway.rdbms;

import com.acme.dbgateway.model.ConnectionConfigDoc;
import com.acme.dbgateway.model.DbType;
import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;
import org.springframework.stereotype.Component;

import javax.sql.DataSource;

public interface RdbmsAdapter {
    DbType type();
    String driverClassName();
    default String normalizeSchema(String schema) { return schema; }

    default DataSource createDataSource(ConnectionConfigDoc cfg, String plainPassword) {
        HikariConfig hc = new HikariConfig();
        hc.setDriverClassName(driverClassName());
        hc.setJdbcUrl(cfg.getJdbcUrl());
        hc.setUsername(cfg.getUsername());
        hc.setPassword(plainPassword);
        hc.setMaximumPoolSize(5);
        hc.setMinimumIdle(1);
        hc.setConnectionTimeout(10_000);
        hc.setValidationTimeout(5_000);
        hc.setPoolName("pool-" + cfg.getId());
        return new HikariDataSource(hc);
    }
}
