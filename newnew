package com.example.advisor;

import java.util.List;
import java.util.Map;

import org.springframework.ai.chat.client.ChatClientRequest;
import org.springframework.ai.chat.client.ChatClientResponse;
import org.springframework.ai.chat.client.advisor.api.CallAdvisor;
import org.springframework.ai.chat.client.advisor.api.CallAdvisorChain;
import org.springframework.ai.chat.client.advisor.tool.ToolCallingAdvisor;
import org.springframework.ai.chat.messages.AssistantMessage;
import org.springframework.ai.chat.model.ChatResponse;
import org.springframework.ai.chat.model.Generation;

public class NoToolCalledFallbackAdvisor implements CallAdvisor {

    private static final String TOOL_CALLED_KEY = "noToolFallback.toolWasCalled";

    private final String fallbackMessage;

    public NoToolCalledFallbackAdvisor(String fallbackMessage) {
        this.fallbackMessage = fallbackMessage;
    }

    @Override
    public String getName() {
        return "NoToolCalledFallbackAdvisor";
    }

    @Override
    public int getOrder() {
        // Must sit AFTER ToolCallingAdvisor so we're re-invoked on every loop iteration,
        // not just once around the whole exchange.
        return ToolCallingAdvisor.DEFAULT_ORDER + 100;
    }

    @Override
    public ChatClientResponse adviseCall(ChatClientRequest request, CallAdvisorChain chain) {
        Map<String, Object> context = request.context(); // shared mutable map across the chain

        ChatClientResponse response = chain.nextCall(request);
        ChatResponse chatResponse = response.chatResponse();

        if (chatResponse != null && chatResponse.hasToolCalls()) {
            // a tool call was requested on this iteration — remember it, let the loop continue
            context.put(TOOL_CALLED_KEY, Boolean.TRUE);
            return response;
        }

        // No tool call in THIS response — either it's the only iteration (never called a tool)
        // or it's the follow-up answer after a tool already ran.
        boolean toolWasCalled = Boolean.TRUE.equals(context.get(TOOL_CALLED_KEY));
        if (!toolWasCalled) {
            return withFallbackMessage(response);
        }

        return response;
    }

    private ChatClientResponse withFallbackMessage(ChatClientResponse original) {
        ChatResponse fallback = new ChatResponse(
                List.of(new Generation(new AssistantMessage(fallbackMessage))));
        return ChatClientResponse.builder()
                .chatResponse(fallback)
                .context(original.context())
                .build();
    }
}