├── controller/
│   └── AnalysisController.java
├── service/
│   ├── SalesApiClient.java
│   └── MapReduceAnalysisService.java
├── model/
│   ├── SalesRecord.java
│   └── ChunkAnalysis.java
└── config/
    └── AiConfig.java
```

