## 4. The map-reduce service (the heart of it)

```java
// service/MapReduceAnalysisService.java
@Service
public class MapReduceAnalysisService {

    private static final Logger log = LoggerFactory.getLogger(MapReduceAnalysisService.class);

    private final ChatClient chatClient;
    private final SalesApiClient salesApiClient;
    private final ExecutorService analysisExecutor;
    private final ObjectMapper objectMapper;

    @Value("${analysis.chunk-size:200}")
    private int chunkSize;

    @Value("${analysis.max-parallel-calls:4}")
    private int maxParallelCalls;

    public MapReduceAnalysisService(ChatClient chatClient,
                                    SalesApiClient salesApiClient,
                                    ExecutorService analysisExecutor,
                                    ObjectMapper objectMapper) {
        this.chatClient = chatClient;
        this.salesApiClient = salesApiClient;
        this.analysisExecutor = analysisExecutor;
        this.objectMapper = objectMapper;
    }

    /**
     * Entry point: fetch -> chunk -> map (parallel) -> reduce -> markdown report.
     */
    public String analyzeSalesData(String from, String to, String userQuestion) {
        // 1. FETCH
        List<SalesRecord> allRecords = salesApiClient.fetchSalesData(from, to);
        log.info("Fetched {} records", allRecords.size());

        if (allRecords.isEmpty()) {
            return "## Analysis Report\n\nNo data found for the given period.";
        }

        // 2. CHUNK
        List<List<SalesRecord>> chunks = partition(allRecords, chunkSize);
        log.info("Split into {} chunks of up to {} records", chunks.size(), chunkSize);

        // 3. MAP — analyze each chunk in parallel (bounded)
        List<ChunkAnalysis> partials = mapPhase(chunks, userQuestion);

        // 4. REDUCE — merge partial analyses into the final markdown report
        return reducePhase(partials, userQuestion, allRecords.size(), from, to);
    }

    // ---------- MAP PHASE ----------

    private List<ChunkAnalysis> mapPhase(List<List<SalesRecord>> chunks, String userQuestion) {
        Semaphore rateLimiter = new Semaphore(maxParallelCalls);

        List<CompletableFuture<ChunkAnalysis>> futures = new ArrayList<>();
        for (int i = 0; i < chunks.size(); i++) {
            final int chunkIndex = i;
            final List<SalesRecord> chunk = chunks.get(i);

            futures.add(CompletableFuture.supplyAsync(() -> {
                try {
                    rateLimiter.acquire();
                    return analyzeChunk(chunkIndex, chunk, userQuestion);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    throw new IllegalStateException("Chunk analysis interrupted", e);
                } finally {
                    rateLimiter.release();
                }
            }, analysisExecutor));
        }

        return futures.stream()
                .map(CompletableFuture::join)
                .sorted(Comparator.comparingInt(ChunkAnalysis::chunkIndex))
                .toList();
    }

    private ChunkAnalysis analyzeChunk(int chunkIndex, List<SalesRecord> chunk, String userQuestion) {
        String chunkData = toCompactCsv(chunk);   // CSV = ~40-50% fewer tokens than JSON

        String partialAnalysis = chatClient.prompt()
                .system("""
                        You are a data analyst performing a PARTIAL analysis of one \
                        chunk of a larger dataset. Other chunks are analyzed separately \
                        and your output will later be merged.

                        Extract from this chunk ONLY:
                        - Key numeric facts: totals, counts, min/max, averages
                        - Top items (products, regions, categories) with their figures
                        - Notable anomalies or outliers
                        - Anything specifically relevant to the user's question

                        Be terse and factual. Use plain bullet points with concrete \
                        numbers. Do NOT write introductions, conclusions, or \
                        recommendations — that happens in the merge step.
                        """)
                .user(u -> u.text("""
                        User's question: {question}

                        Chunk {index} data (CSV):
                        {data}
                        """)
                        .param("question", userQuestion)
                        .param("index", chunkIndex + 1)
                        .param("data", chunkData))
                .call()
                .content();

        log.debug("Chunk {} analyzed ({} records)", chunkIndex, chunk.size());
        return new ChunkAnalysis(chunkIndex, chunk.size(), partialAnalysis);
    }

    // ---------- REDUCE PHASE ----------

    private String reducePhase(List<ChunkAnalysis> partials, String userQuestion,
                               int totalRecords, String from, String to) {
        String combinedPartials = partials.stream()
                .map(p -> "### Partial analysis — chunk %d (%d records)%n%s"
                        .formatted(p.chunkIndex() + 1, p.recordCount(), p.analysis()))
                .collect(Collectors.joining("\n\n---\n\n"));

        return chatClient.prompt()
                .system("""
                        You are a senior data analyst. You are given partial analyses \
                        of chunks from a single large dataset. Merge them into ONE \
                        coherent final report.

                        Rules:
                        - Aggregate figures across chunks where possible (sum totals, \
                          recompute overall top lists, weight averages by record count)
                        - Resolve contradictions by preferring majority evidence
                        - Never mention "chunks" or the merging process in your output

                        Format the ENTIRE response as Markdown:
                        - ## Summary — 3-5 sentence executive overview
                        - ## Key Metrics — a Markdown table
                        - ## Detailed Findings — grouped bullet points
                        - ## Anomalies — if any were found
                        - ## Recommendations — actionable next steps
                        """)
                .user(u -> u.text("""
                        User's question: {question}
                        Dataset: {total} sales records, period {from} to {to}.

                        Partial analyses to merge:

                        {partials}
                        """)
                        .param("question", userQuestion)
                        .param("total", totalRecords)
                        .param("from", from)
                        .param("to", to)
                        .param("partials", combinedPartials))
                .call()
                .content();
    }

    // ---------- HELPERS ----------

    private static <T> List<List<T>> partition(List<T> list, int size) {
        List<List<T>> parts = new ArrayList<>();
        for (int i = 0; i < list.size(); i += size) {
            parts.add(list.subList(i, Math.min(i + size, list.size())));
        }
        return parts;
    }

    /** Compact CSV serialization — dramatically cheaper in tokens than JSON. */
    private String toCompactCsv(List<SalesRecord> records) {
        StringBuilder sb = new StringBuilder("orderId,product,category,region,amount,orderDate\n");
        for (SalesRecord r : records) {
            sb.append(r.orderId()).append(',')
              .append(escape(r.product())).append(',')
              .append(escape(r.category())).append(',')
              .append(r.region()).append(',')
              .append(r.amount()).append(',')
              .append(r.orderDate()).append('\n');
        }
        return sb.toString();
    }

    private String escape(String value) {
        return value != null && value.contains(",") ? "\"" + value + "\"" : value;
    }
}
```

