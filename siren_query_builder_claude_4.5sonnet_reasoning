## 5. General Query Builder Service

```java
@Service
@Slf4j
public class QueryBuilderService {
    
    private final SirenJoinBuilder sirenJoinBuilder;
    
    public QueryBuilderService(SirenJoinBuilder sirenJoinBuilder) {
        this.sirenJoinBuilder = sirenJoinBuilder;
    }
    
    public SearchRequest buildSearchRequest(QueryRequest queryRequest) {
        SearchRequest searchRequest = new SearchRequest(queryRequest.getBaseIndex());
        SearchSourceBuilder sourceBuilder = new SearchSourceBuilder();
        
        // Build query with filters and joins
        BoolQueryBuilder mainQuery = QueryBuilders.boolQuery();
        
        // Add filters
        if (queryRequest.getFilters() != null && !queryRequest.getFilters().isEmpty()) {
            addFiltersToQuery(mainQuery, queryRequest.getFilters());
        }
        
        // Add Siren joins
        if (queryRequest.getJoins() != null && !queryRequest.getJoins().isEmpty()) {
            addJoinsToQuery(mainQuery, queryRequest.getJoins());
        }
        
        sourceBuilder.query(mainQuery);
        
        // Add aggregations
        if (queryRequest.getAggregations() != null && !queryRequest.getAggregations().isEmpty()) {
            addAggregations(sourceBuilder, queryRequest.getAggregations());
        }
        
        // Add pagination
        if (queryRequest.getFrom() != null) {
            sourceBuilder.from(queryRequest.getFrom());
        }
        if (queryRequest.getSize() != null) {
            sourceBuilder.size(queryRequest.getSize());
        }
        
        // Add source fields
        if (queryRequest.getSourceFields() != null && !queryRequest.getSourceFields().isEmpty()) {
            sourceBuilder.fetchSource(
                queryRequest.getSourceFields().toArray(new String[0]), 
                null
            );
        }
        
        // Add sorting
        if (queryRequest.getSort() != null) {
            addSorting(sourceBuilder, queryRequest.getSort());
        }
        
        searchRequest.source(sourceBuilder);
        log.info("Built search request: {}", sourceBuilder.toString());
        
        return searchRequest;
    }
    
    private void addFiltersToQuery(BoolQueryBuilder mainQuery, List<FilterCondition> filters) {
        for (FilterCondition filter : filters) {
            QueryBuilder filterQuery = buildFilterQuery(filter);
            
            BoolType boolType = filter.getBoolType() != null ? filter.getBoolType() : BoolType.MUST;
            
            switch (boolType) {
                case MUST:
                    mainQuery.must(filterQuery);
                    break;
                case SHOULD:
                    mainQuery.should(filterQuery);
                    break;
                case MUST_NOT:
                    mainQuery.mustNot(filterQuery);
                    break;
                case FILTER:
                    mainQuery.filter(filterQuery);
                    break;
            }
        }
    }
    
    private QueryBuilder buildFilterQuery(FilterCondition filter) {
        switch (filter.getType()) {
            case TERM:
                return QueryBuilders.termQuery(filter.getField(), filter.getValue());
                
            case MATCH:
                return QueryBuilders.matchQuery(filter.getField(), filter.getValue());
                
            case MATCH_PHRASE:
                return QueryBuilders.matchPhraseQuery(filter.getField(), filter.getValue());
                
            case RANGE:
                RangeQueryBuilder rangeQuery = QueryBuilders.rangeQuery(filter.getField());
                if (filter.getValue() instanceof Map) {
                    Map<String, Object> rangeParams = (Map<String, Object>) filter.getValue();
                    if (rangeParams.containsKey("gte")) {
                        rangeQuery.gte(rangeParams.get("gte"));
                    }
                    if (rangeParams.containsKey("lte")) {
                        rangeQuery.lte(rangeParams.get("lte"));
                    }
                    if (rangeParams.containsKey("gt")) {
                        rangeQuery.gt(rangeParams.get("gt"));
                    }
                    if (rangeParams.containsKey("lt")) {
                        rangeQuery.lt(rangeParams.get("lt"));
                    }
                }
                return rangeQuery;
                
            case WILDCARD:
                return QueryBuilders.wildcardQuery(filter.getField(), filter.getValue().toString());
                
            case EXISTS:
                return QueryBuilders.existsQuery(filter.getField());
                
            case BOOL:
                BoolQueryBuilder boolQuery = QueryBuilders.boolQuery();
                if (filter.getNestedConditions() != null) {
                    addFiltersToQuery(boolQuery, filter.getNestedConditions());
                }
                return boolQuery;
                
            case TERMS:
                if (filter.getValue() instanceof List) {
                    return QueryBuilders.termsQuery(filter.getField(), (List<?>) filter.getValue());
                }
                return QueryBuilders.termsQuery(filter.getField(), filter.getValue());
                
            case PREFIX:
                return QueryBuilders.prefixQuery(filter.getField(), filter.getValue().toString());
                
            case NESTED:
                BoolQueryBuilder nestedBoolQuery = QueryBuilders.boolQuery();
                if (filter.getNestedConditions() != null) {
                    addFiltersToQuery(nestedBoolQuery, filter.getNestedConditions());
                }
                return QueryBuilders.nestedQuery(filter.getField(), nestedBoolQuery, ScoreMode.None);
                
            default:
                return QueryBuilders.matchAllQuery();
        }
    }
    
    private void addJoinsToQuery(BoolQueryBuilder mainQuery, List<JoinConfig> joins) {
        for (JoinConfig join : joins) {
            Map<String, Object> sirenJoin = sirenJoinBuilder.buildSirenJoinMap(join);
            
            // Create wrapper query for Siren join
            WrapperQueryBuilder wrapperQuery = QueryBuilders.wrapperQuery(
                toJson(sirenJoin)
            );
            
            mainQuery.filter(wrapperQuery);
            
            // Handle nested joins recursively
            if (join.getNestedJoins() != null && !join.getNestedJoins().isEmpty()) {
                addJoinsToQuery(mainQuery, join.getNestedJoins());
            }
        }
    }
    
    private void addAggregations(SearchSourceBuilder sourceBuilder, List<AggregationConfig> aggregations) {
        for (AggregationConfig aggConfig : aggregations) {
            AggregationBuilder aggBuilder = buildAggregation(aggConfig);
            if (aggBuilder != null) {
                sourceBuilder.aggregation(aggBuilder);
            }
        }
    }
    
    private AggregationBuilder buildAggregation(AggregationConfig config) {
        AggregationBuilder aggBuilder = null;
        
        switch (config.getType()) {
            case TERMS:
                TermsAggregationBuilder termsAgg = AggregationBuilders.terms(config.getName())
                    .field(config.getField());
                if (config.getSize() != null) {
                    termsAgg.size(config.getSize());
                }
                aggBuilder = termsAgg;
                break;
                
            case DATE_HISTOGRAM:
                DateHistogramAggregationBuilder dateHistAgg = AggregationBuilders
                    .dateHistogram(config.getName())
                    .field(config.getField());
                
                if (config.getParameters() != null) {
                    if (config.getParameters().containsKey("interval")) {
                        dateHistAgg.fixedInterval(
                            new DateHistogramInterval(config.getParameters().get("interval").toString())
                        );
                    }
                    if (config.getParameters().containsKey("format")) {
                        dateHistAgg.format(config.getParameters().get("format").toString());
                    }
                }
                aggBuilder = dateHistAgg;
                break;
                
            case SUM:
                aggBuilder = AggregationBuilders.sum(config.getName()).field(config.getField());
                break;
                
            case AVG:
                aggBuilder = AggregationBuilders.avg(config.getName()).field(config.getField());
                break;
                
            case MAX:
                aggBuilder = AggregationBuilders.max(config.getName()).field(config.getField());
                break;
                
            case MIN:
                aggBuilder = AggregationBuilders.min(config.getName()).field(config.getField());
                break;
                
            case CARDINALITY:
                aggBuilder = AggregationBuilders.cardinality(config.getName()).field(config.getField());
                break;
                
            case STATS:
                aggBuilder = AggregationBuilders.stats(config.getName()).field(config.getField());
                break;
                
            case EXTENDED_STATS:
                aggBuilder = AggregationBuilders.extendedStats(config.getName()).field(config.getField());
                break;
                
            case PERCENTILES:
                aggBuilder = AggregationBuilders.percentiles(config.getName()).field(config.getField());
                break;
        }
        
        // Add sub-aggregations
        if (aggBuilder != null && config.getSubAggregations() != null) {
            for (AggregationConfig subAgg : config.getSubAggregations()) {
                AggregationBuilder subAggBuilder = buildAggregation(subAgg);
                if (subAggBuilder != null) {
                    aggBuilder.subAggregation(subAggBuilder);
                }
            }
        }
        
        return aggBuilder;
    }
    
    private void addSorting(SearchSourceBuilder sourceBuilder, SortConfig sortConfig) {
        if (sortConfig.getField() != null) {
            sourceBuilder.sort(
                sortConfig.getField(), 
                sortConfig.getOrder() == SortOrder.ASC ? 
                    org.elasticsearch.search.sort.SortOrder.ASC : 
                    org.elasticsearch.search.sort.SortOrder.DESC
            );
        }
    }
    
    private String toJson(Object obj) {
        try {
            ObjectMapper mapper = new ObjectMapper();
            return mapper.writeValueAsString(obj);
        } catch (Exception e) {
            log.error("Error converting to JSON", e);
            return "{}";
        }
    }
}

@Data
@Builder
class SortConfig {
    private String field;
    private SortOrder order;
}

enum SortOrder {
    ASC, DESC
}
```

## 6. Elasticsearch Service

```java
@Service
@Slf4j
public class ElasticsearchService {
    
    private final RestHighLevelClient client;
    private final QueryBuilderService queryBuilderService;
    
    public ElasticsearchService(RestHighLevelClient client, 
                                QueryBuilderService queryBuilderService) {
        this.client = client;
        this.queryBuilderService = queryBuilderService;
    }
    
    public SearchResponse executeSearch(QueryRequest queryRequest) throws IOException {
        SearchRequest searchRequest = queryBuilderService.buildSearchRequest(queryRequest);
        
        org.elasticsearch.action.search.SearchResponse response = 
            client.search(searchRequest, RequestOptions.DEFAULT);
        
        return convertResponse(response);
    }
    
    private SearchResponse convertResponse(org.elasticsearch.action.search.SearchResponse esResponse) {
        SearchResponse response = new SearchResponse();
        response.setTotalHits(esResponse.getHits().getTotalHits().value);
        response.setMaxScore(esResponse.getHits().getMaxScore());
        
        List<Map<String, Object>> hits = new ArrayList<>();
        for (SearchHit hit : esResponse.getHits().getHits()) {
            Map<String, Object> source = new HashMap<>(hit.getSourceAsMap());
            source.put("_id", hit.getId());
            source.put("_score", hit.getScore());
            hits.add(source);
        }
        response.setHits(hits);
        
        // Process aggregations
        if (esResponse.getAggregations() != null) {
            Map<String, Object> aggregations = processAggregations(esResponse.getAggregations());
            response.setAggregations(aggregations);
        }
        
        return response;
    }
    
    private Map<String, Object> processAggregations(Aggregations aggregations) {
        Map<String, Object> result = new HashMap<>();
        
        for (Aggregation agg : aggregations) {
            if (agg instanceof Terms) {
                result.put(agg.getName(), processTermsAggregation((Terms) agg));
            } else if (agg instanceof ParsedDateHistogram) {
                result.put(agg.getName(), processDateHistogram((ParsedDateHistogram) agg));
            } else if (agg instanceof NumericMetricsAggregation.SingleValue) {
                result.put(agg.getName(), 
                    ((NumericMetricsAggregation.SingleValue) agg).value());
            }
            // Add more aggregation type processors as needed
        }
        
        return result;
    }
    
    private Map<String, Object> processTermsAggregation(Terms terms) {
        Map<String, Object> result = new HashMap<>();
        List<Map<String, Object>> buckets = new ArrayList<>();
        
        for (Terms.Bucket bucket : terms.getBuckets()) {
            Map<String, Object> bucketData = new HashMap<>();
            bucketData.put("key", bucket.getKeyAsString());
            bucketData.put("doc_count", bucket.getDocCount());
            
            if (bucket.getAggregations() != null && bucket.getAggregations().asList().size() > 0) {
                bucketData.put("sub_aggregations", 
                    processAggregations(bucket.getAggregations()));
            }
            
            buckets.add(bucketData);
        }
        
        result.put("buckets", buckets);
        return result;
    }
    
    private Map<String, Object> processDateHistogram(ParsedDateHistogram dateHist) {
        Map<String, Object> result = new HashMap<>();
        List<Map<String, Object>> buckets = new ArrayList<>();
        
        for (Histogram.Bucket bucket : dateHist.getBuckets()) {
            Map<String, Object> bucketData = new HashMap<>();
            bucketData.put("key", bucket.getKeyAsString());
            bucketData.put("doc_count", bucket.getDocCount());
            
            if (bucket.getAggregations() != null && bucket.getAggregations().asList().size() > 0) {
                bucketData.put("sub_aggregations", 
                    processAggregations(bucket.getAggregations()));
            }
            
            buckets.add(bucketData);
        }
        
        result.put("buckets", buckets);
        return result;
    }
}

@Data
class SearchResponse {
    private long totalHits;
    private Float maxScore;
    private List<Map<String, Object>> hits;
    private Map<String, Object> aggregations;
}
```

## 7. REST Controller

```java
@RestController
@RequestMapping("/api/search")
@Slf4j
public class SearchController {
    
    private final ElasticsearchService elasticsearchService;
    
    public SearchController(ElasticsearchService elasticsearchService) {
        this.elasticsearchService = elasticsearchService;
    }
    
    @PostMapping("/query")
    public ResponseEntity<SearchResponse> search(@RequestBody QueryRequest queryRequest) {
        try {
            log.info("Received search request: {}", queryRequest);
            SearchResponse response = elasticsearchService.executeSearch(queryRequest);
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            log.error("Error executing search", e);
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build();
        }
    }
}
