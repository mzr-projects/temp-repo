## 4. Siren Join Builder

```java
@Service
@Slf4j
public class SirenJoinBuilder {
    
    public String buildSirenJoin(JoinConfig joinConfig) {
        StringBuilder joinQuery = new StringBuilder();
        
        joinQuery.append("{\n");
        joinQuery.append("  \"filterjoin\": {\n");
        joinQuery.append(String.format("    \"%s\": {\n", joinConfig.getSourceField()));
        joinQuery.append("      \"query\": {\n");
        
        // Build target query with filters
        if (joinConfig.getTargetFilters() != null && !joinConfig.getTargetFilters().isEmpty()) {
            joinQuery.append(buildFilterQuery(joinConfig.getTargetFilters()));
        } else {
            joinQuery.append("        \"match_all\": {}\n");
        }
        
        joinQuery.append("      },\n");
        joinQuery.append(String.format("      \"indices\": [\"%s\"],\n", joinConfig.getTargetIndex()));
        joinQuery.append(String.format("      \"path\": \"%s\"\n", joinConfig.getTargetField()));
        joinQuery.append("    }\n");
        joinQuery.append("  }\n");
        joinQuery.append("}\n");
        
        return joinQuery.toString();
    }
    
    public Map<String, Object> buildSirenJoinMap(JoinConfig joinConfig) {
        Map<String, Object> filterJoin = new HashMap<>();
        Map<String, Object> joinDetails = new HashMap<>();
        
        // Build target query
        Map<String, Object> query = new HashMap<>();
        if (joinConfig.getTargetFilters() != null && !joinConfig.getTargetFilters().isEmpty()) {
            query.put("bool", buildBoolQuery(joinConfig.getTargetFilters()));
        } else {
            query.put("match_all", new HashMap<>());
        }
        
        joinDetails.put("query", query);
        joinDetails.put("indices", Collections.singletonList(joinConfig.getTargetIndex()));
        joinDetails.put("path", joinConfig.getTargetField());
        
        filterJoin.put(joinConfig.getSourceField(), joinDetails);
        
        return Collections.singletonMap("filterjoin", filterJoin);
    }
    
    private String buildFilterQuery(List<FilterCondition> filters) {
        // Build complex filter query
        StringBuilder query = new StringBuilder();
        query.append("        \"bool\": {\n");
        query.append("          \"must\": [\n");
        
        for (int i = 0; i < filters.size(); i++) {
            FilterCondition filter = filters.get(i);
            query.append(buildSingleFilter(filter));
            if (i < filters.size() - 1) {
                query.append(",\n");
            }
        }
        
        query.append("\n          ]\n");
        query.append("        }\n");
        
        return query.toString();
    }
    
    private Map<String, Object> buildBoolQuery(List<FilterCondition> filters) {
        Map<String, Object> bool = new HashMap<>();
        Map<String, List<Map<String, Object>>> clauses = new HashMap<>();
        
        clauses.put("must", new ArrayList<>());
        clauses.put("should", new ArrayList<>());
        clauses.put("must_not", new ArrayList<>());
        clauses.put("filter", new ArrayList<>());
        
        for (FilterCondition filter : filters) {
            BoolType boolType = filter.getBoolType() != null ? filter.getBoolType() : BoolType.MUST;
            String clauseType = boolType.name().toLowerCase();
            clauses.get(clauseType).add(buildFilterMap(filter));
        }
        
        // Add non-empty clauses to bool query
        clauses.forEach((key, value) -> {
            if (!value.isEmpty()) {
                bool.put(key, value);
            }
        });
        
        return bool;
    }
    
    private Map<String, Object> buildFilterMap(FilterCondition filter) {
        Map<String, Object> filterMap = new HashMap<>();
        
        switch (filter.getType()) {
            case TERM:
                filterMap.put("term", Collections.singletonMap(filter.getField(), filter.getValue()));
                break;
            case MATCH:
                filterMap.put("match", Collections.singletonMap(filter.getField(), filter.getValue()));
                break;
            case RANGE:
                filterMap.put("range", Collections.singletonMap(filter.getField(), filter.getValue()));
                break;
            case WILDCARD:
                filterMap.put("wildcard", Collections.singletonMap(filter.getField(), filter.getValue()));
                break;
            case EXISTS:
                filterMap.put("exists", Collections.singletonMap("field", filter.getField()));
                break;
            case BOOL:
                if (filter.getNestedConditions() != null) {
                    filterMap.put("bool", buildBoolQuery(filter.getNestedConditions()));
                }
                break;
            case TERMS:
                filterMap.put("terms", Collections.singletonMap(filter.getField(), filter.getValue()));
                break;
        }
        
        return filterMap;
    }
    
    private String buildSingleFilter(FilterCondition filter) {
        return String.format("            { \"%s\": { \"%s\": \"%s\" } }", 
            filter.getType().name().toLowerCase(), 
            filter.getField(), 
            filter.getValue());
    }
}
