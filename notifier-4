## 3. Concrete handlers – each topic picks its flow

```java
// Topic 1: needs Redis lookup + per-entry API calls
@Component
public class LoanRequestHandler extends NationalCodeLookupHandler<LoanRequestEvent> {
    private final ResilientApiClient api;

    public LoanRequestHandler(NationalCodeLookup lookup, ResilientApiClient api) { super(lookup); this.api = api; }

    @Override public String topic() { return "loan.requests"; }
    @Override public Class<LoanRequestEvent> payloadType() { return LoanRequestEvent.class; }
    @Override protected String extractNationalCode(LoanRequestEvent p) { return p.applicant().nationalCode(); }
    @Override protected boolean accepts(RedisEntry e) { return e.key().startsWith("customer:"); }

    @Override
    protected Mono<Void> onMatchedEntry(LoanRequestEvent p, String nc, RedisEntry e, MessageContext ctx) {
        return api.post("loan-api", "/loans/flag", new FlagRequest(p.requestId(), nc, e.key(), e.value()),
                        Map.of("Idempotency-Key", ctx.idempotencyKey() + ":" + e.key()));
    }
}
```

```java
// Topic 2: no Redis – just forward to an API
@Component
public class PaymentEventHandler extends DirectApiHandler<PaymentEvent, PaymentNotification> {

    public PaymentEventHandler(ResilientApiClient api) { super(api); }

    @Override public String topic() { return "payments.completed"; }
    @Override public Class<PaymentEvent> payloadType() { return PaymentEvent.class; }
    @Override protected String apiName() { return "payment-api"; }
    @Override protected String uri(PaymentEvent p) { return "/payments/" + p.paymentId() + "/notify"; }
    @Override protected boolean shouldCall(PaymentEvent p) { return p.amount().compareTo(BigDecimal.valueOf(1000)) > 0; }
    @Override protected PaymentNotification toRequest(PaymentEvent p, MessageContext ctx) {
        return new PaymentNotification(p.paymentId(), p.nationalCode(), p.amount());
    }
}
