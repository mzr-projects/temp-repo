```java
// Topic 4: fully custom flow – implement the interface directly
@Component
@RequiredArgsConstructor
public class FraudAlertHandler implements TopicHandler<FraudAlert> {
    private final ReactiveStringRedisTemplate redis;
    private final ResilientApiClient api;
    private final KafkaSender<String, byte[]> sender;

    @Override public String topic() { return "fraud.alerts"; }
    @Override public Class<FraudAlert> payloadType() { return FraudAlert.class; }

    @Override
    public Mono<Void> handle(FraudAlert a, MessageContext ctx) {
        // 1. block the customer in Redis, 2. call API, 3. emit an audit event – all in one flow
        return redis.opsForValue().set("blocked:" + a.nationalCode(), "1", Duration.ofHours(24))
            .then(api.post("fraud-api", "/fraud/block", a, Map.of("Idempotency-Key", ctx.idempotencyKey())))
            .then(forward("audit.events", ctx.key(), a));
    }
}
```

