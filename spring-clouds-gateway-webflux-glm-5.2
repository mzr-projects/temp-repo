## 12. Fallback Controller (for Circuit Breaker)

Create a simple reactive controller to serve fallback responses:

```java
package com.example.gateway.handler;

import com.example.gateway.model.ErrorResponse;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.server.ServerWebExchange;
import reactor.core.publisher.Mono;

import java.time.Instant;
import java.util.UUID;

@RestController
public class FallbackController {

    @GetMapping("/fallback/user-service")
    public Mono<ErrorResponse> userFallback(ServerWebExchange exchange) {
        return buildFallback(exchange, "User Service is currently unavailable");
    }

    @GetMapping("/fallback/order-service")
    public Mono<ErrorResponse> orderFallback(ServerWebExchange exchange) {
        return buildFallback(exchange, "Order Service is currently unavailable");
    }

    @GetMapping("/fallback/payment-service")
    public Mono<ErrorResponse> paymentFallback(ServerWebExchange exchange) {
        return buildFallback(exchange, "Payment Service is currently unavailable");
    }

    @GetMapping("/fallback/inventory-service")
    public Mono<ErrorResponse> inventoryFallback(ServerWebExchange exchange) {
        return buildFallback(exchange, "Inventory Service is currently unavailable");
    }

    private Mono<ErrorResponse> buildFallback(ServerWebExchange exchange, String message) {
        exchange.getResponse().setStatusCode(HttpStatus.SERVICE_UNAVAILABLE);
        exchange.getResponse().getHeaders().setContentType(MediaType.APPLICATION_JSON);
        return Mono.just(new ErrorResponse(
                UUID.randomUUID().toString(),
                Instant.now().toString(),
                503,
                "Service Unavailable",
                message,
                exchange.getRequest().getURI().getPath()
        ));
    }
}
```

