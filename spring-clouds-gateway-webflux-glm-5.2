## 6. Rate Limiter Configuration

**`config/RateLimiterConfig.java`**

```java
package com.example.gateway.config;

import org.springframework.cloud.gateway.filter.ratelimit.KeyResolver;
import org.springframework.cloud.gateway.filter.ratelimit.RedisRateLimiter;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.context.annotation.Primary;
import reactor.core.publisher.Mono;

@Configuration
public class RateLimiterConfig {

    /**
     * Default Redis-backed rate limiter.
     * replenishRate = tokens/sec, burstCapacity = max tokens.
     */
    @Bean
    @Primary
    public RedisRateLimiter defaultRedisRateLimiter() {
        return new RedisRateLimiter(20, 40, 1); // replenishRate=20, burstCapacity=40
    }

    /**
     * Per-user rate limiter key resolver.
     * Falls back to client IP when JWT principal is not available.
     */
    @Bean
    @Primary
    public KeyResolver userKeyResolver() {
        return exchange -> {
            var principal = exchange.getPrincipal();
            return principal
                    .map(p -> {
                        if (p instanceof org.springframework.security.oauth2.server.resource.authentication.JwtAuthenticationToken jwtAuth) {
                            return jwtAuth.getToken().getSubject(); // "sub" claim
                        }
                        return p.getName();
                    })
                    .switchIfEmpty(Mono.just(
                            exchange.getRequest().getRemoteAddress() != null
                                    ? exchange.getRequest().getRemoteAddress().getAddress().getHostAddress()
                                    : "anonymous"
                    ));
        };
    }
}
