## 8. Global Filters

### 8a. Request/Response Logging Filter

**`filter/RequestLoggingFilter.java`**

```java
package com.example.gateway.filter;

import lombok.extern.slf4j.Slf4j;
import org.springframework.cloud.gateway.filter.GatewayFilterChain;
import org.springframework.cloud.gateway.filter.GlobalFilter;
import org.springframework.core.Ordered;
import org.springframework.stereotype.Component;
import org.springframework.web.server.ServerWebExchange;
import reactor.core.publisher.Mono;

import java.util.UUID;

@Slf4j
@Component
public class RequestLoggingFilter implements GlobalFilter, Ordered {

    private static final String TRACE_ID = "X-Trace-Id";
    private static final String REQUEST_ID = "X-Request-Id";

    @Override
    public Mono<Void> filter(ServerWebExchange exchange, GatewayFilterChain chain) {
        long startTime = System.currentTimeMillis();
        String traceId = getOrGenerate(exchange, TRACE_ID);
        String requestId = getOrGenerate(exchange, REQUEST_ID);

        // Inject trace/request IDs into downstream request
        exchange.getRequest().mutate()
                .header(TRACE_ID, traceId)
                .header(REQUEST_ID, requestId)
                .build();

        log.info("[{}] → {} {} | Host: {} | Query: {}",
                traceId,
                exchange.getRequest().getMethod(),
                exchange.getRequest().getURI().getPath(),
                exchange.getRequest().getURI().getHost(),
                exchange.getRequest().getURI().getQuery());

        return chain.filter(exchange)
                .doOnSuccess(aVoid -> {
                    long duration = System.currentTimeMillis() - startTime;
                    log.info("[{}] ← {} | Status: {} | Duration: {}ms",
                            traceId,
                            exchange.getRequest().getURI().getPath(),
                            exchange.getResponse().getStatusCode(),
                            duration);
                })
                .doOnError(error -> {
                    long duration = System.currentTimeMillis() - startTime;
                    log.error("[{}] ← ERROR | Path: {} | Duration: {}ms | Error: {}",
                            traceId,
                            exchange.getRequest().getURI().getPath(),
                            duration,
                            error.getMessage());
                });
    }

    private String getOrGenerate(ServerWebExchange exchange, String header) {
        return exchange.getRequest().getHeaders().getFirst(header) != null
                ? exchange.getRequest().getHeaders().getFirst(header)
                : UUID.randomUUID().toString();
    }

    @Override
    public int getOrder() {
        return Ordered.HIGHEST_PRECEDENCE; // run before everything else
    }
}
```

### 8b. Header Sanitization Filter (Security-critical!)

**`filter/HeaderSanitizationFilter.java`**

```java
package com.example.gateway.filter;

import com.example.gateway.properties.GatewayProperties;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.cloud.gateway.filter.GatewayFilterChain;
import org.springframework.cloud.gateway.filter.GlobalFilter;
import org.springframework.core.Ordered;
import org.springframework.http.server.reactive.ServerHttpRequest;
import org.springframework.stereotype.Component;
import org.springframework.web.server.ServerWebExchange;
import reactor.core.publisher.Mono;

/**
 * Strips client-supplied identity headers before forwarding downstream.
 * Prevents header-injection attacks where a malicious client sets
 * X-User-Id, X-User-Roles, etc. to impersonate another user.
 *
 * <p>Identity headers are injected by trusted infrastructure only
 * AFTER this filter, never by the client.</p>
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class HeaderSanitizationFilter implements GlobalFilter, Ordered {

    private final GatewayProperties gatewayProperties;

    @Override
    public Mono<Void> filter(ServerWebExchange exchange, GatewayFilterChain chain) {
        ServerHttpRequest request = exchange.getRequest().mutate()
                .headers(httpHeaders -> {
                    for (String header : gatewayProperties.getStripHeaders()) {
                        httpHeaders.remove(header);
                    }
                })
                .build();

        return chain.filter(exchange.mutate().request(request).build());
    }

    @Override
    public int getOrder() {
        return Ordered.HIGHEST_PRECEDENCE + 1; // right after logging filter
    }
}
```

### 8c. JWKS Warm-Up on Startup

**`filter/JwksWarmUpRunner.java`**

```java
package com.example.gateway.filter;

import com.example.gateway.properties.GatewayProperties;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.boot.ApplicationRunner;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.oauth2.jwt.ReactiveJwtDecoder;

/**
 * Forces a JWKS fetch on application startup so the first real request
 * doesn't pay the latency penalty of fetching keys from Keycloak.
 */
@Slf4j
@Configuration
@RequiredArgsConstructor
public class JwksWarmUpRunner {

    private final GatewayProperties gatewayProperties;

    @Bean
    public ApplicationRunner warmUpJwks(ReactiveJwtDecoder jwtDecoder) {
        return args -> {
            if (!gatewayProperties.isJwksWarmUp()) return;

            try {
                // Force decoder to initialise and fetch the JWKS set.
                jwtDecoder.decode("invalid-placeholder-for-warmup")
                        .doOnError(e -> log.info("JWKS warm-up completed (expected decode error for placeholder token): {}",
                                e.getClass().getSimpleName()))
                        .doOnSuccess(jwt -> log.warn("JWKS warm-up: placeholder token was unexpectedly valid — investigate."))
                        .onErrorResume(e -> reactor.core.publisher.Mono.empty()) // swallow error
                        .block();
            } catch (Exception e) {
                log.warn("JWKS warm-up failed — gateway will lazy-load on first request: {}", e.getMessage());
            }
        };
    }
}
```

