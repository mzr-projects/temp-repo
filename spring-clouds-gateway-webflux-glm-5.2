## 10. `application.yml` (Production-grade)

```yaml
server:
  port: 8080
  shutdown: graceful
  netty:
    connection-timeout: 5s
    idle-timeout: 60s

spring:
  application:
    name: api-gateway

  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
      timeout: 3s
      lettuce:
        pool:
          max-active: 16
          max-idle: 8
          min-idle: 4

  cloud:
    gateway:
      default-filters:
        # Strip identity headers on every route (belt + suspenders with the GlobalFilter)
        - RemoveRequestHeader=X-User-Id
        - RemoveRequestHeader=X-User-Roles
        - RemoveRequestHeader=X-User-Email

      # ── Service Discovery (disable if not using Eureka/Consul) ──
      discovery:
        locator:
          enabled: false  # explicit routes only, for security

      # ── Global HTTP client tuning ──
      httpclient:
        connect-timeout: 5000       # 5s
        response-timeout: 30s
        pool:
          type: elastic
          max-connections: 500
          acquire-timeout: 10s
          max-idle-time: 60s

  security:
    oauth2:
      resourceserver:
        jwt:
          # ── Only `issuer-uri` is needed. Spring auto-configures JWKS
          #    fetch, key rotation, signature validation, and iss/exp checks. ──
          issuer-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8180/realms/myrealm}
          # jwk-set-uri is auto-derived from issuer-uri; specify explicitly only if needed:
          # jwk-set-uri: ${KEYCLOAK_JWKS_URI:http://localhost:8180/realms/myrealm/protocol/openid-connect/certs}

  # ── Resilience4j Circuit Breaker ──
  cloud.resilience4j:
    circuitbreaker:
      configs:
        default:
          sliding-window-type: COUNT_BASED
          sliding-window-size: 20
          minimum-number-of-calls: 10
          failure-rate-threshold: 50
          wait-duration-in-open-state: 10s
          permitted-number-of-calls-in-half-open-state: 5
          automatic-transition-from-open-to-half-open-enabled: true
          record-exceptions:
            - java.net.ConnectException
            - java.util.concurrent.TimeoutException
            - org.springframework.web.server.ResponseStatusException
    timelimiter:
      configs:
        default:
          timeout-duration: 30s
          cancel-running-future: true

# ── Custom Gateway Properties ──
gateway:
  jwks-warm-up: true
  response-timeout: 30
  strip-headers:
    - X-User-Id
    - X-User-Roles
    - X-User-Email
    - X-Forwarded-User
    - X-Forwarded-Roles
  rate-limiter:
    default-replenish-rate: 10
    default-burst-capacity: 20

# ── Actuator ──
management:
  endpoints:
    web:
      exposure:
        include: health,info,prometheus,gateway,metrics
  endpoint:
    health:
      show-details: when-authorized
  health:
    redis:
      enabled: true

# ── Logging ──
logging:
  level:
    root: INFO
    com.example.gateway: DEBUG
    org.springframework.cloud.gateway: INFO
    org.springframework.security: INFO
    io.github.resilience4j: INFO

# ── Service URLs (used in route definitions if no service discovery) ──
services:
  user-service:
    url: ${USER_SERVICE_URL:http://localhost:8081}
  order-service:
    url: ${ORDER_SERVICE_URL:http://localhost:8082}
  payment-service:
    url: ${PAYMENT_SERVICE_URL:http://localhost:8083}
  inventory-service:
    url: ${INVENTORY_SERVICE_URL:http://localhost:8084}
