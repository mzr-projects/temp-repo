## 5. Gateway Route Configuration (Java DSL + YAML)

**`config/GatewayConfig.java`**

```java
package com.example.gateway.config;

import com.example.gateway.properties.GatewayProperties;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.cloud.gateway.filter.factory.SpringCloudCircuitBreakerFilterFactory;
import org.springframework.cloud.gateway.route.RouteLocator;
import org.springframework.cloud.gateway.route.builder.RouteLocatorBuilder;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.HttpMethod;

import java.time.Duration;

@Slf4j
@Configuration
@RequiredArgsConstructor
public class GatewayConfig {

    private final GatewayProperties gatewayProperties;

    @Bean
    public RouteLocator customRouteLocator(RouteLocatorBuilder builder) {
        return builder.routes()

            // ──────────────── User Service ────────────────
            .route("user-service", r -> r
                .path("/api/users/**")
                .filters(f -> f
                    .circuitBreaker(cb -> cb
                        .setName("user-service-cb")
                        .setFallbackUri("forward:/fallback/user-service"))
                    .rewritePath("/api/users/(?<segment>.*)", "/${segment}")
                    .requestRateLimiter(rl -> rl
                        .setRateLimiter(org.springframework.cloud.gateway.filter.ratelimit.RedisRateLimiter.class
                            .cast(null)) // configured in RateLimiterConfig
                        .setStatusCode(org.springframework.http.HttpStatus.TOO_MANY_REQUESTS))
                    .responseTimeout(Duration.ofSeconds(gatewayProperties.getResponseTimeout())))
                .uri("lb://USER-SERVICE"))

            // ──────────────── Order Service ────────────────
            .route("order-service", r -> r
                .path("/api/orders/**")
                .filters(f -> f
                    .circuitBreaker(cb -> cb
                        .setName("order-service-cb")
                        .setFallbackUri("forward:/fallback/order-service"))
                    .rewritePath("/api/orders/(?<segment>.*)", "/${segment}")
                    .responseTimeout(Duration.ofSeconds(gatewayProperties.getResponseTimeout())))
                .uri("lb://ORDER-SERVICE"))

            // ──────────────── Payment Service ────────────────
            .route("payment-service", r -> r
                .path("/api/payments/**")
                .filters(f -> f
                    .circuitBreaker(cb -> cb
                        .setName("payment-service-cb")
                        .setFallbackUri("forward:/fallback/payment-service"))
                    .rewritePath("/api/payments/(?<segment>.*)", "/${segment}")
                    .responseTimeout(Duration.ofSeconds(gatewayProperties.getResponseTimeout())))
                .uri("lb://PAYMENT-SERVICE"))

            // ──────────────── Inventory Service ────────────────
            .route("inventory-service", r -> r
                .path("/api/inventory/**")
                .filters(f -> f
                    .circuitBreaker(cb -> cb
                        .setName("inventory-service-cb")
                        .setFallbackUri("forward:/fallback/inventory-service"))
                    .rewritePath("/api/inventory/(?<segment>.*)", "/${segment}")
                    .responseTimeout(Duration.ofSeconds(gatewayProperties.getResponseTimeout())))
                .uri("lb://INVENTORY-SERVICE"))

            .build();
    }
}
