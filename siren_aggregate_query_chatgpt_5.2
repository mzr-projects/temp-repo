## Query template 2: Multiple joins with different keys + composite aggregation (paging buckets) + pipeline KPIs

This template matches the common “Employee must be in Team X AND Department Y” pattern (two joins with different `on` keys), then joins time entries to project `hours` and `cost` and produces **paged** grouped rollups via `composite`. [^1] [Source](https://docs.siren.io/siren-federate-user-guide/39/joining-data.html)

```json
POST /siren/employee/_search
{
    "size": 0,

    "query": {
        "bool": {
            "filter": [
                { "term": { "employment_status.keyword": "ACTIVE" } },

                {
                    "join": {
                        "indices": ["team"],
                        "on": ["team_id.keyword", "team_id.keyword"],
                        "request": {
                            "query": {
                                "term": { "team_name.keyword": "Platform" }
                            }
                        }
                    }
                },

                {
                    "join": {
                        "indices": ["department"],
                        "on": ["department_id.keyword", "department_id.keyword"],
                        "request": {
                            "query": {
                                "term": { "department_name.keyword": "Engineering" }
                            }
                        }
                    }
                },

                {
                    "join": {
                        "indices": ["time_entry-*"],
                        "on": ["employee_id.keyword", "employee_id.keyword"],
                        "request": {
                            "project": [
                                { "field": { "name": "hours", "alias": "te_hours" } },
                                { "field": { "name": "cost", "alias": "te_cost" } },
                                { "field": { "name": "billable", "alias": "te_billable" } },
                                { "field": { "name": "work_date", "alias": "te_work_date" } }
                            ],
                            "query": {
                                "range": { "work_date": { "gte": "now-90d/d", "lte": "now" } }
                            }
                        }
                    }
                }
            ]
        }
    },

    "runtime_mappings": {
        "te_hours_sum": {
            "type": "double",
            "script": "double s = 0; for (h in doc.te_hours) { s += h } emit(s);"
        },
        "te_cost_sum": {
            "type": "double",
            "script": "double s = 0; for (c in doc.te_cost) { s += c } emit(s);"
        },
        "te_billable_hours_sum": {
            "type": "double",
            "script": "double s = 0; int i = 0; for (h in doc.te_hours) { boolean b = false; if (i < doc.te_billable.size()) { b = doc.te_billable.get(i) } if (b) s += h; i++ } emit(s);"
        },
        "utilization": {
            "type": "double",
            "script": "double total = 0; for (h in doc.te_hours) { total += h } double bill = 0; int i = 0; for (h in doc.te_hours) { boolean b = false; if (i < doc.te_billable.size()) { b = doc.te_billable.get(i) } if (b) bill += h; i++ } if (total > 0) emit(bill / total);"
        }
    },

    "aggs": {
        "rollup": {
            "composite": {
                "size": 2000,
                "sources": [
                    { "department_id": { "terms": { "field": "department_id.keyword" } } },
                    { "team_id": { "terms": { "field": "team_id.keyword" } } },
                    { "job_title": { "terms": { "field": "job_title.keyword" } } }
                ]
            },
            "aggs": {
                "employees": { "cardinality": { "field": "employee_id.keyword" } },

                "hours_total": { "sum": { "field": "te_hours_sum" } },
                "cost_total": { "sum": { "field": "te_cost_sum" } },

                "avg_utilization": { "avg": { "field": "utilization" } },

                "cost_per_hour": {
                    "bucket_script": {
                        "buckets_path": { "cost": "cost_total", "hours": "hours_total" },
                        "script": "params.hours > 0 ? params.cost / params.hours : 0"
                    }
                },

                "sample_employees": {
                    "top_hits": {
                        "size": 3,
                        "_source": { "includes": ["employee_id", "name", "job_title"] }
                    }
                }
            }
        }
    }
}
```

Key idea: Siren joins compose naturally inside `bool.filter`, and your aggregations remain standard Elasticsearch aggregations computed over the filtered parent set (employees), with measures derived from projected child values via runtime fields. [^1] [Source](https://docs.siren.io/siren-federate-user-guide/39/joining-data.html)

