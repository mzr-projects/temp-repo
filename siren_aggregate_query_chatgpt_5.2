## Query template 1: 2 nested joins for filtering + 1 join for projection + “serious” aggregations

This template does **(Account → Location → Client)** as a nested join chain to filter accounts by client attributes, and separately joins **(Account → Transaction)** to project measures you’ll aggregate on. [^1] [Source](https://docs.siren.io/siren-federate-user-guide/39/joining-data.html)

```json
POST /siren/account/_search
{
    "size": 0,
    "track_total_hits": true,

    "query": {
        "bool": {
            "filter": [
                { "term": { "account_status.keyword": "ACTIVE" } },

                {
                    "join": {
                        "type": "HASH_JOIN",
                        "indices": ["location"],
                        "on": ["location_id.keyword", "location_id.keyword"],
                        "request": {
                            "query": {
                                "join": {
                                    "type": "HASH_JOIN",
                                    "indices": ["client"],
                                    "on": ["client_id.keyword", "client_id.keyword"],
                                    "request": {
                                        "query": {
                                            "bool": {
                                                "filter": [
                                                    { "term": { "client_name.keyword": "Bond" } },
                                                    { "terms": { "client_tier.keyword": ["GOLD", "PLATINUM"] } }
                                                ]
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },

                {
                    "join": {
                        "type": "HASH_JOIN",
                        "indices": ["transaction-*"],
                        "on": ["account_id.keyword", "account_id.keyword"],
                        "request": {
                            "project": [
                                { "field": { "name": "amount", "alias": "txn_amount" } },
                                { "field": { "name": "channel.keyword", "alias": "txn_channel" } },
                                { "field": { "name": "risk_score", "alias": "txn_risk" } },
                                { "field": { "name": "txn_ts", "alias": "txn_ts" } }
                            ],
                            "query": {
                                "range": {
                                    "txn_ts": { "gte": "now-30d/d", "lte": "now" }
                                }
                            }
                        }
                    }
                }
            ]
        }
    },

    "runtime_mappings": {
        "txn_count": {
            "type": "long",
            "script": "emit(doc.txn_amount.size());"
        },
        "txn_amount_sum": {
            "type": "double",
            "script": "double s = 0; for (v in doc.txn_amount) { s += v } emit(s);"
        },
        "txn_amount_avg": {
            "type": "double",
            "script": "double s = 0; int c = 0; for (v in doc.txn_amount) { s += v; c++ } if (c > 0) emit(s / c);"
        },
        "txn_risk_max": {
            "type": "double",
            "script": "double m = Double.NEGATIVE_INFINITY; for (v in doc.txn_risk) { if (v > m) m = v } if (m != Double.NEGATIVE_INFINITY) emit(m);"
        },

        "txn_amount_values": {
            "type": "double",
            "script": "for (v in doc.txn_amount) { emit(v); }"
        },
        "txn_channel_values": {
            "type": "keyword",
            "script": "for (c in doc.txn_channel) { emit(c); }"
        },
        "txn_ts_values": {
            "type": "date",
            "script": "for (d in doc.txn_ts) { emit(d.toInstant().toEpochMilli()); }"
        }
    },

    "aggs": {
        "by_region": {
            "terms": { "field": "region.keyword", "size": 50 },
            "aggs": {
                "accounts": { "cardinality": { "field": "account_id.keyword" } },

                "txn_total_amount": { "sum": { "field": "txn_amount_sum" } },
                "avg_txn_amount_per_account": { "avg": { "field": "txn_amount_avg" } },
                "txn_count_stats_per_account": { "stats": { "field": "txn_count" } },

                "p50_p95_p99_single_txn_amount": {
                    "percentiles": {
                        "field": "txn_amount_values",
                        "percents": [50, 95, 99]
                    }
                },

                "by_channel": {
                    "terms": { "field": "txn_channel_values", "size": 20 },
                    "aggs": {
                        "channel_total_amount": { "sum": { "field": "txn_amount_sum" } }
                    }
                },

                "by_day": {
                    "date_histogram": {
                        "field": "txn_ts_values",
                        "fixed_interval": "1d"
                    },
                    "aggs": {
                        "daily_total_amount": { "sum": { "field": "txn_amount_sum" } },
                        "daily_accounts": { "cardinality": { "field": "account_id.keyword" } },
                        "daily_amount_per_account": {
                            "bucket_script": {
                                "buckets_path": { "amt": "daily_total_amount", "acct": "daily_accounts" },
                                "script": "params.acct > 0 ? params.amt / params.acct : 0"
                            }
                        }
                    }
                },

                "risk_bands": {
                    "filters": {
                        "filters": {
                            "low": { "range": { "txn_risk_max": { "lt": 30 } } },
                            "med": { "range": { "txn_risk_max": { "gte": 30, "lt": 70 } } },
                            "high": { "range": { "txn_risk_max": { "gte": 70 } } }
                        }
                    },
                    "aggs": {
                        "band_total_amount": { "sum": { "field": "txn_amount_sum" } },
                        "band_accounts": { "cardinality": { "field": "account_id.keyword" } }
                    }
                }
            }
        }
    }
}
```

Key idea: **filtering joins can be nested**, while **aggregation joins should project fields you need**, then you aggregate using runtime fields built on projected values (sums/percentiles/histograms/pipelines). [^1] [Source](https://docs.siren.io/siren-federate-user-guide/39/joining-data.html)

