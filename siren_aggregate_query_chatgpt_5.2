## Query template 3: Extended (multi‑conditional) join + nested join + aggregations

This template shows the **extended join condition syntax**: join `session` (parent) to `event` (child) when `(user_id matches) AND (start_ts <= event.ts) AND (end_ts >= event.ts)` and then a nested join inside the event request to filter on `watchlist` users. [^3] [^1]

```json
POST /siren/session/_search
{
    "size": 0,

    "query": {
        "bool": {
            "filter": [
                { "range": { "start_ts": { "gte": "now-7d/d", "lte": "now" } } },

                {
                    "join": {
                        "type": "HASH_JOIN",
                        "indices": ["event-*"],
                        "on": {
                            "must": [
                                { "eq": { "fields": ["user_id.keyword", "user_id.keyword"] } },
                                { "lte": { "fields": ["start_ts", "ts"] } },
                                { "gte": { "fields": ["end_ts", "ts"] } }
                            ]
                        },
                        "request": {
                            "project": [
                                { "field": { "name": "bytes", "alias": "evt_bytes" } },
                                { "field": { "name": "event_type.keyword", "alias": "evt_type" } },
                                { "field": { "name": "risk_score", "alias": "evt_risk" } }
                            ],
                            "query": {
                                "bool": {
                                    "filter": [
                                        { "terms": { "event_type.keyword": ["login", "data_export", "admin_change"] } },

                                        {
                                            "join": {
                                                "indices": ["watchlist"],
                                                "on": ["user_id.keyword", "user_id.keyword"],
                                                "request": {
                                                    "query": {
                                                        "term": { "watchlist_name.keyword": "high_risk_users" }
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        }
    },

    "runtime_mappings": {
        "evt_bytes_sum": {
            "type": "long",
            "script": "long s = 0; for (b in doc.evt_bytes) { s += b } emit(s);"
        },
        "evt_risk_max": {
            "type": "double",
            "script": "double m = Double.NEGATIVE_INFINITY; for (r in doc.evt_risk) { if (r > m) m = r } if (m != Double.NEGATIVE_INFINITY) emit(m);"
        },
        "evt_type_values": {
            "type": "keyword",
            "script": "for (t in doc.evt_type) { emit(t); }"
        }
    },

    "aggs": {
        "by_app": {
            "terms": { "field": "app.keyword", "size": 30 },
            "aggs": {
                "sessions": { "cardinality": { "field": "session_id.keyword" } },

                "total_bytes": { "sum": { "field": "evt_bytes_sum" } },
                "max_risk_avg": { "avg": { "field": "evt_risk_max" } },

                "by_event_type": {
                    "terms": { "field": "evt_type_values", "size": 20 },
                    "aggs": {
                        "type_total_bytes": { "sum": { "field": "evt_bytes_sum" } }
                    }
                }
            }
        }
    }
}
```

Key idea: extended join conditions let you build non-equi joins (field-to-field comparisons like `lte/gte/within/contains`), and multi-conditional joins are expressed via `must: [ ... ]`. [^3]

