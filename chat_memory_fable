resilience4j:
  circuitbreaker:
    instances:
      personApi:
        slidingWindowSize: 20
        failureRateThreshold: 50
        waitDurationInOpenState: 30s
  retry:
    instances:
      personApi:
        maxAttempts: 3
        waitDuration: 500ms
