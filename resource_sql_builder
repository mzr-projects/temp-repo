### `SqlQueryBuilder.java` — The Main Builder

```java
package com.example.dbexplorer.querybuilder;

import com.example.dbexplorer.model.DatabaseType;
import com.example.dbexplorer.model.QueryRequest;

import java.util.ArrayList;
import java.util.List;

public class SqlQueryBuilder {

    private final DatabaseType dbType;
    private final QueryRequest req;
    private final List<Object> parameters = new ArrayList<>();

    public SqlQueryBuilder(DatabaseType dbType, QueryRequest req) {
        this.dbType = dbType;
        this.req = req;
    }

    public String build() {
        validate();
        StringBuilder sql = new StringBuilder("SELECT ");
        if (req.isDistinct()) sql.append("DISTINCT ");

        // Columns
        if (req.getColumns() == null || req.getColumns().isEmpty()) {
            sql.append("*");
        } else {
            sql.append(String.join(", ",
                    req.getColumns().stream().map(this::quoteCol).toList()));
        }

        // FROM
        sql.append(" FROM ").append(qualifiedTable(req.getSchema(), req.getTable()));

        // JOINS
        if (req.getJoins() != null) {
            for (JoinClause j : req.getJoins()) {
                sql.append(" ").append(j.getType().name()).append(" JOIN ")
                   .append(dbType.quote(j.getTable()));
                if (j.getAlias() != null) sql.append(" ").append(j.getAlias());
                sql.append(" ON ").append(j.getOnClause());
            }
        }

        // WHERE
        if (req.getConditions() != null && !req.getConditions().isEmpty()) {
            sql.append(" WHERE ");
            for (int i = 0; i < req.getConditions().size(); i++) {
                Condition c = req.getConditions().get(i);
                if (i > 0) sql.append(" ").append(c.getLogicalOp()).append(" ");
                sql.append(renderCondition(c));
            }
        }

        // GROUP BY
        if (req.getGroupBy() != null && !req.getGroupBy().isEmpty()) {
            sql.append(" GROUP BY ").append(
                    String.join(", ", req.getGroupBy().stream().map(this::quoteCol).toList()));
        }

        // ORDER BY
        if (req.getOrderBy() != null && !req.getOrderBy().isEmpty()) {
            sql.append(" ORDER BY ").append(String.join(", ", req.getOrderBy()));
        }

        // Pagination (dialect-aware)
        appendPagination(sql);

        return sql.toString();
    }

    public List<Object> getParameters() { return parameters; }

    private String renderCondition(Condition c) {
        String col = quoteCol(c.getColumn());
        Operator op = c.getOperator();
        return switch (op) {
            case IS_NULL, IS_NOT_NULL -> col + " " + op.sql;
            case IN, NOT_IN -> {
                List<Object> vals = c.getValues();
                String placeholders = String.join(",", vals.stream().map(v -> "?").toList());
                parameters.addAll(vals);
                yield col + " " + op.sql + " (" + placeholders + ")";
            }
            case BETWEEN -> {
                parameters.add(c.getValues().get(0));
                parameters.add(c.getValues().get(1));
                yield col + " BETWEEN ? AND ?";
            }
            default -> {
                parameters.add(c.getValue());
                yield col + " " + op.sql + " ?";
            }
        };
    }

    private String qualifiedTable(String schema, String table) {
        return (schema != null && !schema.isBlank())
                ? dbType.quote(schema) + "." + dbType.quote(table)
                : dbType.quote(table);
    }

    /** Safely quotes a column (handles "table.column" and "col AS alias"). */
    private String quoteCol(String raw) {
        // Whitelist only safe identifier characters to defend against injection.
        if (!raw.matches("[A-Za-z0-9_.\\s*]+( [Aa][Ss] [A-Za-z0-9_]+)?")) {
            throw new IllegalArgumentException("Invalid column name: " + raw);
        }
        if (raw.equals("*")) return raw;
        if (raw.contains(".")) {
            String[] parts = raw.split("\\.");
            return dbType.quote(parts[0]) + "." + (parts[1].equals("*") ? "*" : dbType.quote(parts[1]));
        }
        return dbType.quote(raw);
    }

    private void appendPagination(StringBuilder sql) {
        Integer limit = req.getLimit();
        Integer offset = req.getOffset();
        if (limit == null) return;

        switch (dbType) {
            case POSTGRESQL, MYSQL -> {
                sql.append(" LIMIT ").append(limit);
                if (offset != null) sql.append(" OFFSET ").append(offset);
            }
            case ORACLE -> {
                if (offset != null) sql.append(" OFFSET ").append(offset).append(" ROWS");
                sql.append(" FETCH NEXT ").append(limit).append(" ROWS ONLY");
            }
            case SQLSERVER -> {
                // SQL Server requires ORDER BY for OFFSET/FETCH
                if (req.getOrderBy() == null || req.getOrderBy().isEmpty()) {
                    sql.append(" ORDER BY (SELECT NULL)");
                }
                sql.append(" OFFSET ").append(offset == null ? 0 : offset).append(" ROWS");
                sql.append(" FETCH NEXT ").append(limit).append(" ROWS ONLY");
            }
        }
    }

    private void validate() {
        if (req.getTable() == null || req.getTable().isBlank())
            throw new IllegalArgumentException("Table is required");
        if (!req.getTable().matches("[A-Za-z0-9_]+"))
            throw new IllegalArgumentException("Invalid table name");
        if (req.getSchema() != null && !req.getSchema().matches("[A-Za-z0-9_]+"))
            throw new IllegalArgumentException("Invalid schema name");
    }
}
```

## 🚀 Data Query Service

```java
package com.example.dbexplorer.service;

import com.example.dbexplorer.config.DataSourceManager;
import com.example.dbexplorer.model.DatabaseConfig;
import com.example.dbexplorer.model.QueryRequest;
import com.example.dbexplorer.querybuilder.SqlQueryBuilder;
import lombok.RequiredArgsConstructor;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;
import java.sql.*;
import java.util.*;

@Service
@RequiredArgsConstructor
public class DataQueryService {

    private final DatabaseConfigService configService;
    private final DataSourceManager dataSourceManager;

    @Value("${app.query.max-results:1000}")
    private int maxResults;

    @Value("${app.query.timeout-seconds:30}")
    private int timeoutSeconds;

    public Map<String, Object> execute(String configId, QueryRequest request) {
        DatabaseConfig config = configService.findById(configId);
        DataSource ds = dataSourceManager.getDataSource(config);

        // Enforce safety cap
        if (request.getLimit() == null || request.getLimit() > maxResults) {
            request.setLimit(maxResults);
        }

        SqlQueryBuilder builder = new SqlQueryBuilder(config.getType(), request);
        String sql = builder.build();
        List<Object> params = builder.getParameters();

        List<Map<String, Object>> rows = new ArrayList<>();
        List<String> columnNames = new ArrayList<>();

        try (Connection conn = ds.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {
            ps.setQueryTimeout(timeoutSeconds);
            for (int i = 0; i < params.size(); i++) {
                ps.setObject(i + 1, params.get(i));
            }
            try (ResultSet rs = ps.executeQuery()) {
                ResultSetMetaData md = rs.getMetaData();
                int cc = md.getColumnCount();
                for (int i = 1; i <= cc; i++) columnNames.add(md.getColumnLabel(i));
                while (rs.next()) {
                    Map<String, Object> row = new LinkedHashMap<>();
                    for (int i = 1; i <= cc; i++) row.put(md.getColumnLabel(i), rs.getObject(i));
                    rows.add(row);
                }
            }
        } catch (SQLException e) {
            throw new RuntimeException("Query failed: " + e.getMessage(), e);
        }

        return Map.of(
                "sql", sql,
                "columns", columnNames,
                "rows", rows,
                "rowCount", rows.size()
        );
    }
}
```

