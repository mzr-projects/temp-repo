## 🛠️ Database Config Service

```java
package com.example.dbexplorer.service;

import com.example.dbexplorer.model.DatabaseConfig;
import com.example.dbexplorer.repository.DatabaseConfigRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import java.sql.Connection;
import java.sql.DriverManager;
import java.time.Instant;
import java.util.List;
import java.util.UUID;

@Service
@RequiredArgsConstructor
public class DatabaseConfigService {

    private final DatabaseConfigRepository repository;
    private final EncryptionService encryptionService;

    public DatabaseConfig save(DatabaseConfig config) {
        if (config.getId() == null) {
            config.setId(UUID.randomUUID().toString());
            config.setCreatedAt(Instant.now());
        }
        config.setUpdatedAt(Instant.now());
        config.setPassword(encryptionService.encrypt(config.getPassword()));
        testConnection(config);
        return repository.save(config);
    }

    public DatabaseConfig findById(String id) {
        return repository.findById(id)
                .orElseThrow(() -> new RuntimeException("Config not found: " + id));
    }

    public List<DatabaseConfig> findAll() {
        List<DatabaseConfig> result = new java.util.ArrayList<>();
        repository.findAll().forEach(result::add);
        return result;
    }

    public void delete(String id) { repository.deleteById(id); }

    private void testConnection(DatabaseConfig config) {
        try {
            Class.forName(config.getType().getDriverClass());
            try (Connection conn = DriverManager.getConnection(
                    config.getJdbcUrl(),
                    config.getUsername(),
                    encryptionService.decrypt(config.getPassword()))) {
                if (!conn.isValid(5)) {
                    throw new RuntimeException("Connection invalid");
                }
            }
        } catch (Exception e) {
            throw new RuntimeException("Connection test failed: " + e.getMessage(), e);
        }
    }
}
