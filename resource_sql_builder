## 📋 Metadata Service (Tables & Columns)

```java
package com.example.dbexplorer.service;

import com.example.dbexplorer.config.DataSourceManager;
import com.example.dbexplorer.model.*;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import javax.sql.DataSource;
import java.sql.*;
import java.util.*;

@Service
@RequiredArgsConstructor
public class MetadataService {

    private final DatabaseConfigService configService;
    private final DataSourceManager dataSourceManager;

    public List<TableMetadata> listTables(String configId, String schema) {
        DatabaseConfig config = configService.findById(configId);
        DataSource ds = dataSourceManager.getDataSource(config);
        List<TableMetadata> tables = new ArrayList<>();

        try (Connection conn = ds.getConnection()) {
            DatabaseMetaData md = conn.getMetaData();
            String effectiveSchema = schema != null ? schema : config.getDefaultSchema();
            try (ResultSet rs = md.getTables(null, effectiveSchema, "%",
                    new String[]{"TABLE", "VIEW"})) {
                while (rs.next()) {
                    tables.add(TableMetadata.builder()
                            .catalog(rs.getString("TABLE_CAT"))
                            .schema(rs.getString("TABLE_SCHEM"))
                            .name(rs.getString("TABLE_NAME"))
                            .type(rs.getString("TABLE_TYPE"))
                            .remarks(rs.getString("REMARKS"))
                            .build());
                }
            }
        } catch (SQLException e) {
            throw new RuntimeException("Failed to list tables", e);
        }
        return tables;
    }

    public List<ColumnMetadata> getColumns(String configId, String schema, String table) {
        DatabaseConfig config = configService.findById(configId);
        DataSource ds = dataSourceManager.getDataSource(config);
        List<ColumnMetadata> columns = new ArrayList<>();
        Set<String> primaryKeys = new HashSet<>();

        try (Connection conn = ds.getConnection()) {
            DatabaseMetaData md = conn.getMetaData();
            try (ResultSet pk = md.getPrimaryKeys(null, schema, table)) {
                while (pk.next()) primaryKeys.add(pk.getString("COLUMN_NAME"));
            }
            try (ResultSet rs = md.getColumns(null, schema, table, "%")) {
                while (rs.next()) {
                    String name = rs.getString("COLUMN_NAME");
                    columns.add(ColumnMetadata.builder()
                            .name(name)
                            .dataType(rs.getString("TYPE_NAME"))
                            .jdbcType(rs.getInt("DATA_TYPE"))
                            .size(rs.getInt("COLUMN_SIZE"))
                            .decimalDigits(rs.getInt("DECIMAL_DIGITS"))
                            .nullable("YES".equalsIgnoreCase(rs.getString("IS_NULLABLE")))
                            .primaryKey(primaryKeys.contains(name))
                            .defaultValue(rs.getString("COLUMN_DEF"))
                            .remarks(rs.getString("REMARKS"))
                            .build());
                }
            }
        } catch (SQLException e) {
            throw new RuntimeException("Failed to get columns", e);
        }
        return columns;
    }
}
```

