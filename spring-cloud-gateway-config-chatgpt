-Xlog:gc*:file=/path/to/logs/gc.log:time,uptime,level,tags:filecount=5,filesize=50M

# JVM diagnostics
-XX:+UnlockDiagnosticVMOptions
-XX:NativeMemoryTracking=summary  # Track native memory usage
