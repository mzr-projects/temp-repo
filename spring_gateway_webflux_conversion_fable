## 3. `GatewayOAuth2FailureHandler.java`

```java
package ir.csas.gateway.config;

import ir.csas.gateway.properties.GatewayProperties;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.security.core.AuthenticationException;
import org.springframework.security.web.server.WebFilterExchange;
import org.springframework.security.web.server.authentication.ServerAuthenticationFailureHandler;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
@RequiredArgsConstructor
@Slf4j
public class GatewayOAuth2FailureHandler implements ServerAuthenticationFailureHandler {

    private final GatewayProperties gatewayProperties;

    @Override
    public Mono<Void> onAuthenticationFailure(WebFilterExchange webFilterExchange,
                                              AuthenticationException exception) {
        log.error("OAuth2 authentication failed", exception);
        return SecurityUtils.sendForbidden(
                webFilterExchange.getExchange().getResponse(),
                gatewayProperties.getRedirectUrl());
    }
}
```

