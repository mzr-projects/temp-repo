## 3. Add bounded parallel scheduling

The following is the **new orchestration layer** around the parser and journal from the previous answer. It is not a replacement for the parsing/checkpoint code.

First, extract the previous file-processing logic behind this interface:

### `FileProcessor.java`

```java
package com.example.ingest;

import java.nio.file.Path;

public interface FileProcessor extends AutoCloseable {

    // Initialize this worker's producer, fence its previous instance,
    // recover its checkpoints, and validate unfinished files.
    void initialize() throws Exception;

    // Check this worker's checkpoint, resume/process the file,
    // and archive it only after its completion checkpoint commits.
    void process(Path file) throws Exception;

    @Override
    void close() throws Exception;
}
```

### `FileProcessorFactory.java`

```java
package com.example.ingest;

import java.util.function.BooleanSupplier;

@FunctionalInterface
public interface FileProcessorFactory {

    // Must return a NEW processor with its OWN KafkaJournal.
    FileProcessor create(
            int workerId,
            BooleanSupplier shouldStop
    ) throws Exception;
}
```

### `ParallelFileDispatcher.java`

```java
package com.example.ingest;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.LinkOption;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.Set;
import java.util.concurrent.ArrayBlockingQueue;
import java.util.concurrent.BlockingQueue;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicReference;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

public final class ParallelFileDispatcher implements AutoCloseable {

    private static final Logger log =
            LoggerFactory.getLogger(ParallelFileDispatcher.class);

    private final Path directory;
    private final int workerCount;
    private final FileProcessorFactory factory;

    private final List<BlockingQueue<Path>> queues;
    private final Set<Path> admitted = ConcurrentHashMap.newKeySet();

    private final ExecutorService executor;
    private final AtomicBoolean stopping = new AtomicBoolean();
    private final AtomicInteger initializedWorkers = new AtomicInteger();
    private final AtomicReference<Throwable> failure =
            new AtomicReference<>();

    public ParallelFileDispatcher(
            Path directory,
            int workerCount,
            int queueCapacity,
            FileProcessorFactory factory
    ) {
        if (workerCount <= 0 || queueCapacity <= 0) {
            throw new IllegalArgumentException(
                    "Worker count and queue capacity must be positive"
            );
        }

        this.directory = directory.toAbsolutePath().normalize();
        this.workerCount = workerCount;
        this.factory = factory;

        this.queues = new ArrayList<>(workerCount);

        for (int i = 0; i < workerCount; i++) {
            queues.add(new ArrayBlockingQueue<>(queueCapacity));
        }

        this.executor = Executors.newFixedThreadPool(
                workerCount,
                Thread.ofPlatform()
                        .name("csv-worker-", 0)
                        .factory()
        );

        for (int i = 0; i < workerCount; i++) {
            final int workerId = i;
            executor.execute(() -> runWorker(workerId));
        }
    }

    public synchronized void scan() {
        if (shouldStop()
                || initializedWorkers.get() != workerCount) {
            return;
        }

        try (var entries =
                     Files.newDirectoryStream(directory, "*.csv")) {

            for (Path entry : entries) {
                if (shouldStop()) {
                    return;
                }

                Path file = entry.toAbsolutePath().normalize();

                if (!Files.isRegularFile(
                        file, LinkOption.NOFOLLOW_LINKS)) {
                    continue;
                }

                int workerId = Math.floorMod(
                        file.getFileName().toString().hashCode(),
                        workerCount
                );

                BlockingQueue<Path> queue = queues.get(workerId);

                // Optimization: do not block the scanner behind one worker.
                if (queue.remainingCapacity() == 0) {
                    continue;
                }

                // Prevent repeated scans from queuing the same active file.
                if (!admitted.add(file)) {
                    continue;
                }

                if (!queue.offer(file)) {
                    admitted.remove(file);
                    // The file remains on disk; a later scan retries it.
                }
            }

        } catch (IOException | RuntimeException exception) {
            fail(exception);
        }
    }

    private void runWorker(int workerId) {
        try (FileProcessor processor =
                     factory.create(workerId, this::shouldStop)) {

            processor.initialize();
            initializedWorkers.incrementAndGet();

            BlockingQueue<Path> queue = queues.get(workerId);

            while (!shouldStop()) {
                Path file = queue.poll(500, TimeUnit.MILLISECONDS);

                if (file == null) {
                    continue;
                }

                try {
                    if (shouldStop()) {
                        return;
                    }

                    processor.process(file);
                } finally {
                    admitted.remove(file);
                }
            }

        } catch (Throwable exception) {
            if (!stopping.get()) {
                fail(exception);
            }

            if (exception instanceof InterruptedException) {
                Thread.currentThread().interrupt();
            }

            if (exception instanceof Error error) {
                throw error;
            }
        }
    }

    private void fail(Throwable exception) {
        if (failure.compareAndSet(null, exception)) {
            log.error(
                    "CSV pipeline failed; processing is stopping. "
                    + "Restart must recover Kafka checkpoints.",
                    exception
            );
        }
    }

    public boolean shouldStop() {
        return stopping.get() || failure.get() != null;
    }

    public boolean isReady() {
        return !shouldStop()
                && initializedWorkers.get() == workerCount;
    }

    public Throwable failure() {
        return failure.get();
    }

    @Override
    public void close() {
        stopping.set(true);
        executor.shutdown();

        try {
            if (!executor.awaitTermination(150, TimeUnit.SECONDS)) {
                executor.shutdownNow();
            }
        } catch (InterruptedException exception) {
            executor.shutdownNow();
            Thread.currentThread().interrupt();
        }
    }
}
```

### Why this uses bounded queues

With 4 workers and queue capacity 32:

- At most 4 files are being processed.
- At most 128 additional file paths are queued.
- File contents are not loaded into the queues.
- A full queue does not prevent other workers receiving files.
- Files that could not be queued remain on disk for the next scan.

`ArrayBlockingQueue` provides the fixed-capacity queue used here. ([docs.oracle.com](https://docs.oracle.com/en/java/javase/21/docs/api/java.base/java/util/concurrent/ArrayBlockingQueue.html))

The `admitted` set is only an in-process scheduling optimization. **Kafka checkpoints—not this set—provide recovery correctness.**

