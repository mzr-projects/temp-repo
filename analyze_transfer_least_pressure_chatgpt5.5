# 8. Spring AI tool

Expose only the analysis tool to the model.

```java
import org.springframework.ai.tool.annotation.Tool;
import org.springframework.ai.tool.annotation.ToolParam;
import org.springframework.stereotype.Component;

import java.time.LocalDate;

@Component
public class TransferAnalysisTools {

    private final TransferAnalysisService transferAnalysisService;

    public TransferAnalysisTools(TransferAnalysisService transferAnalysisService) {
        this.transferAnalysisService = transferAnalysisService;
    }

    @Tool(description = """
            Analyze all transfer records for one person and return a Markdown report.

            Use this tool when the user asks for:
            - most common source
            - least common source
            - most common destination
            - least common destination
            - most common source-destination route
            - least common source-destination route
            - transfer type distribution
            - airline/train/bus/ship/truck/car usage
            - markdown tables about transfer activity

            This tool performs exact counting in the backend.
            It does not return raw transfer records.
            """)
    public TransferMarkdownAnalysisResponse analyzePersonTransfers(
            @ToolParam(description = "The person ID whose transfer records should be analyzed.")
            String personId,

            @ToolParam(description = "Optional start date in yyyy-MM-dd format.")
            LocalDate dateFrom,

            @ToolParam(description = "Optional end date in yyyy-MM-dd format.")
            LocalDate dateTo,

            @ToolParam(description = "Number of rows to show in each top/least table. Default 10. Maximum 25.")
            Integer topN
    ) {
        return transferAnalysisService.analyzePersonTransfers(
                personId,
                dateFrom,
                dateTo,
                topN
        );
    }
}
