import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;

import java.time.LocalDate;
import java.util.List;

public interface TransferJpaRepository extends JpaRepository<TransferEntity, String> {

    @Query("""
            select t
            from TransferEntity t
            where t.personId = :personId
              and (:dateFrom is null or t.transferDate >= :dateFrom)
              and (:dateTo is null or t.transferDate <= :dateTo)
            order by t.transferDate asc
            """)
    List<TransferEntity> findTransfersForPerson(
            String personId,
            LocalDate dateFrom,
            LocalDate dateTo
    );
}
