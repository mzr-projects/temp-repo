# 6. Service that analyzes the transfers

This service does the real work.

```java
import org.springframework.stereotype.Service;

import java.time.LocalDate;
import java.util.Comparator;
import java.util.List;
import java.util.Map;
import java.util.Objects;
import java.util.stream.Collectors;

@Service
public class TransferAnalysisService {

    private final TransferRepository transferRepository;

    public TransferAnalysisService(TransferRepository transferRepository) {
        this.transferRepository = transferRepository;
    }

    public TransferMarkdownAnalysisResponse analyzePersonTransfers(
            String personId,
            LocalDate dateFrom,
            LocalDate dateTo,
            Integer requestedTopN
    ) {
        int topN = normalizeTopN(requestedTopN);

        List<TransferDto> transfers = transferRepository
                .findTransfersForPerson(personId, dateFrom, dateTo)
                .stream()
                .map(this::toDto)
                .toList();

        int total = transfers.size();

        if (total == 0) {
            String markdown = """
                    ## Transfer Analysis

                    No transfer records were found for the selected person and date range.
                    """;

            return new TransferMarkdownAnalysisResponse(personId, 0, markdown);
        }

        LocalDate minDate = transfers.stream()
                .map(TransferDto::date)
                .filter(Objects::nonNull)
                .min(LocalDate::compareTo)
                .orElse(null);

        LocalDate maxDate = transfers.stream()
                .map(TransferDto::date)
                .filter(Objects::nonNull)
                .max(LocalDate::compareTo)
                .orElse(null);

        List<CountRow> mostSources = topCounts(
                transfers,
                t -> clean(t.source()),
                total,
                topN
        );

        List<CountRow> leastSources = bottomCounts(
                transfers,
                t -> clean(t.source()),
                total,
                topN
        );

        List<CountRow> mostDestinations = topCounts(
                transfers,
                t -> clean(t.destination()),
                total,
                topN
        );

        List<CountRow> leastDestinations = bottomCounts(
                transfers,
                t -> clean(t.destination()),
                total,
                topN
        );

        List<CountRow> mostTypes = topCounts(
                transfers,
                t -> t.type() == null ? "UNKNOWN" : t.type().name(),
                total,
                topN
        );

        List<CountRow> leastTypes = bottomCounts(
                transfers,
                t -> t.type() == null ? "UNKNOWN" : t.type().name(),
                total,
                topN
        );

        List<CountRow> mostBorders = topCounts(
                transfers,
                t -> clean(t.border()),
                total,
                topN
        );

        List<CountRow> leastBorders = bottomCounts(
                transfers,
                t -> clean(t.border()),
                total,
                topN
        );

        List<RouteCountRow> mostRoutes = topRoutes(transfers, total, topN);
        List<RouteCountRow> leastRoutes = bottomRoutes(transfers, total, topN);

        List<RouteTypeCountRow> mostRouteTypes = topRouteTypes(transfers, total, topN);
        List<RouteTypeCountRow> leastRouteTypes = bottomRouteTypes(transfers, total, topN);

        String markdown = buildMarkdown(
                personId,
                total,
                minDate,
                maxDate,
                transfers,
                mostSources,
                leastSources,
                mostDestinations,
                leastDestinations,
                mostTypes,
                leastTypes,
                mostBorders,
                leastBorders,
                mostRoutes,
                leastRoutes,
                mostRouteTypes,
                leastRouteTypes
        );

        return new TransferMarkdownAnalysisResponse(personId, total, markdown);
    }

    private int normalizeTopN(Integer requestedTopN) {
        if (requestedTopN == null || requestedTopN <= 0) {
            return 10;
        }

        return Math.min(requestedTopN, 25);
    }

    private TransferDto toDto(TransferEntity entity) {
        return new TransferDto(
                entity.getPersonId(),
                entity.getBorderName(),
                entity.getTransferDate(),
                entity.getSource(),
                entity.getDestination(),
                entity.getType()
        );
    }

    private String clean(String value) {
        if (value == null || value.isBlank()) {
            return "UNKNOWN";
        }

        return value.trim();
    }

    private double percentage(long count, int total) {
        if (total == 0) {
            return 0.0;
        }

        return count * 100.0 / total;
    }

    private <T> List<CountRow> topCounts(
            List<TransferDto> transfers,
            java.util.function.Function<TransferDto, String> classifier,
            int total,
            int limit
    ) {
        return transfers.stream()
                .collect(Collectors.groupingBy(classifier, Collectors.counting()))
                .entrySet()
                .stream()
                .map(e -> new CountRow(e.getKey(), e.getValue(), percentage(e.getValue(), total)))
                .sorted(
                        Comparator.comparingLong(CountRow::count)
                                .reversed()
                                .thenComparing(CountRow::value)
                )
                .limit(limit)
                .toList();
    }

    private List<CountRow> bottomCounts(
            List<TransferDto> transfers,
            java.util.function.Function<TransferDto, String> classifier,
            int total,
            int limit
    ) {
        return transfers.stream()
                .collect(Collectors.groupingBy(classifier, Collectors.counting()))
                .entrySet()
                .stream()
                .map(e -> new CountRow(e.getKey(), e.getValue(), percentage(e.getValue(), total)))
                .sorted(
                        Comparator.comparingLong(CountRow::count)
                                .thenComparing(CountRow::value)
                )
                .limit(limit)
                .toList();
    }

    private List<RouteCountRow> topRoutes(
            List<TransferDto> transfers,
            int total,
            int limit
    ) {
        return routeCounts(transfers, total)
                .stream()
                .sorted(
                        Comparator.comparingLong(RouteCountRow::count)
                                .reversed()
                                .thenComparing(RouteCountRow::source)
                                .thenComparing(RouteCountRow::destination)
                )
                .limit(limit)
                .toList();
    }

    private List<RouteCountRow> bottomRoutes(
            List<TransferDto> transfers,
            int total,
            int limit
    ) {
        return routeCounts(transfers, total)
                .stream()
                .sorted(
                        Comparator.comparingLong(RouteCountRow::count)
                                .thenComparing(RouteCountRow::source)
                                .thenComparing(RouteCountRow::destination)
                )
                .limit(limit)
                .toList();
    }

    private List<RouteCountRow> routeCounts(
            List<TransferDto> transfers,
            int total
    ) {
        Map<RouteKey, Long> grouped = transfers.stream()
                .collect(Collectors.groupingBy(
                        t -> new RouteKey(clean(t.source()), clean(t.destination())),
                        Collectors.counting()
                ));

        return grouped.entrySet()
                .stream()
                .map(e -> new RouteCountRow(
                        e.getKey().source(),
                        e.getKey().destination(),
                        e.getValue(),
                        percentage(e.getValue(), total)
                ))
                .toList();
    }

    private List<RouteTypeCountRow> topRouteTypes(
            List<TransferDto> transfers,
            int total,
            int limit
    ) {
        return routeTypeCounts(transfers, total)
                .stream()
                .sorted(
                        Comparator.comparingLong(RouteTypeCountRow::count)
                                .reversed()
                                .thenComparing(RouteTypeCountRow::source)
                                .thenComparing(RouteTypeCountRow::destination)
                                .thenComparing(r -> r.type() == null ? "UNKNOWN" : r.type().name())
                )
                .limit(limit)
                .toList();
    }

    private List<RouteTypeCountRow> bottomRouteTypes(
            List<TransferDto> transfers,
            int total,
            int limit
    ) {
        return routeTypeCounts(transfers, total)
                .stream()
                .sorted(
                        Comparator.comparingLong(RouteTypeCountRow::count)
                                .thenComparing(RouteTypeCountRow::source)
                                .thenComparing(RouteTypeCountRow::destination)
                                .thenComparing(r -> r.type() == null ? "UNKNOWN" : r.type().name())
                )
                .limit(limit)
                .toList();
    }

    private List<RouteTypeCountRow> routeTypeCounts(
            List<TransferDto> transfers,
            int total
    ) {
        Map<RouteTypeKey, Long> grouped = transfers.stream()
                .collect(Collectors.groupingBy(
                        t -> new RouteTypeKey(
                                clean(t.source()),
                                clean(t.destination()),
                                t.type()
                        ),
                        Collectors.counting()
                ));

        return grouped.entrySet()
                .stream()
                .map(e -> new RouteTypeCountRow(
                        e.getKey().source(),
                        e.getKey().destination(),
                        e.getKey().type(),
                        e.getValue(),
                        percentage(e.getValue(), total)
                ))
                .toList();
    }

    private String buildMarkdown(
            String personId,
            int total,
            LocalDate minDate,
            LocalDate maxDate,
            List<TransferDto> transfers,
            List<CountRow> mostSources,
            List<CountRow> leastSources,
            List<CountRow> mostDestinations,
            List<CountRow> leastDestinations,
            List<CountRow> mostTypes,
            List<CountRow> leastTypes,
            List<CountRow> mostBorders,
            List<CountRow> leastBorders,
            List<RouteCountRow> mostRoutes,
            List<RouteCountRow> leastRoutes,
            List<RouteTypeCountRow> mostRouteTypes,
            List<RouteTypeCountRow> leastRouteTypes
    ) {
        long uniqueSources = transfers.stream()
                .map(t -> clean(t.source()))
                .distinct()
                .count();

        long uniqueDestinations = transfers.stream()
                .map(t -> clean(t.destination()))
                .distinct()
                .count();

        long uniqueRoutes = transfers.stream()
                .map(t -> new RouteKey(clean(t.source()), clean(t.destination())))
                .distinct()
                .count();

        long uniqueTypes = transfers.stream()
                .map(t -> t.type() == null ? "UNKNOWN" : t.type().name())
                .distinct()
                .count();

        StringBuilder md = new StringBuilder();

        md.append("## Transfer Analysis\n\n");

        md.append("### Summary\n\n");
        md.append("| Metric | Value |\n");
        md.append("|---|---:|\n");
        md.append("| Person ID | ").append(escape(personId)).append(" |\n");
        md.append("| Total transfers | ").append(total).append(" |\n");
        md.append("| Date range | ").append(minDate).append(" to ").append(maxDate).append(" |\n");
        md.append("| Unique sources | ").append(uniqueSources).append(" |\n");
        md.append("| Unique destinations | ").append(uniqueDestinations).append(" |\n");
        md.append("| Unique source-destination routes | ").append(uniqueRoutes).append(" |\n");
        md.append("| Unique transfer types | ").append(uniqueTypes).append(" |\n\n");

        appendCountTable(md, "### Most Common Sources", "Source", mostSources);
        appendCountTable(md, "### Least Common Sources", "Source", leastSources);

        appendCountTable(md, "### Most Common Destinations", "Destination", mostDestinations);
        appendCountTable(md, "### Least Common Destinations", "Destination", leastDestinations);

        appendCountTable(md, "### Most Common Transfer Types", "Type", mostTypes);
        appendCountTable(md, "### Least Common Transfer Types", "Type", leastTypes);

        appendCountTable(md, "### Most Common Borders", "Border", mostBorders);
        appendCountTable(md, "### Least Common Borders", "Border", leastBorders);

        appendRouteTable(md, "### Most Common Source-Destination Routes", mostRoutes);
        appendRouteTable(md, "### Least Common Source-Destination Routes", leastRoutes);

        appendRouteTypeTable(md, "### Most Common Source-Destination-Type Combinations", mostRouteTypes);
        appendRouteTypeTable(md, "### Least Common Source-Destination-Type Combinations", leastRouteTypes);

        md.append("### Notes\n\n");
        md.append("- Percentages are calculated against total transfers: ")
                .append(total)
                .append(".\n");
        md.append("- Least common tables include one-time routes if they exist.\n");
        md.append("- `UNKNOWN` means the original record had a null or blank value.\n");

        return md.toString();
    }

    private void appendCountTable(
            StringBuilder md,
            String title,
            String columnName,
            List<CountRow> rows
    ) {
        md.append(title).append("\n\n");
        md.append("| Rank | ").append(columnName).append(" | Count | Percentage |\n");
        md.append("|---:|---|---:|---:|\n");

        for (int i = 0; i < rows.size(); i++) {
            CountRow row = rows.get(i);

            md.append("| ")
                    .append(i + 1)
                    .append(" | ")
                    .append(escape(row.value()))
                    .append(" | ")
                    .append(row.count())
                    .append(" | ")
                    .append(formatPercent(row.percentage()))
                    .append(" |\n");
        }

        md.append("\n");
    }

    private void appendRouteTable(
            StringBuilder md,
            String title,
            List<RouteCountRow> rows
    ) {
        md.append(title).append("\n\n");
        md.append("| Rank | Source | Destination | Count | Percentage |\n");
        md.append("|---:|---|---|---:|---:|\n");

        for (int i = 0; i < rows.size(); i++) {
            RouteCountRow row = rows.get(i);

            md.append("| ")
                    .append(i + 1)
                    .append(" | ")
                    .append(escape(row.source()))
                    .append(" | ")
                    .append(escape(row.destination()))
                    .append(" | ")
                    .append(row.count())
                    .append(" | ")
                    .append(formatPercent(row.percentage()))
                    .append(" |\n");
        }

        md.append("\n");
    }

    private void appendRouteTypeTable(
            StringBuilder md,
            String title,
            List<RouteTypeCountRow> rows
    ) {
        md.append(title).append("\n\n");
        md.append("| Rank | Source | Destination | Type | Count | Percentage |\n");
        md.append("|---:|---|---|---|---:|---:|\n");

        for (int i = 0; i < rows.size(); i++) {
            RouteTypeCountRow row = rows.get(i);

            md.append("| ")
                    .append(i + 1)
                    .append(" | ")
                    .append(escape(row.source()))
                    .append(" | ")
                    .append(escape(row.destination()))
                    .append(" | ")
                    .append(row.type() == null ? "UNKNOWN" : row.type().name())
                    .append(" | ")
                    .append(row.count())
                    .append(" | ")
                    .append(formatPercent(row.percentage()))
                    .append(" |\n");
        }

        md.append("\n");
    }

    private String formatPercent(double value) {
        return String.format("%.2f%%", value);
    }

    private String escape(String value) {
        if (value == null) {
            return "UNKNOWN";
        }

        return value.replace("|", "\\|");
    }
}
```

