# 9. Redis Session Logout Handler

This invalidates the `WebSession`. With Spring Session Redis enabled, invalidating the `WebSession` removes the Redis-backed session data.

```java
package com.example.gateway.security;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.http.ResponseCookie;
import org.springframework.security.core.Authentication;
import org.springframework.security.web.server.WebFilterExchange;
import org.springframework.security.web.server.authentication.logout.ServerLogoutHandler;
import org.springframework.stereotype.Component;
import org.springframework.web.server.WebSession;
import reactor.core.publisher.Mono;

import java.time.Duration;

@Component
public class RedisSessionLogoutHandler implements ServerLogoutHandler {

    private static final Logger log = LoggerFactory.getLogger(RedisSessionLogoutHandler.class);

    private final SecurityProperties securityProperties;

    public RedisSessionLogoutHandler(SecurityProperties securityProperties) {
        this.securityProperties = securityProperties;
    }

    @Override
    public Mono<Void> logout(WebFilterExchange exchange, Authentication authentication) {
        var serverExchange = exchange.getExchange();

        return serverExchange.getSession()
                .flatMap(session -> invalidateSession(session)
                        .then(clearSessionCookie(exchange)))
                .doOnSuccess(unused -> log.info("Gateway logout completed"))
                .doOnError(error -> log.error("Gateway logout failed", error));
    }

    private Mono<Void> invalidateSession(WebSession session) {
        log.info("Invalidating Redis-backed WebSession. sessionId={}", session.getId());
        return session.invalidate();
    }

    private Mono<Void> clearSessionCookie(WebFilterExchange exchange) {
        var response = exchange.getExchange().getResponse();

        ResponseCookie expiredCookie = ResponseCookie.from(securityProperties.cookieName(), "")
                .path("/")
                .httpOnly(true)
                .secure(securityProperties.cookieSecure())
                .sameSite(securityProperties.cookieSameSite())
                .maxAge(Duration.ZERO)
                .build();

        response.addCookie(expiredCookie);

        return Mono.empty();
    }
}
```

