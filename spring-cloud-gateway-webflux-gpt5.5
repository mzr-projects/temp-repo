# 11. Security Configuration

```java
package com.example.gateway.config;

import com.example.gateway.security.ApiLogoutSuccessHandler;
import com.example.gateway.security.JsonAccessDeniedHandler;
import com.example.gateway.security.JsonAuthenticationEntryPoint;
import com.example.gateway.security.KeycloakReactiveJwtAuthenticationConverter;
import com.example.gateway.security.RedisSessionLogoutHandler;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.HttpMethod;
import org.springframework.security.authentication.AbstractAuthenticationToken;
import org.springframework.security.config.Customizer;
import org.springframework.security.config.web.server.ServerHttpSecurity;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.security.web.server.SecurityWebFilterChain;
import reactor.core.publisher.Mono;

import org.springframework.core.convert.converter.Converter;

@Configuration
public class SecurityConfig {

    @Bean
    SecurityWebFilterChain securityWebFilterChain(
            ServerHttpSecurity http,
            JsonAuthenticationEntryPoint authenticationEntryPoint,
            JsonAccessDeniedHandler accessDeniedHandler,
            RedisSessionLogoutHandler redisSessionLogoutHandler,
            ApiLogoutSuccessHandler logoutSuccessHandler,
            KeycloakReactiveJwtAuthenticationConverter jwtAuthenticationConverter
    ) {
        return http
                // You explicitly asked for CSRF disabled.
                .csrf(ServerHttpSecurity.CsrfSpec::disable)

                .cors(Customizer.withDefaults())

                .exceptionHandling(exceptionHandling -> exceptionHandling
                        .authenticationEntryPoint(authenticationEntryPoint)
                        .accessDeniedHandler(accessDeniedHandler)
                )

                .authorizeExchange(exchange -> exchange
                        .pathMatchers(HttpMethod.OPTIONS, "/**").permitAll()

                        .pathMatchers(
                                "/actuator/health",
                                "/actuator/health/**",
                                "/actuator/info",
                                "/public/**",
                                "/fallback/**"
                        ).permitAll()

                        .pathMatchers("/actuator/**").hasRole("ADMIN")

                        .pathMatchers(HttpMethod.POST, "/auth/logout").authenticated()

                        .pathMatchers("/api/admin/**").hasRole("ADMIN")

                        .pathMatchers("/api/**").authenticated()

                        .anyExchange().denyAll()
                )

                // Browser/OIDC login with Keycloak.
                .oauth2Login(Customizer.withDefaults())

                // Bearer JWT validation for API clients.
                .oauth2ResourceServer(oauth2 -> oauth2
                        .authenticationEntryPoint(authenticationEntryPoint)
                        .jwt(jwt -> jwt.jwtAuthenticationConverter(jwtAuthenticationConverter))
                )

                .logout(logout -> logout
                        .logoutUrl("/auth/logout")
                        .logoutHandler(redisSessionLogoutHandler)
                        .logoutSuccessHandler(logoutSuccessHandler)
                )

                .build();
    }
}
```

Spring Security’s reactive OAuth2 resource server validates bearer JWTs using a reactive JWT decoder. ([springframework.org](https://www.springframework.org/spring-security/reference/6.5/reactive/oauth2/index.html?utm_source=openai))

