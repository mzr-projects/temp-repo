# 14. Optional: JWT Deny-List for Bearer Token Logout

If clients call the gateway with:

```http
Authorization: Bearer eyJ...
```

then logout cannot physically remove the JWT. The JWT remains cryptographically valid until it expires.

For higher security, use:

1. **Short access token TTL**, for example 5–10 minutes.
2. **Refresh token revocation in Keycloak.**
3. **Redis deny-list by JWT `jti` until token expiration.**

Example deny-list service:

```java
package com.example.gateway.security;

import org.springframework.data.redis.core.ReactiveStringRedisTemplate;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

import java.time.Duration;
import java.time.Instant;
import java.util.Optional;

@Service
public class JwtDenyListService {

    private static final String PREFIX = "gateway:jwt:denylist:";

    private final ReactiveStringRedisTemplate redisTemplate;

    public JwtDenyListService(ReactiveStringRedisTemplate redisTemplate) {
        this.redisTemplate = redisTemplate;
    }

    public Mono<Boolean> deny(Jwt jwt) {
        String jti = jwt.getId();

        if (jti == null || jti.isBlank()) {
            return Mono.just(false);
        }

        Duration ttl = ttlUntilExpiration(jwt);

        if (ttl.isZero() || ttl.isNegative()) {
            return Mono.just(false);
        }

        return redisTemplate.opsForValue()
                .set(PREFIX + jti, "revoked", ttl);
    }

    public Mono<Boolean> isDenied(String jti) {
        if (jti == null || jti.isBlank()) {
            return Mono.just(false);
        }

        return redisTemplate.hasKey(PREFIX + jti);
    }

    private Duration ttlUntilExpiration(Jwt jwt) {
        Instant expiresAt = Optional.ofNullable(jwt.getExpiresAt())
                .orElse(Instant.now());

        return Duration.between(Instant.now(), expiresAt);
    }
}
```

Then add a `WebFilter` that rejects deny-listed JWTs after authentication:

```java
package com.example.gateway.security;

import org.springframework.http.HttpStatus;
import org.springframework.security.core.context.ReactiveSecurityContextHolder;
import org.springframework.security.oauth2.server.resource.authentication.JwtAuthenticationToken;
import org.springframework.stereotype.Component;
import org.springframework.web.server.ServerWebExchange;
import org.springframework.web.server.WebFilter;
import org.springframework.web.server.WebFilterChain;
import reactor.core.publisher.Mono;

@Component
public class JwtDenyListWebFilter implements WebFilter {

    private final JwtDenyListService denyListService;

    public JwtDenyListWebFilter(JwtDenyListService denyListService) {
        this.denyListService = denyListService;
    }

    @Override
    public Mono<Void> filter(ServerWebExchange exchange, WebFilterChain chain) {
        return ReactiveSecurityContextHolder.getContext()
                .map(context -> context.getAuthentication())
                .cast(JwtAuthenticationToken.class)
                .flatMap(authentication -> {
                    String jti = authentication.getToken().getId();

                    return denyListService.isDenied(jti)
                            .flatMap(denied -> {
                                if (Boolean.TRUE.equals(denied)) {
                                    exchange.getResponse().setStatusCode(HttpStatus.UNAUTHORIZED);
                                    return exchange.getResponse().setComplete();
                                }

                                return chain.filter(exchange);
                            });
                })
                .switchIfEmpty(chain.filter(exchange));
    }
}
```

