Below is the usual conversion pattern from **Spring Security Servlet/WebMVC** (`HttpSecurity`) to **Spring Security WebFlux** (`ServerHttpSecurity`). It is **not a 1:1 API rename**: WebFlux uses `SecurityWebFilterChain`, `ServerHttpSecurity`, `ServerWebExchange`, `WebSession`, and reactive handler interfaces returning `Mono<Void>`. `ServerHttpSecurity` is the WebFlux counterpart of `HttpSecurity`. ([docs.spring.io](https://docs.spring.io/spring-security/reference/7.1/api/java/org/springframework/security/config/web/server/ServerHttpSecurity.html?utm_source=openai))

---

## 1. Main type changes

| WebMVC / Servlet | WebFlux / Reactive |
|---|---|
| `@EnableWebSecurity` | `@EnableWebFluxSecurity` |
| `SecurityFilterChain` | `SecurityWebFilterChain` |
| `HttpSecurity` | `ServerHttpSecurity` |
| `HttpSession` | `WebSession` |
| `AuthenticationSuccessHandler` | `ServerAuthenticationSuccessHandler` |
| `AuthenticationFailureHandler` | `ServerAuthenticationFailureHandler` |
| `LogoutHandler` | `ServerLogoutHandler` |
| `LogoutSuccessHandler` | `ServerLogoutSuccessHandler` |
| `RequestMatcher` | `ServerWebExchangeMatcher` |

---

## 2. Example WebFlux configuration

```java
import java.net.URI;
import java.time.Duration;

import reactor.core.publisher.Mono;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.http.ResponseCookie;
import org.springframework.security.config.Customizer;
import org.springframework.security.config.annotation.web.reactive.EnableWebFluxSecurity;
import org.springframework.security.config.web.server.ServerHttpSecurity;
import org.springframework.security.core.Authentication;
import org.springframework.security.web.server.SecurityWebFilterChain;
import org.springframework.security.web.server.authentication.RedirectServerAuthenticationFailureHandler;
import org.springframework.security.web.server.authentication.RedirectServerAuthenticationSuccessHandler;
import org.springframework.security.web.server.authentication.ServerAuthenticationSuccessHandler;
import org.springframework.security.web.server.authentication.logout.DelegatingServerLogoutHandler;
import org.springframework.security.web.server.authentication.logout.RedirectServerLogoutSuccessHandler;
import org.springframework.security.web.server.authentication.logout.SecurityContextServerLogoutHandler;
import org.springframework.security.web.server.authentication.logout.ServerLogoutHandler;
import org.springframework.security.web.server.authentication.logout.ServerLogoutSuccessHandler;
import org.springframework.security.web.server.authentication.logout.WebSessionServerLogoutHandler;
import org.springframework.security.web.server.savedrequest.NoOpServerRequestCache;
import org.springframework.security.web.server.util.matcher.PathPatternParserServerWebExchangeMatcher;

@Configuration
@EnableWebFluxSecurity
public class SecurityConfig {

    @Bean
    SecurityWebFilterChain springSecurityFilterChain(ServerHttpSecurity http) {
        DelegatingServerLogoutHandler logoutHandler =
                new DelegatingServerLogoutHandler(
                        new SecurityContextServerLogoutHandler(),
                        new WebSessionServerLogoutHandler(),
                        cookieClearingLogoutHandler("MY_COOKIE", "SESSION")
                );

        return http
                .authorizeExchange(exchanges -> exchanges
                        .pathMatchers("/", "/login", "/oauth2/**").permitAll()
                        .anyExchange().authenticated()
                )

                .oauth2Login(oauth2 -> oauth2
                        // Equivalent of redirectionEndpoint().baseUri(...)
                        .authenticationMatcher(
                                new PathPatternParserServerWebExchangeMatcher(
                                        "/login/oauth2/callback/{registrationId}"
                                )
                        )

                        // Equivalent of defaultSuccessUrl("/home", true)
                        .authenticationSuccessHandler(
                                defaultSuccessHandler("/home", true)
                        )

                        // Equivalent of failureHandler(...)
                        .authenticationFailureHandler(
                                new RedirectServerAuthenticationFailureHandler("/login?error")
                        )
                )

                // Equivalent area for oauth2Client()
                .oauth2Client(Customizer.withDefaults())

                .logout(logout -> logout
                        // Equivalent of logoutUrl(...)
                        .logoutUrl("/logout")

                        // Equivalent of addLogoutHandler(...) + clearAuthentication + invalidate session
                        .logoutHandler(logoutHandler)

                        .logoutSuccessHandler(
                                redirectLogoutSuccessHandler("/login?logout")
                        )
                )

                .build();
    }

    private static ServerAuthenticationSuccessHandler defaultSuccessHandler(
            String location,
            boolean alwaysUseDefault
    ) {
        RedirectServerAuthenticationSuccessHandler handler =
                new RedirectServerAuthenticationSuccessHandler(location);

        /*
         * WebFlux RedirectServerAuthenticationSuccessHandler redirects to a saved
         * request if present. To behave more like defaultSuccessUrl("/home", true),
         * disable the request cache for this handler.
         */
        if (alwaysUseDefault) {
            handler.setRequestCache(NoOpServerRequestCache.getInstance());
        }

        return handler;
    }

    private static ServerLogoutSuccessHandler redirectLogoutSuccessHandler(String location) {
        RedirectServerLogoutSuccessHandler handler =
                new RedirectServerLogoutSuccessHandler();
        handler.setLogoutSuccessUrl(URI.create(location));
        return handler;
    }

    private static ServerLogoutHandler cookieClearingLogoutHandler(String... cookieNames) {
        return (webFilterExchange, authentication) -> {
            var response = webFilterExchange.getExchange().getResponse();

            for (String cookieName : cookieNames) {
                response.addCookie(ResponseCookie.from(cookieName, "")
                        .path("/")
                        .maxAge(Duration.ZERO)
                        .build());
            }

            return Mono.empty();
        };
    }
}
```

